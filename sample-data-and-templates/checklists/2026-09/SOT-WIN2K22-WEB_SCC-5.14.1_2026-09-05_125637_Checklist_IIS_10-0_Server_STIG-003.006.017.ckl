					<VULN_ATTRIBUTE>Rule_ID</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>SV-218807r1067586_rule</ATTRIBUTE_DATA>
				</STIG_DATA>
				<STIG_DATA>
