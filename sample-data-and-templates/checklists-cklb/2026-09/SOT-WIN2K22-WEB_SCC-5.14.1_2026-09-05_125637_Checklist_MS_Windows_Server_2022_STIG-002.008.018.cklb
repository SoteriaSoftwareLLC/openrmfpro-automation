ord'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","check_content":"If the following registry value does not exist or is not configured as specified, this is a finding:\n\nRegistry Hive: HKEY_LOCAL_MACHINE \nRegistry Path: \\SYSTEM\\CurrentControlSet\\Control\\Lsa\\\n\nValue Name: RestrictAnonymous\n\nValue Type: REG_DWORD\nValue: 0x00000001 (1)","third_party_tools":"","documentable":"false","fix_text":"Configure the policy value for Computer Configuration &gt;&gt; Windows Settings &gt;&gt; Security Settings &gt;&gt; Local Policies &gt;&gt; Security Options &gt;&gt; Network access: Do not allow anonymous enumeration of SAM accounts and shares to \"Enabled\".","stig_uuid":"3DC2EBF0-6BF9-1014-A6FF-AFCBE32ABA75","responsibility":"","ia_controls":"","group_id_src":"V-254467","mitigation_control":"","group_id":"V-254467","severity":"high","reference_identifier":"5485","weight":"10.0","rule_version":"WN22-SO-000230","group_tree":{"id":"V-254467","title":"SRG-OS-000138-GPOS-00069"},"legacy_ids":[],"comments":null,"mitigations":"","classification":"Unclassified"},{"reference_identifier":"5485","rule_version":"WN22-SO-000240","weight":"10.0","mitigations":"","legacy_ids":[],"comments":null,"group_tree":{"id":"V-254468","title":"SRG-OS-000480-GPOS-00227"},"classification":"Unclassified","mitigation_control":"","group_id_src":"V-254468","ia_controls":"","responsibility":"","stig_uuid":"3DC2EBF0-6BF9-1014-A6FF-AFCBE32ABA75","severity":"medium","group_id":"V-254468","check_content":"If the following registry value does not exist or is not configured as specified, this is a finding:\n\nRegistry Hive: HKEY_LOCAL_MACHINE \nRegistry Path: \\SYSTEM\\CurrentControlSet\\Control\\Lsa\\\n\nValue Name: EveryoneIncludesAnonymous\n\nValue Type: REG_DWORD\nValue: 0x00000000 (0)","third_party_tools":"","documentable":"false","fix_text":"Configure the policy value for Computer Configuration &gt;&gt; Windows Settings &gt;&gt; Security Set