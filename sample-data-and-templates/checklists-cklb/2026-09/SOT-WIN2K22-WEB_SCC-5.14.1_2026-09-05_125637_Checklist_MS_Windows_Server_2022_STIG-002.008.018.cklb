n with \"Failure\" selected.","mitigation_control":"","group_id_src":"V-254301","ia_controls":"","responsibility":"","stig_uuid":"3DC2EBF0-6BF9-1014-A6FF-AFCBE32ABA75","severity":"medium","group_id":"V-254301","reference_identifier":"5485","rule_version":"WN22-AU-000080","weight":"10.0","mitigations":"","comments":null,"legacy_ids":[],"group_tree":{"title":"SRG-OS-000470-GPOS-00214","id":"V-254301"},"classification":"Unclassified"},{"ia_controls":"","group_id_src":"V-254302","mitigation_control":"","stig_uuid":"3DC2EBF0-6BF9-1014-A6FF-AFCBE32ABA75","responsibility":"","severity":"medium","group_id":"V-254302","mitigations":"","group_tree":{"title":"SRG-OS-000327-GPOS-00127","id":"V-254302"},"legacy_ids":[],"comments":null,"classification":"Unclassified","reference_identifier":"5485","weight":"10.0","rule_version":"WN22-AU-000090","status":"not_a_finding","check_content_ref":{"href":"U_MS_Windows_Server_2022_V2R8_STIG_SCAP_1-4_Benchmark-enhancedV18-oval.xml","name":"oval:mil.disa.stig.windows2022:def:254302"},"rule_id_src":"SV-254302r958732_rule","ccis":["CCI-000172","CCI-002234"],"false_positives":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:12:25\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nCriteria                :   true (All child tests must be true. (AND))\nTest                    :     true (Audit - Other Account Management Events - 'Success only' or 'Success and Failure')\n\n---\n\nTest ID                 : oval:mil.disa.stig.win:tst:25430200 (auditeventpolicysubcategories_test)\nResult                  : true\nTest Title              : Audit - Other Account Management Events - 'Success only' or 'Success and Failure'\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\nState Operator          : One or more item-state comparisons may be true.\n\nObject ID          