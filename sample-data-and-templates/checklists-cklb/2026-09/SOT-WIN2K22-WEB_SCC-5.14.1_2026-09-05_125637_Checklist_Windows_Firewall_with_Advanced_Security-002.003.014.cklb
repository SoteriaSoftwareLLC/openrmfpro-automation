FTWARE\\Policies\\Microsoft\\WindowsFirewall\\DomainProfile\\EnableFirewall\\value = '0' failed test of 'equals' compared to '1' \n","discussion":"A firewall provides a line of defense against attack. To be effective, it must be enabled and properly configured. Outbound connections are allowed in the domain, unless a rule explicitly blocks the connection. This allows normal outbound communication, which could be restricted as necessary with additional rules.","group_title":"SRG-OS-000480-GPOS-00227","uuid":"4E8BD3F3-6BF9-1014-B3AA-CEB0CE0C4F4C","security_override_guidance":"","potential_impacts":"","rule_title":"Windows Defender Firewall with Advanced Security must allow outbound connections, unless a rule explicitly blocks the connection when connected to a domain.","rule_id":"SV-241993r922936","mitigations":"","group_tree":{"id":"V-241993","title":"SRG-OS-000480-GPOS-00227"},"comments":null,"legacy_ids":["V-17419","SV-54863"],"classification":"Unclassified","reference_identifier":"5363","weight":"10.0","rule_version":"WNFWA-000005","ia_controls":"","group_id_src":"V-241993","mitigation_control":"","stig_uuid":"4E8AAF8E-6BF9-1014-9D83-8E1CAF7A36E8","responsibility":"","severity":"medium","group_id":"V-241993"},{"group_id_src":"V-241994","ia_controls":"","mitigation_control":"","stig_uuid":"4E8AAF8E-6BF9-1014-9D83-8E1CAF7A36E8","responsibility":"","severity":"low","group_id":"V-241994","reference_identifier":"5363","weight":"10.0","rule_version":"WNFWA-000009","mitigations":"","group_tree":{"title":"SRG-OS-000327-GPOS-00127","id":"V-241994"},"comments":null,"legacy_ids":["V-17425","SV-54874"],"classification":"Unclassified","group_title":"SRG-OS-000327-GPOS-00127","uuid":"4E8BDF47-6BF9-1014-B543-CC28A8E26D3E","security_override_guidance":"","rule_title":"Windows Defender Firewall with Advanced Security log size must be configured for domain connections.","potential_impacts":"","rule_id":"SV-241994r922938","check_content_ref":{"href":"U_MS_Windows_Defender_Firewall_V