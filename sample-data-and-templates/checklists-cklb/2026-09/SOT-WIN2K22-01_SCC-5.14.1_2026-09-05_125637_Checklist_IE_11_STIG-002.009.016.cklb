Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_RESTRICT_FILEDOWNLOAD'\n                        : name equals 'iexplore.exe'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_sz'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","third_party_tools":"","severity":"medium","false_positives":"","rule_id":"SV-223115r960963","responsibility":"","ccis":["CCI-000381"],"comments":null,"discussion":"In certain circumstances, websites can initiate file download prompts without interaction from users. This technique can allow websites to put unauthorized files on users' hard drives if they click the wrong button and accept the download. If you configure the Restrict File Download\\Internet Explorer Processes policy setting to \"Enabled\", file download prompts that are not user-initiated are blocked for Internet Explorer processes. If you configure this policy setting as \"Disabled\", prompting will occur for file downloads that are not user-initiated for Internet Explorer processes. Note: This setting is configured as \"Enabled\" in all environments specified in this guide to help prevent attackers from placing arbitrary code on users' computers.","security_override_guidance":"","legacy_ids":["SV-59647","V-46781"],"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Security Features -&gt; Restrict File Download -&gt; 'Internet Explorer Processes' must be 'Enabled'. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_RESTRICT_FILEDOWNLOAD Criteria: If the value \"iexplore.exe\" is REG_SZ = 1, this is not a finding.","group_tree":{"id":"V-223115","title":"SRG-APP-000141"},"stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223115","documentable":"false","group_title":"SRG-APP-000141"},{"uuid":"D4582114-6BF7-1014-A19D-C71734877116","potential_impacts":"","weight":"10.0","mitigations":"","group_id_src":"V-223116","status":"not_a_finding","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:496"},"rule_version":"DTBI645-IE11","ia_controls":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Scripted Window Security Restrictions\\Internet Explorer Processes)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:49600 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Scripted Window Security Restrictions\\Internet Explorer Processes\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:49600 (registry_object)\nObject Comment          : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Scripted Window Security Restrictions\\Internet Explorer Processes\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_WINDOW_RESTRICTIONS'\nObject Requirement      :  check =  'name' must be equal to '(Reserved)'\n\nState ID                : oval:mil.disa.fso.ie:ste:49600 (registry_state)\nState Comment           : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Scripted Window Security Restrictions\\Internet Explorer Processes\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_sz'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_WINDOW_RESTRICTIONS'\n                        : name equals '(Reserved)'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_sz'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","third_party_tools":"","mitigation_control":"","rule_id_src":"SV-223116r960963_rule","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Security Features -&gt; Scripted Window Security Restrictions -&gt; 'Internet Explorer Processes' to 'Enabled'. ","reference_identifier":"4095","rule_title":"Internet Explorer Processes for restricting pop-up windows must be enforced (Reserved).","classification":"Unclassified","ccis":["CCI-000381"],"comments":null,"responsibility":"","rule_id":"SV-223116r960963","false_positives":"","severity":"medium","documentable":"false","group_title":"SRG-APP-000141","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223116","legacy_ids":["SV-59653","V-46787"],"group_tree":{"title":"SRG-APP-000141","id":"V-223116"},"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Security Features -&gt; Scripted Window Security Restrictions -&gt; 'Internet Explorer Processes' must be 'Enabled'. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_WINDOW_RESTRICTIONS Criteria: If the value \"(Reserved)\" is REG_SZ = 1, this is not a finding.","discussion":"Internet Explorer allows scripts to programmatically open, resize, and reposition various types of windows. Often, disreputable websites will resize windows to either hide other windows or force the user to interact with a window containing malicious code. The Scripted Window Security Restrictions security feature restricts pop-up windows and prohibits scripts from displaying windows in which the title and status bars are not visible to the user, or which hide other windows' title and status bars. If you enable the Scripted Window Security Restrictions\\Internet Explorer Processes policy setting, pop-up windows and other restrictions apply for Windows Explorer and Internet Explorer processes. If you disable or do not configure this policy setting, scripts can continue to create pop-up windows, and create windows that hide other windows. Recommend configuring this setting to \"Enabled\" to help prevent malicious websites from controlling the Internet Explorer windows or fooling users into clicking on the wrong window.","security_override_guidance":""},{"group_title":"SRG-APP-000141","documentable":"false","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223117","legacy_ids":["SV-59655","V-46789"],"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Security Features -&gt; Scripted Window Security Restrictions -&gt; 'Internet Explorer Processes' must be 'Enabled'. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_WINDOW_RESTRICTIONS Criteria: If the value \"explorer.exe is REG_SZ = 1, this is not a finding.","group_tree":{"title":"SRG-APP-000141","id":"V-223117"},"discussion":"Internet Explorer allows scripts to programmatically open, resize, and reposition various types of windows. Often, disreputable websites will resize windows to either hide other windows or force a user to interact with a window that contains malicious code. The Scripted Window Security Restrictions security feature restricts pop-up windows and prohibits scripts from displaying windows in which the title and status bars are not visible to the user, or which hide other windows' title and status bars. If you enable the Scripted Window Security Restrictions\\Internet Explorer Processes policy setting, pop-up windows and other restrictions apply for Windows Explorer and Internet Explorer processes. If you disable or do not configure this policy setting, scripts can continue to create pop-up windows and create windows that hide other windows. This guide recommends configuring this setting to \"Enabled\" to help prevent malicious websites from controlling the Internet Explorer windows or fooling users into clicking on the wrong window.","security_override_guidance":"","ccis":["CCI-000381"],"comments":null,"responsibility":"","false_positives":"","rule_id":"SV-223117r960963","severity":"medium","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Scripted Window Security Restrictions\\Internet Explorer Processes)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:50700 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Scripted Window Security Restrictions\\Internet Explorer Processes\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:50700 (registry_object)\nObject Comment          : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Scripted Window Security Restrictions\\Internet Explorer Processes\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_WINDOW_RESTRICTIONS'\nObject Requirement      :  check =  'name' must be equal to 'explorer.exe'\n\nState ID                : oval:mil.disa.fso.ie:ste:50700 (registry_state)\nState Comment           : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Scripted Window Security Restrictions\\Internet Explorer Processes\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_sz'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_WINDOW_RESTRICTIONS'\n                        : name equals 'explorer.exe'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_sz'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","third_party_tools":"","mitigation_control":"","rule_id_src":"SV-223117r960963_rule","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Security Features -&gt; Scripted Window Security Restrictions -&gt; 'Internet Explorer Processes' to 'Enabled'.  ","reference_identifier":"4095","rule_title":"Internet Explorer Processes for restricting pop-up windows must be enforced (Explorer).","classification":"Unclassified","uuid":"D4582966-6BF7-1014-98DA-AFD07F663C90","potential_impacts":"","mitigations":"","group_id_src":"V-223117","weight":"10.0","status":"not_a_finding","check_content_ref":{"name":"oval:mil.disa.fso.ie:def:507","href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml"},"rule_version":"DTBI647-IE11","ia_controls":""},{"security_override_guidance":"","discussion":"Internet Explorer allows scripts to programmatically open, resize, and reposition various types of windows. Often, disreputable websites will resize windows to either hide other windows or force a user to interact with a window that contains malicious code. The Scripted Window Security Restrictions security feature restricts pop-up windows and prohibits scripts from displaying windows in which the title and status bars are not visible to the user, or which hide other windows' title and status bars. If you enable the Scripted Window Security Restrictions\\Internet Explorer Processes policy setting, pop-up windows and other restrictions apply for Windows Explorer and Internet Explorer processes. If you disable or do not configure this policy setting, scripts can continue to create pop-up windows and create windows that hide other windows. This guide recommends configuring this setting to \"Enabled\" to help prevent malicious websites from controlling the Internet Explorer windows or fooling users into clicking on the wrong window.","legacy_ids":["SV-59657","V-46791"],"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Security Features -&gt; Scripted Window Security Restrictions -&gt; 'Internet Explorer Processes' must be 'Enabled'. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_WINDOW_RESTRICTIONS Criteria: If the value \"iexplore.exe\" is REG_SZ = 1, this is not a finding.","group_tree":{"title":"SRG-APP-000141","id":"V-223118"},"stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223118","documentable":"false","group_title":"SRG-APP-000141","severity":"medium","false_positives":"","rule_id":"SV-223118r960963","responsibility":"","ccis":["CCI-000381"],"comments":null,"classification":"Unclassified","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Security Features -&gt; Scripted Window Security Restrictions -&gt; 'Internet Explorer Processes' to 'Enabled'.   ","reference_identifier":"4095","rule_title":"Internet Explorer Processes for restricting pop-up windows must be enforced (iexplore).","mitigation_control":"","rule_id_src":"SV-223118r960963_rule","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Scripted Window Security Restrictions\\Internet Explorer Processes)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:50800 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Scripted Window Security Restrictions\\Internet Explorer Processes\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:50800 (registry_object)\nObject Comment          : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Scripted Window Security Restrictions\\Internet Explorer Processes\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_WINDOW_RESTRICTIONS'\nObject Requirement      :  check =  'name' must be equal to 'iexplore.exe'\n\nState ID                : oval:mil.disa.fso.ie:ste:50800 (registry_state)\nState Comment           : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Scripted Window Security Restrictions\\Internet Explorer Processes\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_sz'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_WINDOW_RESTRICTIONS'\n                        : name equals 'iexplore.exe'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_sz'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","third_party_tools":"","rule_version":"DTBI649-IE11","ia_controls":"","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:508"},"status":"not_a_finding","weight":"10.0","group_id_src":"V-223118","mitigations":"","uuid":"D458317C-6BF7-1014-8E07-C091D14C0905","potential_impacts":""},{"comments":null,"ccis":["CCI-000366"],"responsibility":"","rule_id":"SV-223119r961863","false_positives":"","severity":"medium","group_title":"SRG-APP-000516","documentable":"false","group_id":"V-223119","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone -&gt; 'Run .NET Framework-reliant components not signed with Authenticode' must be 'Enabled', and 'Disable' selected from the drop-down box. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4 Criteria: If the value \"2004\" is REG_DWORD = 3, this is not a finding.","group_tree":{"title":"SRG-APP-000516","id":"V-223119"},"legacy_ids":["SV-59663","V-46797"],"security_override_guidance":"","discussion":"This policy setting allows you to manage whether .NET Framework-reliant components that are not signed with Authenticode can be executed from Internet Explorer. These components include managed controls referenced from an object tag and managed executables referenced from a link. If you enable this policy setting, Internet Explorer will execute unsigned managed components. If you select \"Prompt\" in the drop-down box, Internet Explorer will prompt the user to determine whether to execute unsigned managed components. If you disable this policy setting, Internet Explorer will not execute unsigned managed components. If you do not configure this policy setting, Internet Explorer will execute unsigned managed components.","potential_impacts":"","uuid":"D45839D6-6BF7-1014-BD84-A94AD7F7DE37","status":"not_a_finding","weight":"10.0","group_id_src":"V-223119","mitigations":"","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:497"},"ia_controls":"","rule_version":"DTBI650-IE11","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Run .NET Framework-reliant components not signed with Authenticode)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:49700 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Run .NET Framework-reliant components not signed with Authenticode\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:49700 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Run .NET Framework-reliant components not signed with Authenticode\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\nObject Requirement      :  check =  'name' must be equal to '2004'\n\nState ID                : oval:mil.disa.fso.ie:ste:49700 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Run .NET Framework-reliant components not signed with Authenticode\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '3'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\n                        : name equals '2004'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '3'\n                        : windows_view equals '64_bit'\n","mitigation_control":"","rule_id_src":"SV-223119r961863_rule","rule_title":".NET Framework-reliant components not signed with Authenticode must be disallowed to run (Restricted Sites Zone).","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone -&gt; 'Run .NET Framework-reliant components not signed with Authenticode' to 'Enabled', and select 'Disable' from the drop-down box.","classification":"Unclassified"},{"severity":"medium","rule_id":"SV-223120r961863","false_positives":"","responsibility":"","comments":null,"ccis":["CCI-000366"],"security_override_guidance":"","discussion":"This policy setting allows you to manage whether .NET Framework-reliant components that are signed with Authenticode can be executed from Internet Explorer. It may be possible for malicious content hosted on a website to take advantage of these components. These components include managed controls referenced from an object tag and managed executables referenced from a link. If you enable this policy setting, Internet Explorer will execute signed managed components. If you select \"Prompt\" in the drop-down box, Internet Explorer will prompt the user to determine whether to execute signed managed components. If you disable this policy setting, Internet Explorer will not execute signed managed components. If you do not configure this policy setting, Internet Explorer will execute signed managed components.","check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone -&gt; 'Run .NET Framework-reliant components signed with Authenticode' must be 'Enabled', and 'Disable' selected from the drop-down box. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4 Criteria: If the value \"2001\" is REG_DWORD = 3, this is not a finding.","group_tree":{"id":"V-223120","title":"SRG-APP-000516"},"legacy_ids":["SV-59665","V-46799"],"group_id":"V-223120","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_title":"SRG-APP-000516","documentable":"false","ia_controls":"","rule_version":"DTBI655-IE11","check_content_ref":{"name":"oval:mil.disa.fso.ie:def:498","href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml"},"status":"not_a_finding","group_id_src":"V-223120","weight":"10.0","mitigations":"","potential_impacts":"","uuid":"D458422F-6BF7-1014-A2F1-83EA7841D1F4","classification":"Unclassified","rule_title":".NET Framework-reliant components signed with Authenticode must be disallowed to run (Restricted Sites Zone).","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone -&gt; 'Run .NET Framework-reliant components signed with Authenticode' to 'Enabled', and select 'Disable' from the drop-down box.   ","reference_identifier":"4095","rule_id_src":"SV-223120r961863_rule","mitigation_control":"","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Run .NET Framework-reliant components signed with Authenticode)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:49800 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Run .NET Framework-reliant components signed with Authenticode\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:49800 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Run .NET Framework-reliant components signed with Authenticode\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\nObject Requirement      :  check =  'name' must be equal to '2001'\n\nState ID                : oval:mil.disa.fso.ie:ste:49800 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Run .NET Framework-reliant components signed with Authenticode\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '3'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\n                        : name equals '2001'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '3'\n                        : windows_view equals '64_bit'\n"},{"stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223121","group_title":"SRG-APP-000141","documentable":"false","discussion":"This policy setting allows you to manage whether applets are exposed to scripts within the zone. If you enable this policy setting, scripts can access applets automatically without user intervention. If you select \"Prompt\" in the drop-down box, users are queried to choose whether to allow scripts to access applets. If you disable this policy setting, scripts are prevented from accessing applets. If you do not configure this policy setting, scripts can access applets automatically without user intervention. ","security_override_guidance":"","legacy_ids":["SV-59667","V-46801"],"group_tree":{"id":"V-223121","title":"SRG-APP-000141"},"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone -&gt; 'Scripting of Java applets' must be 'Enabled', and 'Disable' selected from the drop-down box. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4 Criteria: If the value \"1402\" is REG_DWORD = 3, this is not a finding.","responsibility":"","ccis":["CCI-000381"],"comments":null,"severity":"medium","rule_id":"SV-223121r960963","false_positives":"","mitigation_control":"","rule_id_src":"SV-223121r960963_rule","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Scripting of Java applets)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:49900 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Scripting of Java applets\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:49900 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Scripting of Java applets\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\nObject Requirement      :  check =  'name' must be equal to '1402'\n\nState ID                : oval:mil.disa.fso.ie:ste:49900 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Scripting of Java applets\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '3'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\n                        : name equals '1402'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '3'\n                        : windows_view equals '64_bit'\n","classification":"Unclassified","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone -&gt; 'Scripting of Java applets' to 'Enabled', and select 'Disable' from the drop-down box. ","rule_title":"Scripting of Java applets must be disallowed (Restricted Sites zone).","group_id_src":"V-223121","weight":"10.0","mitigations":"","status":"not_a_finding","uuid":"D4584A69-6BF7-1014-B42B-D916665FD559","potential_impacts":"","rule_version":"DTBI670-IE11","ia_controls":"","check_content_ref":{"name":"oval:mil.disa.fso.ie:def:499","href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml"}},{"check_content":"The policy value for User Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; 'Disable AutoComplete for forms' must be 'Enabled'. Procedure: Use the Windows Registry Editor to navigate to the following key: HKCU\\Software\\Policies\\Microsoft\\Internet Explorer\\Main Criteria: If the value \"Use FormSuggest\" is REG_SZ = no, this is not a finding.","group_tree":{"id":"V-223122","title":"SRG-APP-000141"},"legacy_ids":["SV-59673","V-46807"],"security_override_guidance":"","discussion":"This AutoComplete feature suggests possible matches when users are filling in forms. It is possible that this feature will cache sensitive data and store it in the user's profile, where it might not be protected as rigorously as required by organizational policy. If you enable this setting, the user is not presented with suggested matches when filling in forms. If you disable this setting, the user is presented with suggested possible matches when filling forms. If you do not configure this setting, the user has the freedom to turn on the auto-complete feature for forms. To display this option, the user opens the Internet Options dialog box, clicks the \"Contents\" tab, and clicks the \"Settings\" button.","documentable":"false","group_title":"SRG-APP-000141","group_id":"V-223122","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","rule_id":"SV-223122r960963","false_positives":"","severity":"medium","comments":null,"ccis":["CCI-000381"],"responsibility":"","rule_title":"AutoComplete feature for forms must be disallowed.","reference_identifier":"4095","fix_text":"Set the policy value for User Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; 'Disable AutoComplete for forms' to 'Enabled'.   ","classification":"Unclassified","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (AutoComplete feature for forms must be disallowed.)\n\n---\n\nTest ID                 : oval:navy.navwar.niwcatlantic.scc.ie:tst:22312201 (ntuser_test)\nResult                  : true\nTest Title              : AutoComplete feature for forms must be disallowed.\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:navy.navwar.niwcatlantic.scc.ie:obj:22312201 (ntuser_object)\nObject Comment          : All user profiles: Software\\Policies\\Microsoft\\Internet Explorer\\Main\\Use FormSuggest\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Internet Explorer\\Main'\nObject Requirement      :  check =  'name' must be equal to 'Use FormSuggest'\nExclude Items If        : enabled equals 'false'\n\nState ID                : oval:navy.navwar.niwcatlantic.scc.ie:ste:22312201 (ntuser_state)\nState Comment           : NTUSER Registry key type equals reg_size and value equals 'no'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_sz'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to 'no'\n\nCollected Item/State Result : true\n                        : key equals 'Software\\Policies\\Microsoft\\Internet Explorer\\Main'\n                        : name equals 'Use FormSuggest'\n                        : sid equals 'S-1-5-21-746496990-2641142201-3713043312-1001'\n                        : username equals 'SOT-WIN2K22-01\\degthat'\n                        : account_type equals 'local'\n                        : logged_on equals 'false'\n                        : days_since_last_logon equals '86'\n                        : enabled equals 'true'\n                        : date_modified equals '134331012880000000'\n                        : days_since_modified equals '1'\n                        : filepath equals 'C:\\Users\\degthat.WIN-95GFQRRMAS4\\ntuser.dat'\n                        : last_write_time equals '134256869290000000'\n                        : type equals 'reg_sz'\n                        : value equals 'no'\n","third_party_tools":"","mitigation_control":"","rule_id_src":"SV-223122r960963_rule","check_content_ref":{"name":"oval:navy.navwar.niwcatlantic.scc.ie:def:223122","href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval2.xml"},"ia_controls":"","rule_version":"DTBI690-IE11","potential_impacts":"","uuid":"D45852AA-6BF7-1014-A46D-EF576EB209ED","status":"not_a_finding","group_id_src":"V-223122","mitigations":"","weight":"10.0"},{"false_positives":"","rule_id":"SV-223123r960963","severity":"medium","ccis":["CCI-000381"],"comments":null,"responsibility":"","legacy_ids":["SV-59677","V-46811"],"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; 'Turn off Crash Detection' must be 'Enabled'. Procedure: Use the Windows Registry Editor to navigate to the following key:HKLM\\Software\\Policies\\Microsoft\\Internet Explorer\\Restrictions Criteria: If the value \"NoCrashDetection\" is REG_DWORD = 1, this is not a finding.","group_tree":{"id":"V-223123","title":"SRG-APP-000141"},"security_override_guidance":"","discussion":"The 'Turn off Crash Detection' policy setting allows you to manage the crash detection feature of add-on management in Internet Explorer. A crash report could contain sensitive information from the computer's memory. If you enable this policy setting, a crash in Internet Explorer will be similar to one on a computer running Windows XP Professional Service Pack 1 and earlier, where Windows Error Reporting will be invoked. If you disable this policy setting, the crash detection feature in add-on management will be functional. ","documentable":"false","group_title":"SRG-APP-000141","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223123","check_content_ref":{"name":"oval:mil.disa.fso.ie:def:509","href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml"},"rule_version":"DTBI715-IE11","ia_controls":"","uuid":"D4585AB9-6BF7-1014-AE81-F853AC19D145","potential_impacts":"","status":"not_a_finding","weight":"10.0","mitigations":"","group_id_src":"V-223123","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; 'Turn off Crash Detection' to 'Enabled'.   ","reference_identifier":"4095","rule_title":"Crash Detection management must be enforced.","classification":"Unclassified","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Turn Off Crash Detection)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:50900 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Turn Off Crash Detection\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:50900 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Turn Off Crash Detection\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Internet Explorer\\Restrictions'\nObject Requirement      :  check =  'name' must be equal to 'NoCrashDetection'\n\nState ID                : oval:mil.disa.fso.ie:ste:50900 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Turn Off Crash Detection\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Internet Explorer\\Restrictions'\n                        : name equals 'NoCrashDetection'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","third_party_tools":"","rule_id_src":"SV-223123r960963_rule","mitigation_control":""},{"group_id":"V-223124","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_title":"SRG-APP-000141","documentable":"false","discussion":"This policy setting controls automatic completion of fields in forms on web pages. It is possible that malware could be developed which would be able to extract the cached user names and passwords from the currently logged on user, which an attacker could then use to compromise that user's online accounts.  If you enable this setting, the user cannot change the 'User name and passwords on forms' or 'prompt me to save passwords'. The Auto Complete feature for\" User names and passwords on forms\" will be turned on. If you disable this setting, the user cannot change the 'User name and passwords on forms' or 'prompt me to save passwords'. The Auto Complete feature for \"User names and passwords on forms\" is turned off. The user also cannot opt to be prompted to save passwords. If you do not configure this setting, the user has the freedom of turning on Auto Complete for \"User name and passwords on forms\", and the option of prompting to save passwords.","security_override_guidance":"","group_tree":{"id":"V-223124","title":"SRG-APP-000141"},"check_content":"The policy value for User Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; 'Turn on the auto-complete feature for user names and passwords on forms' must be 'Disabled'. \nProcedure: Use the Windows Registry Editor to navigate to the following key: HKCU\\Software\\Policies\\Microsoft\\Internet Explorer\\Main Criteria: If the value \"FormSuggest Passwords\" is REG_SZ = 'no', this is not a finding. AND Procedure: Use the Windows Registry Editor to navigate to the following key: HKCU\\Software\\Policies\\Microsoft\\Internet Explorer\\Main Criteria: If the value \"FormSuggest PW Ask\" is REG_SZ = 'no', this is not a finding.","legacy_ids":["SV-59681","V-46815"],"responsibility":"","comments":null,"ccis":["CCI-000381"],"severity":"medium","rule_id":"SV-223124r960963","false_positives":"","rule_id_src":"SV-223124r960963_rule","mitigation_control":"","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Turn on the auto-complete feature for user names and passwords on forms must be disabled.)\n\n---\n\nTest ID                 : oval:navy.navwar.niwcatlantic.scc.ie:tst:22312401 (ntuser_test)\nResult                  : true\nTest Title              : Turn on the auto-complete feature for user names and passwords on forms must be disabled.\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:navy.navwar.niwcatlantic.scc.ie:obj:22312401 (ntuser_object)\nObject Comment          : All user profiles: Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FormSuggest PW Ask\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Internet Explorer\\Main'\nObject Requirement      :  check =  'name' must be equal to 'FormSuggest PW Ask'\nExclude Items If        : enabled equals 'false'\n\nState ID                : oval:navy.navwar.niwcatlantic.scc.ie:ste:22312401 (ntuser_state)\nState Comment           : NTUSER Registry key type equals reg_size and value equals 'no'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_sz'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to 'no'\n\nCollected Item/State Result : true\n                        : key equals 'Software\\Policies\\Microsoft\\Internet Explorer\\Main'\n                        : name equals 'FormSuggest PW Ask'\n                        : sid equals 'S-1-5-21-746496990-2641142201-3713043312-1001'\n                        : username equals 'SOT-WIN2K22-01\\degthat'\n                        : account_type equals 'local'\n                        : logged_on equals 'false'\n                        : days_since_last_logon equals '86'\n                        : enabled equals 'true'\n                        : date_modified equals '134331012880000000'\n                        : days_since_modified equals '1'\n                        : filepath equals 'C:\\Users\\degthat.WIN-95GFQRRMAS4\\ntuser.dat'\n                        : last_write_time equals '134256869290000000'\n                        : type equals 'reg_sz'\n                        : value equals 'no'\n","classification":"Unclassified","rule_title":"Turn on the auto-complete feature for user names and passwords on forms must be disabled.","reference_identifier":"4095","fix_text":"Set the policy value for User Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; 'Turn on the auto-complete feature for user names and passwords on forms' to 'Disabled'.   ","group_id_src":"V-223124","mitigations":"","weight":"10.0","status":"not_a_finding","potential_impacts":"","uuid":"D458654D-6BF7-1014-ABA7-91A3DCB8C8D6","ia_controls":"","rule_version":"DTBI725-IE11","check_content_ref":{"name":"oval:navy.navwar.niwcatlantic.scc.ie:def:223124","href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval2.xml"}},{"ia_controls":"","rule_version":"DTBI740-IE11","check_content_ref":{"name":"oval:mil.disa.fso.ie:def:514","href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml"},"mitigations":"","weight":"10.0","group_id_src":"V-223125","status":"not_a_finding","potential_impacts":"","uuid":"D4586E3D-6BF7-1014-9E42-E7C733A6394F","classification":"Unclassified","rule_title":"Managing SmartScreen Filter use must be enforced.","reference_identifier":"4095","fix_text":"If the system is on the SIPRNet, this requirement is NA.\n\nSet the policy value for Computer Configuration &gt;&gt; Administrative Templates &gt;&gt; Windows Components &gt;&gt; Internet Explorer &gt;&gt; \"Prevent Managing SmartScreen Filter\" to \"Enabled\", and select \"On\" from the drop-down box.","mitigation_control":"","rule_id_src":"SV-223125r961083_rule","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Prevent Managing SmartScreen Filter)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:51400 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Prevent Managing SmartScreen Filter\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:51400 (registry_object)\nObject Comment          : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Prevent Managing SmartScreen Filter is Enabled and the set to 'On'.\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Internet Explorer\\PhishingFilter'\nObject Requirement      :  check =  'name' must be equal to 'EnabledV9'\n\nState ID                : oval:mil.disa.fso.ie:ste:51400 (registry_state)\nState Comment           : REG_DWORD is 1\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Internet Explorer\\PhishingFilter'\n                        : name equals 'EnabledV9'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","third_party_tools":"","severity":"medium","false_positives":"","rule_id":"SV-223125r961083","responsibility":"","comments":null,"ccis":["CCI-001166"],"discussion":"This setting is important from a security perspective because Microsoft has extensive data illustrating the positive impact the SmartScreen filter has had on reducing the risk of malware infection via visiting malicious websites. This policy setting allows users to enable the SmartScreen Filter, which will warn if the website being visited is known for fraudulent attempts to gather personal information through 'phishing' or is known to host malware. If you enable this setting the user will not be prompted to enable the SmartScreen Filter. It must be specified which mode the SmartScreen Filter uses: On or Off. If the feature is On, all website addresses not contained on the filters allow list, will be sent automatically to Microsoft without prompting the user. If this feature is set to Off, the feature will not run. If you disable or do not configure this policy setting, the user is prompted to decide whether to turn on SmartScreen Filter during the first-run experience.","security_override_guidance":"","check_content":"If the system is on the SIPRNet, this requirement is NA.\n\nThe policy value for Computer Configuration &gt;&gt; Administrative Templates &gt;&gt; Windows Components &gt;&gt; Internet Explorer &gt;&gt; \"Prevent Managing SmartScreen Filter\" must be \"Enabled\", and \"On\" selected from the drop-down box. \n\nProcedure: Use the Windows Registry Editor to navigate to the following key:\n\nHKLM\\Software\\Policies\\Microsoft\\Internet Explorer\\PhishingFilter \n\nCriteria: If the value \"EnabledV9\" is \"REG_DWORD = 1\", this is not a finding.","group_tree":{"id":"V-223125","title":"SRG-APP-000206"},"legacy_ids":["SV-59685","V-46819"],"group_id":"V-223125","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_title":"SRG-APP-000206","documentable":"false"},{"discussion":"Delete Browsing History on exit automatically deletes specified items when the last browser window closes.  Disabling this function will prevent users from deleting their browsing history, which could be used to identify malicious websites and files that could later be used for anti-virus and Intrusion Detection System (IDS) signatures.  Furthermore, preventing users from deleting browsing history could be used to identify abusive web surfing on government systems.","security_override_guidance":"","group_tree":{"id":"V-223126","title":"SRG-APP-000089"},"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Delete Browsing History -&gt; 'Allow deleting browsing history on exit' must be 'Disabled'. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Internet Explorer\\Privacy Criteria: If the value \"ClearBrowsingHistoryOnExit\" is REG_DWORD = 0, this is not a finding.","legacy_ids":["SV-59695","V-46829"],"group_id":"V-223126","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_title":"SRG-APP-000089","documentable":"false","severity":"medium","rule_id":"SV-223126r960879","false_positives":"","responsibility":"","comments":null,"ccis":["CCI-000169"],"classification":"Unclassified","rule_title":"Browser must retain history on exit.","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Delete Browsing History -&gt; 'Allow deleting browsing history on exit' to 'Disabled'.   ","mitigation_control":"","rule_id_src":"SV-223126r960879_rule","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Delete Browsing History\\Configure Delete Browsing History on exit)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:51600 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Delete Browsing History\\Configure Delete Browsing History on exit\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:51600 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Delete Browsing History\\Configure Delete Browsing History on exit\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Internet Explorer\\Privacy'\nObject Requirement      :  check =  'name' must be equal to 'ClearBrowsingHistoryOnExit'\n\nState ID                : oval:mil.disa.fso.ie:ste:51600 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Delete Browsing History\\Configure Delete Browsing History on exit\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Internet Explorer\\Privacy'\n                        : name equals 'ClearBrowsingHistoryOnExit'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","third_party_tools":"","ia_controls":"","rule_version":"DTBI760-IE11","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:516"},"weight":"10.0","mitigations":"","group_id_src":"V-223126","status":"not_a_finding","potential_impacts":"","uuid":"D458767A-6BF7-1014-93BB-D9CA0A329AAF"},{"classification":"Unclassified","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Delete Browsing History -&gt; 'Prevent Deleting Web sites that the User has Visited' to 'Enabled'.   ","reference_identifier":"4095","rule_title":"Deleting websites that the user has visited must be disallowed.","mitigation_control":"","rule_id_src":"SV-223127r960879_rule","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Delete Browsing History\\Prevent Deleting Web sites that the User has Visited)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:51700 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Delete Browsing History\\Prevent Deleting Web sites that the User has Visited\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:51700 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Delete Browsing History\\Prevent Deleting Web sites that the User has Visited\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Internet Explorer\\Privacy'\nObject Requirement      :  check =  'name' must be equal to 'CleanHistory'\n\nState ID                : oval:mil.disa.fso.ie:ste:51700 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Delete Browsing History\\Prevent Deleting Web sites that the User has Visited\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Internet Explorer\\Privacy'\n                        : name equals 'CleanHistory'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","rule_version":"DTBI770-IE11","ia_controls":"","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:517"},"status":"not_a_finding","mitigations":"","weight":"10.0","group_id_src":"V-223127","uuid":"D4587E74-6BF7-1014-A91E-93CEC4C480F6","potential_impacts":"","security_override_guidance":"","discussion":"This policy prevents users from deleting the history of websites the user has visited. If you enable this policy setting, websites the user has visited will be preserved when the user clicks \"Delete\". If you disable this policy setting, websites that the user has visited will be deleted when the user clicks \"Delete\". If you do not configure this policy setting, the user will be able to select whether to delete or preserve websites the user visited when the user clicks \"Delete\".","legacy_ids":["SV-59707","V-46841"],"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Delete Browsing History -&gt; 'Prevent Deleting Web sites that the User has Visited' must be 'Enabled'. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Internet Explorer\\Privacy Criteria: If the value \"CleanHistory\" is REG_DWORD = 0, this is not a finding.","group_tree":{"title":"SRG-APP-000089","id":"V-223127"},"stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223127","documentable":"false","group_title":"SRG-APP-000089","severity":"medium","rule_id":"SV-223127r960879","false_positives":"","responsibility":"","ccis":["CCI-000169"],"comments":null},{"documentable":"false","group_title":"SRG-APP-000080","group_id":"V-223128","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_tree":{"id":"V-223128","title":"SRG-APP-000080"},"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Privacy -&gt; 'Turn off InPrivate Browsing' must be 'Enabled'. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Internet Explorer\\Privacy Criteria: If the value \"EnableInPrivateBrowsing\" is REG_DWORD = 0, this is not a finding.","legacy_ids":["SV-59713","V-46847"],"security_override_guidance":"","discussion":"InPrivate Browsing lets the user control whether or not Internet Explorer saves the browsing history, cookies, and other data. User control of settings is not the preferred control method. The InPrivate Browsing feature in Internet Explorer makes browser privacy easy by not storing history, cookies, temporary Internet files, or other data. If you enable this policy setting, InPrivate Browsing will be disabled. If you disable this policy setting, InPrivate Browsing will be available for use. If you do not configure this setting, InPrivate Browsing can be turned on or off through the registry.","comments":null,"ccis":["CCI-000166"],"responsibility":"","false_positives":"","rule_id":"SV-223128r960864","severity":"medium","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\InPrivate\\Turn off InPrivate Browsing)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:51800 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\InPrivate\\Turn off InPrivate Browsing\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:51800 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\InPrivate\\Turn off InPrivate Browsing\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Internet Explorer\\Privacy'\nObject Requirement      :  check =  'name' must be equal to 'EnableInPrivateBrowsing'\n\nState ID                : oval:mil.disa.fso.ie:ste:51800 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\InPrivate\\Turn off InPrivate Browsing\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Internet Explorer\\Privacy'\n                        : name equals 'EnableInPrivateBrowsing'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","mitigation_control":"","rule_id_src":"SV-223128r960864_rule","rule_title":"InPrivate Browsing must be disallowed.","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Privacy -&gt; 'Turn off InPrivate Browsing' to 'Enabled'.   ","classification":"Unclassified","potential_impacts":"","uuid":"D45885FE-6BF7-1014-AE7F-987DB8DC476E","status":"not_a_finding","weight":"10.0","mitigations":"","group_id_src":"V-223128","check_content_ref":{"name":"oval:mil.disa.fso.ie:def:518","href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml"},"ia_controls":"","rule_version":"DTBI780-IE11"},{"finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Allow scripting of Internet Explorer web browser control)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:51900 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Allow scripting of Internet Explorer web browser control\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:51900 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Allow scripting of Internet Explorer web browser control\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\nObject Requirement      :  check =  'name' must be equal to '1206'\n\nState ID                : oval:mil.disa.fso.ie:ste:51900 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Allow scripting of Internet Explorer web browser control\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '3'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\n                        : name equals '1206'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '3'\n                        : windows_view equals '64_bit'\n","third_party_tools":"","mitigation_control":"","rule_id_src":"SV-223129r960963_rule","rule_title":"Scripting of Internet Explorer WebBrowser control property must be disallowed (Internet zone).","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Internet Zone -&gt; 'Allow scripting of Internet Explorer WebBrowser controls' to 'Enabled', and select 'Disable' from the drop-down box.   ","classification":"Unclassified","potential_impacts":"","uuid":"D4589C43-6BF7-1014-98F2-D3AC36F6D631","group_id_src":"V-223129","weight":"10.0","mitigations":"","status":"not_a_finding","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:519"},"ia_controls":"","rule_version":"DTBI800-IE11","documentable":"false","group_title":"SRG-APP-000141","group_id":"V-223129","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Internet Zone -&gt; 'Allow scripting of Internet Explorer WebBrowser controls' must be 'Enabled', and 'Disable' selected from the drop-down box. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3 Criteria: If the value \"1206\" is REG_DWORD = 3, this is not a finding.","group_tree":{"title":"SRG-APP-000141","id":"V-223129"},"legacy_ids":["SV-59715","V-46849"],"discussion":"This policy setting controls whether a page may control embedded WebBrowser control via script. Scripted code hosted on sites located in this zone is more likely to contain malicious code. If you enable this policy setting, script access to the WebBrowser control is allowed. If you disable this policy setting, script access to the WebBrowser control is not allowed. If you do not configure this policy setting, script access to the WebBrowser control can be enabled or disabled by the user. By default, script access to the WebBrowser control is only allowed in the Local Machine and Intranet Zones.","security_override_guidance":"","comments":null,"ccis":["CCI-000381"],"responsibility":"","false_positives":"","rule_id":"SV-223129r960963","severity":"medium"},{"reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Internet Zone -&gt; 'Include local path when user is uploading files to a server' to 'Enabled', and select 'Disable' from the drop-down box.  ","rule_title":"When uploading files to a server, the local directory path must be excluded (Internet zone).","classification":"Unclassified","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Include local directory path when uploading files to a server)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:52000 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Include local directory path when uploading files to a server\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:52000 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Include local directory path when uploading files to a server\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\nObject Requirement      :  check =  'name' must be equal to '160A'\n\nState ID                : oval:mil.disa.fso.ie:ste:52000 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Include local directory path when uploading files to a server\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '3'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\n                        : name equals '160A'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '3'\n                        : windows_view equals '64_bit'\n","third_party_tools":"","mitigation_control":"","rule_id_src":"SV-223130r960963_rule","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:520"},"rule_version":"DTBI810-IE11","ia_controls":"","uuid":"D458A4C5-6BF7-1014-8849-A77344D9492F","potential_impacts":"","weight":"10.0","mitigations":"","group_id_src":"V-223130","status":"not_a_finding","legacy_ids":["SV-59719","V-46853"],"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Internet Zone -&gt; 'Include local path when user is uploading files to a server' must be 'Enabled', and 'Disable' selected from the drop-down box. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3 Criteria: If the value \"160A\" is REG_DWORD = 3, this is not a finding.","group_tree":{"title":"SRG-APP-000141","id":"V-223130"},"discussion":"This policy setting controls whether or not the local path information will be sent when uploading a file via a HTML form. If the local path information is sent, some information may be unintentionally revealed to the server. If you do not configure this policy setting, the user can choose whether path information will be sent when uploading a file via a form. By default, path information will be sent.","security_override_guidance":"","documentable":"false","group_title":"SRG-APP-000141","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223130","false_positives":"","rule_id":"SV-223130r960963","severity":"medium","ccis":["CCI-000381"],"comments":null,"responsibility":""},{"comments":null,"ccis":["CCI-000381"],"responsibility":"","false_positives":"","rule_id":"SV-223131r960963","severity":"medium","group_title":"SRG-APP-000141","documentable":"false","group_id":"V-223131","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Security Features-&gt; Notification Bar-&gt; 'Internet Explorer Processes' must be 'Enabled'. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_SECURITYBAND Criteria: If the value \"(Reserved)\" is REG_SZ = 1, this is not a finding.","group_tree":{"id":"V-223131","title":"SRG-APP-000141"},"legacy_ids":["SV-59723","V-46857"],"discussion":"This policy setting allows you to manage whether the Notification Bar is displayed for Internet Explorer processes when file or code installs are restricted. By default, the Notification Bar is displayed for Internet Explorer processes. If you enable this policy setting, the Notification Bar will be displayed for Internet Explorer processes. If you disable this policy setting, the Notification Bar will not be displayed for Internet Explorer processes. If you do not configure this policy setting, the Notification Bar will be displayed for Internet Explorer processes.","security_override_guidance":"","potential_impacts":"","uuid":"D458ACEF-6BF7-1014-92DE-8EE7CDA21CF3","weight":"10.0","mitigations":"","group_id_src":"V-223131","status":"not_a_finding","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:541"},"ia_controls":"","rule_version":"DTBI815-IE11","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Notification Bar\\Internet Explorer Processes)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:54100 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Notification Bar\\Internet Explorer Processes\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:54100 (registry_object)\nObject Comment          : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Notification Bar\\Internet Explorer Processes\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_SECURITYBAND'\nObject Requirement      :  check =  'name' must be equal to '(Reserved)'\n\nState ID                : oval:mil.disa.fso.ie:ste:54100 (registry_state)\nState Comment           : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Notification Bar\\Internet Explorer Processes\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_sz'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_SECURITYBAND'\n                        : name equals '(Reserved)'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_sz'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","third_party_tools":"","mitigation_control":"","rule_id_src":"SV-223131r960963_rule","rule_title":"Internet Explorer Processes for Notification Bars must be enforced (Reserved).","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Security Features-&gt; Notification Bar-&gt; 'Internet Explorer Processes' to 'Enabled'.   ","reference_identifier":"4095","classification":"Unclassified"},{"check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:521"},"ia_controls":"","rule_version":"DTBI820-IE11","potential_impacts":"","uuid":"D458B75B-6BF7-1014-BB3C-FFEFCCB7B752","group_id_src":"V-223132","weight":"10.0","mitigations":"","status":"not_a_finding","rule_title":"Security Warning for unsafe files must be set to prompt (Internet zone).","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Internet Zone -&gt; 'Show security warning for potentially unsafe files' to 'Enabled', and select 'Prompt' from the drop-down box.   ","classification":"Unclassified","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Launching programs and unsafe files)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:52100 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Launching programs and unsafe files\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:52100 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Launching programs and unsafe files\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\nObject Requirement      :  check =  'name' must be equal to '1806'\n\nState ID                : oval:mil.disa.fso.ie:ste:52100 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Launching programs and unsafe files\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\n                        : name equals '1806'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","mitigation_control":"","rule_id_src":"SV-223132r961863_rule","rule_id":"SV-223132r961863","false_positives":"","severity":"medium","comments":null,"ccis":["CCI-000366"],"responsibility":"","group_tree":{"id":"V-223132","title":"SRG-APP-000516"},"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Internet Zone -&gt; 'Show security warning for potentially unsafe files' must be 'Enabled', and 'Prompt' selected from the drop-down box. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3 Criteria: If the value \"1806\" is REG_DWORD = 1, this is not a finding.","legacy_ids":["SV-59725","V-46859"],"discussion":"This policy setting controls whether or not the 'Open File - Security Warning' message appears when the user tries to open executable files or other potentially unsafe files (from an intranet file shared by using Windows Explorer, for example). If you enable this policy setting and set the drop-down box to \"Enable\", these files open without a security warning. If you set the drop-down box to \" Prompt\", a security warning appears before the files open. If you disable this policy these files do not open. If you do not configure this policy setting, the user can configure how the computer handles these files.","security_override_guidance":"","documentable":"false","group_title":"SRG-APP-000516","group_id":"V-223132","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D"},{"status":"not_a_finding","mitigations":"","weight":"10.0","group_id_src":"V-223133","uuid":"D458BF99-6BF7-1014-B3FC-CDA5FB050011","potential_impacts":"","rule_version":"DTBI825-IE11","ia_controls":"","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:542"},"mitigation_control":"","rule_id_src":"SV-223133r960963_rule","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Notification Bar\\Internet Explorer Processes)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:54200 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Notification Bar\\Internet Explorer Processes\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:54200 (registry_object)\nObject Comment          : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Notification Bar\\Internet Explorer Processes\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_SECURITYBAND'\nObject Requirement      :  check =  'name' must be equal to 'explorer.exe'\n\nState ID                : oval:mil.disa.fso.ie:ste:54200 (registry_state)\nState Comment           : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Notification Bar\\Internet Explorer Processes\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_sz'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_SECURITYBAND'\n                        : name equals 'explorer.exe'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_sz'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","classification":"Unclassified","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Security Features-&gt; Notification Bar-&gt; 'Internet Explorer Processes' to 'Enabled'. ","reference_identifier":"4095","rule_title":"Internet Explorer Processes for Notification Bars must be enforced (Explorer).","responsibility":"","ccis":["CCI-000381"],"comments":null,"severity":"medium","rule_id":"SV-223133r960963","false_positives":"","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223133","documentable":"false","group_title":"SRG-APP-000141","security_override_guidance":"","discussion":"This policy setting allows you to manage whether the Notification Bar is displayed for Internet Explorer processes when file or code installs are restricted. By default, the Notification Bar is displayed for Internet Explorer processes. If you enable this policy setting, the Notification Bar will be displayed for Internet Explorer processes. If you disable this policy setting, the Notification Bar will not be displayed for Internet Explorer processes. If you do not configure this policy setting, the Notification Bar will be displayed for Internet Explorer processes.","legacy_ids":["SV-59727","V-46861"],"group_tree":{"title":"SRG-APP-000141","id":"V-223133"},"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Security Features-&gt; Notification Bar-&gt; 'Internet Explorer Processes' must be 'Enabled'. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_SECURITYBAND Criteria: If the value \"explorer.exe\" is REG_SZ = 1, this is not a finding."},{"discussion":"This policy setting controls whether or not the user is prompted to allow ActiveX controls to run on websites other than the website that installed the ActiveX control. If the user were to disable the setting for the zone, malicious ActiveX controls could be executed without the user's knowledge. Disabling this setting would allow the possibility for malicious ActiveX controls to be executed from non-approved domains within this zone without the user's knowledge. Enabling this setting enforces the default value and prohibits the user from changing the value. Websites should be moved into another zone if permissions need to be changed.","security_override_guidance":"","group_tree":{"title":"SRG-APP-000210","id":"V-223134"},"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Internet Zone -&gt; ' Allow only approved domains to use ActiveX controls without prompt' must be 'Enabled', and 'Enable' selected from the drop-down box. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3 Criteria: If the value \"120b\" is REG_DWORD = 3, this is not a finding.","legacy_ids":["SV-59729","V-46865"],"group_id":"V-223134","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_title":"SRG-APP-000210","documentable":"false","severity":"medium","false_positives":"","rule_id":"SV-223134r961092","responsibility":"","comments":null,"ccis":["CCI-001170"],"classification":"Unclassified","rule_title":"ActiveX controls without prompt property must be used in approved domains only (Internet zone).","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Internet Zone -&gt; 'Allow only approved domains to use ActiveX controls without prompt' to 'Enabled', and select 'Enable' from the drop-down box.   ","reference_identifier":"4095","rule_id_src":"SV-223134r961092_rule","mitigation_control":"","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Only allow approved domains to use ActiveX controls without prompt)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:52200 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Only allow approved domains to use ActiveX controls without prompt\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:52200 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Only allow approved domains to use ActiveX controls without prompt\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\nObject Requirement      :  check =  'name' must be equal to '120B'\n\nState ID                : oval:mil.disa.fso.ie:ste:52200 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Only allow approved domains to use ActiveX controls without prompt\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '3'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\n                        : name equals '120B'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '3'\n                        : windows_view equals '64_bit'\n","ia_controls":"","rule_version":"DTBI830-IE11","check_content_ref":{"name":"oval:mil.disa.fso.ie:def:522","href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml"},"mitigations":"","weight":"10.0","group_id_src":"V-223134","status":"not_a_finding","potential_impacts":"","uuid":"D458C75E-6BF7-1014-95A1-A6B18F537F5A"},{"documentable":"false","group_title":"SRG-APP-000141","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223135","legacy_ids":["SV-59735","V-46869"],"group_tree":{"id":"V-223135","title":"SRG-APP-000141"},"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Security Features-&gt; Notification Bar-&gt; 'Internet Explorer Processes' must be 'Enabled'. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_SECURITYBAND Criteria: If the value \"iexplore.exe\" is REG_SZ = 1, this is not a finding.","security_override_guidance":"","discussion":"This policy setting allows you to manage whether the Notification Bar is displayed for Internet Explorer processes when file or code installs are restricted. By default, the Notification Bar is displayed for Internet Explorer processes. If you enable this policy setting, the Notification Bar will be displayed for Internet Explorer processes. If you disable this policy setting, the Notification Bar will not be displayed for Internet Explorer processes. If you do not configure this policy setting, the Notification Bar will be displayed for Internet Explorer processes.","ccis":["CCI-000381"],"comments":null,"responsibility":"","false_positives":"","rule_id":"SV-223135r960963","severity":"medium","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Notification Bar\\Internet Explorer Processes)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:54300 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Notification Bar\\Internet Explorer Processes\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:54300 (registry_object)\nObject Comment          : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Notification Bar\\Internet Explorer Processes\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_SECURITYBAND'\nObject Requirement      :  check =  'name' must be equal to 'iexplore.exe'\n\nState ID                : oval:mil.disa.fso.ie:ste:54300 (registry_state)\nState Comment           : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Notification Bar\\Internet Explorer Processes\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_sz'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_SECURITYBAND'\n                        : name equals 'iexplore.exe'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_sz'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","mitigation_control":"","rule_id_src":"SV-223135r960963_rule","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Security Features-&gt; Notification Bar-&gt; 'Internet Explorer Processes' to 'Enabled'.   ","rule_title":"Internet Explorer Processes for Notification Bars must be enforced (iexplore).","classification":"Unclassified","uuid":"D458CF29-6BF7-1014-A8B8-9F2CB62C1470","potential_impacts":"","status":"not_a_finding","weight":"10.0","group_id_src":"V-223135","mitigations":"","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:543"},"rule_version":"DTBI835-IE11","ia_controls":""},{"documentable":"false","group_title":"SRG-APP-000141","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223136","legacy_ids":["SV-59745","V-46879"],"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Internet Zone -&gt; 'Turn on Cross-Site Scripting Filter' must be 'Enabled', and 'Enable' selected from the drop-down box. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3 Criteria: If the value \"1409\" is REG_DWORD = 0, this is not a finding.","group_tree":{"id":"V-223136","title":"SRG-APP-000141"},"discussion":"The Cross-Site Scripting Filter is designed to prevent users from becoming victims of unintentional information disclosure. This setting controls if the Cross-Site Scripting (XSS) Filter detects and prevents cross-site script injection into websites in this zone. If you enable this policy setting, the XSS Filter will be enabled for sites in this zone, and the XSS Filter will attempt to block cross-site script injections. If you disable this policy setting, the XSS Filter will be disabled for sites in this zone, and Internet Explorer will permit cross-site script injections.","security_override_guidance":"","ccis":["CCI-000381"],"comments":null,"responsibility":"","rule_id":"SV-223136r960963","false_positives":"","severity":"medium","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Turn on Cross-Site Scripting (XSS) Filter must be Enabled and Enable selected)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:52300 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Turn on Cross-Site Scripting (XSS) Filter must be Enabled and Enable selected\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:52300 (registry_object)\nObject Comment          : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Turn on Cross-Site Scripting (XSS) Filter must be Enabled and Enable selected\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\nObject Requirement      :  check =  'name' must be equal to '1409'\n\nState ID                : oval:mil.disa.fso.ie:ste:52300 (registry_state)\nState Comment           : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Turn on Cross-Site Scripting (XSS) Filter must be Enabled and Enable selected\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\n                        : name equals '1409'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","third_party_tools":"","mitigation_control":"","rule_id_src":"SV-223136r960963_rule","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Internet Zone -&gt; 'Turn on Cross-Site Scripting Filter' to 'Enabled', and select 'Enable' from the drop-down box.   ","rule_title":"Cross-Site Scripting Filter must be enforced (Internet zone).","classification":"Unclassified","uuid":"D458D6EC-6BF7-1014-B44E-C2D90C419214","potential_impacts":"","group_id_src":"V-223136","mitigations":"","weight":"10.0","status":"not_a_finding","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:523"},"rule_version":"DTBI840-IE11","ia_controls":""},{"legacy_ids":["SV-59749","V-46883"],"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone -&gt; 'Allow scripting of Internet Explorer WebBrowser controls' must be 'Enabled', and 'Disable' selected from the drop-down box. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4 Criteria: If the value \"1206\" is REG_DWORD = 3, this is not a finding.","group_tree":{"title":"SRG-APP-000141","id":"V-223137"},"discussion":"This policy setting controls whether a page may control embedded WebBrowser Control via script. Scripted code hosted on sites located in this zone is more likely to contain malicious code. If you enable this policy setting, script access to the WebBrowser Control is allowed. If you disable this policy setting, script access to the WebBrowser Control is not allowed. If you do not configure this policy setting, script access to the WebBrowser Control can be enabled or disabled by the user. By default, script access to the WebBrowser Control is only allowed in the Local Machine and Intranet Zones.","security_override_guidance":"","group_title":"SRG-APP-000141","documentable":"false","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223137","false_positives":"","rule_id":"SV-223137r960963","severity":"medium","ccis":["CCI-000381"],"comments":null,"responsibility":"","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone -&gt; 'Allow scripting of Internet Explorer WebBrowser controls' to 'Enabled', and select 'Disable' from the drop-down box.   ","rule_title":"Scripting of Internet Explorer WebBrowser Control must be disallowed (Restricted Sites zone).","classification":"Unclassified","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Allow scripting of Internet Explorer web browser control)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:52400 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Allow scripting of Internet Explorer web browser control\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:52400 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Allow scripting of Internet Explorer web browser control\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\nObject Requirement      :  check =  'name' must be equal to '1206'\n\nState ID                : oval:mil.disa.fso.ie:ste:52400 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Allow scripting of Internet Explorer web browser control\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '3'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\n                        : name equals '1206'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '3'\n                        : windows_view equals '64_bit'\n","rule_id_src":"SV-223137r960963_rule","mitigation_control":"","check_content_ref":{"name":"oval:mil.disa.fso.ie:def:524","href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml"},"rule_version":"DTBI850-IE11","ia_controls":"","uuid":"D458DEC7-6BF7-1014-BC27-F0ACD3FA2A99","potential_impacts":"","weight":"10.0","group_id_src":"V-223137","mitigations":"","status":"not_a_finding"},{"classification":"Unclassified","rule_title":"When uploading files to a server, the local directory path must be excluded (Restricted Sites zone).","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone -&gt; 'Include local path when user is uploading files to a server' to 'Enabled', and select 'Disable' from the drop-down box.   ","reference_identifier":"4095","rule_id_src":"SV-223138r960963_rule","mitigation_control":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Include local directory path when uploading files to a server)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:52500 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Include local directory path when uploading files to a server\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:52500 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Include local directory path when uploading files to a server\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\nObject Requirement      :  check =  'name' must be equal to '160A'\n\nState ID                : oval:mil.disa.fso.ie:ste:52500 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Include local directory path when uploading files to a server\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '3'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\n                        : name equals '160A'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '3'\n                        : windows_view equals '64_bit'\n","third_party_tools":"","ia_controls":"","rule_version":"DTBI860-IE11","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:525"},"status":"not_a_finding","group_id_src":"V-223138","weight":"10.0","mitigations":"","potential_impacts":"","uuid":"D458EA34-6BF7-1014-B93D-C1E60458B4EB","security_override_guidance":"","discussion":"This policy setting controls whether or not the local path information will be sent when uploading a file via a HTML form. If the local path information is sent, some information may be unintentionally revealed to the server. If you do not configure this policy setting, the user can choose whether path information will be sent when uploading a file via a form. By default, path information will be sent.","check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone -&gt; 'Include local path when user is uploading files to a server' must be 'Enabled', and 'Disable' selected from the drop-down box. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4 Criteria: If the value \"160A\" is REG_DWORD = 3, this is not a finding.","group_tree":{"title":"SRG-APP-000141","id":"V-223138"},"legacy_ids":["SV-59751","V-46885"],"group_id":"V-223138","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","documentable":"false","group_title":"SRG-APP-000141","severity":"medium","false_positives":"","rule_id":"SV-223138r960963","responsibility":"","comments":null,"ccis":["CCI-000381"]},{"group_id":"V-223139","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","documentable":"false","group_title":"SRG-APP-000516","discussion":"This policy setting controls whether or not the 'Open File - Security Warning' message appears when the user tries to open executable files or other potentially unsafe files (from an intranet file shared by using Windows Explorer, for example). If you enable this policy setting and set the drop-down box to \"Enable\", these files open without a security warning. If you set the drop-down box to \"Prompt\", a security warning appears before the files open. If you disable this policy these files do not open. If you do not configure this policy setting, the user can configure how the computer handles these files.","security_override_guidance":"","check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone -&gt; 'Show security warning for potentially unsafe files' must be 'Enabled', and 'Disable' selected from the drop-down box. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4 Criteria: If the value \"1806\" is REG_DWORD = 3, this is not a finding.","group_tree":{"title":"SRG-APP-000516","id":"V-223139"},"legacy_ids":["SV-59755","V-46889"],"responsibility":"","comments":null,"ccis":["CCI-000366"],"severity":"medium","false_positives":"","rule_id":"SV-223139r961863","mitigation_control":"","rule_id_src":"SV-223139r961863_rule","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Launching programs and unsafe files)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:52600 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Launching programs and unsafe files\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:52600 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Launching programs and unsafe files\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\nObject Requirement      :  check =  'name' must be equal to '1806'\n\nState ID                : oval:mil.disa.fso.ie:ste:52600 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Launching programs and unsafe files\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '3'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\n                        : name equals '1806'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '3'\n                        : windows_view equals '64_bit'\n","classification":"Unclassified","rule_title":"Security Warning for unsafe files must be disallowed (Restricted Sites zone).","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone -&gt; 'Show security warning for potentially unsafe files' to 'Enabled', and select 'Disable' from the drop-down box.   ","reference_identifier":"4095","weight":"10.0","group_id_src":"V-223139","mitigations":"","status":"not_a_finding","potential_impacts":"","uuid":"D458F2F7-6BF7-1014-86C8-C6F201F195F1","ia_controls":"","rule_version":"DTBI870-IE11","check_content_ref":{"name":"oval:mil.disa.fso.ie:def:526","href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml"}},{"security_override_guidance":"","discussion":"This policy setting controls whether or not the user is prompted to allow ActiveX controls to run on websites other than the website that installed the ActiveX control. If the user were to disable the setting for the zone, malicious ActiveX controls could be executed without the user's knowledge. Disabling this setting would allow the possibility for malicious ActiveX controls to be executed from non-approved domains within this zone without the user's knowledge. Enabling this setting enforces the default value and prohibits the user from changing the value. Websites should be moved into another zone if permissions need to be changed.","legacy_ids":["SV-59759","V-46893"],"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone -&gt; 'Allow only approved domains to use ActiveX controls without prompt' must be 'Enabled', and 'Enable' selected from the drop-down box. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4 Criteria: If the value \"120b\" is REG_DWORD = 3, this is not a finding.","group_tree":{"id":"V-223140","title":"SRG-APP-000210"},"stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223140","group_title":"SRG-APP-000210","documentable":"false","severity":"medium","false_positives":"","rule_id":"SV-223140r961092","responsibility":"","ccis":["CCI-001170"],"comments":null,"classification":"Unclassified","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone -&gt; 'Allow only approved domains to use ActiveX controls without prompt' to 'Enabled', and select 'Enable' from the drop-down box.   ","rule_title":"ActiveX controls without prompt property must be used in approved domains only (Restricted Sites zone).","mitigation_control":"","rule_id_src":"SV-223140r961092_rule","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Only allow approved domains to use ActiveX controls without prompt)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:52700 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Only allow approved domains to use ActiveX controls without prompt\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:52700 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Only allow approved domains to use ActiveX controls without prompt\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\nObject Requirement      :  check =  'name' must be equal to '120B'\n\nState ID                : oval:mil.disa.fso.ie:ste:52700 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Only allow approved domains to use ActiveX controls without prompt\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '3'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\n                        : name equals '120B'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '3'\n                        : windows_view equals '64_bit'\n","rule_version":"DTBI880-IE11","ia_controls":"","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:527"},"status":"not_a_finding","mitigations":"","group_id_src":"V-223140","weight":"10.0","uuid":"D458FB3E-6BF7-1014-87AF-DD33B4BF6355","potential_impacts":""},{"ccis":["CCI-000381"],"comments":null,"responsibility":"","false_positives":"","rule_id":"SV-223141r960963","severity":"medium","documentable":"false","group_title":"SRG-APP-000141","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223141","legacy_ids":["SV-59761","V-46895"],"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone -&gt; 'Turn on Cross-Site Scripting Filter' must be 'Enabled', and 'Enable' selected from the drop-down box. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4 Criteria: If the value \"1409\" is REG_DWORD = 0, this is not a finding.","group_tree":{"title":"SRG-APP-000141","id":"V-223141"},"security_override_guidance":"","discussion":"The Cross-Site Scripting Filter is designed to prevent users from becoming victims of unintentional information disclosure. This setting controls if the Cross-Site Scripting (XSS) Filter detects and prevents cross-site script injection into websites in this zone. If you enable this policy setting, the XSS Filter will be enabled for sites in this zone, and the XSS Filter will attempt to block cross-site script injections. If you disable this policy setting, the XSS Filter will be disabled for sites in this zone, and Internet Explorer will permit cross-site script injections.","uuid":"D4590552-6BF7-1014-A093-C473C02C1A60","potential_impacts":"","status":"not_a_finding","mitigations":"","weight":"10.0","group_id_src":"V-223141","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:528"},"rule_version":"DTBI890-IE11","ia_controls":"","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Turn on Cross-Site Scripting (XSS) Filter)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:52800 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Turn on Cross-Site Scripting (XSS) Filter\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:52800 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Turn on Cross-Site Scripting (XSS) Filter\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\nObject Requirement      :  check =  'name' must be equal to '1409'\n\nState ID                : oval:mil.disa.fso.ie:ste:52800 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Turn on Cross-Site Scripting (XSS) Filter\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\n                        : name equals '1409'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","mitigation_control":"","rule_id_src":"SV-223141r960963_rule","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone -&gt; 'Turn on Cross-Site Scripting Filter' to 'Enabled', and select 'Enable' from the drop-down box.   ","reference_identifier":"4095","rule_title":"Cross-Site Scripting Filter property must be enforced (Restricted Sites zone).","classification":"Unclassified"},{"classification":"Unclassified","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Security Features -&gt; Restrict ActiveX Install -&gt; 'Internet Explorer Processes' to 'Enabled'.   ","rule_title":"Internet Explorer Processes Restrict ActiveX Install must be enforced (Reserved).","rule_id_src":"SV-223142r960921_rule","mitigation_control":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Restrict ActiveX Install\\Internet Explorer Processes must be Enabled)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:52900 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Restrict ActiveX Install\\Internet Explorer Processes must be Enabled\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:52900 (registry_object)\nObject Comment          : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Restrict ActiveX Install\\Internet Explorer Processes must be Enabled\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_RESTRICT_ACTIVEXINSTALL'\nObject Requirement      :  check =  'name' must be equal to '(Reserved)'\n\nState ID                : oval:mil.disa.fso.ie:ste:52900 (registry_state)\nState Comment           : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Security Features\\Restrict ActiveX Install\\Internet Explorer Processes must be Enabled\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_sz'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_RESTRICT_ACTIVEXINSTALL'\n                        : name equals '(Reserved)'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_sz'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","third_party_tools":"","rule_version":"DTBI900-IE11","ia_controls":"","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:529"},"mitigations":"","weight":"10.0","group_id_src":"V-223142","status":"not_a_finding","uuid":"D4590D88-6BF7-1014-BA92-ABA5037FE47D","potential_impacts":"","discussion":"Users often choose to install software such as ActiveX controls that are not permitted by their organization's security policy. Such software can pose significant security and privacy risks to networks. This policy setting enables blocking of ActiveX control installation prompts for Internet Explorer processes. If you enable this policy setting, prompts for ActiveX control installations will be blocked for Internet Explorer processes. If you disable this policy setting, prompts for ActiveX control installations will not be blocked and these prompts will be displayed to users. If you do not configure this policy setting, the user's preference will be used to determine whether to block ActiveX control installations for Internet Explorer processes.","security_override_guidance":"","legacy_ids":["SV-59763","V-46897"],"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Security Features -&gt; Restrict ActiveX Install -&gt; 'Internet Explorer Processes' must be 'Enabled'. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_RESTRICT_ACTIVEXINSTALL   Criteria: If the value \"(Reserved)\" is REG_SZ = 1, this is not a finding.","group_tree":{"id":"V-223142","title":"SRG-APP-000112"},"stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223142","group_title":"SRG-APP-000112","documentable":"false","severity":"medium","rule_id":"SV-223142r960921","false_positives":"","responsibility":"","ccis":["CCI-001695"],"comments":null},{"ia_controls":"","rule_version":"DTBI910-IE11","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:530"},"status":"not_a_finding","group_id_src":"V-223143","weight":"10.0","mitigations":"","potential_impacts":"","uuid":"D459159B-6BF7-1014-9845-B8B9F03476A2","classification":"Unclassified","rule_title":"Status bar updates via script must be disallowed (Internet zone).","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Internet Zone 'Allow updates to status bar via script' to 'Enabled', and select 'Disable' from the drop-down box.   ","mitigation_control":"","rule_id_src":"SV-223143r960963_rule","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone Allow status bar updates via script must be Enabled and Disable selected)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:53000 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone Allow status bar updates via script must be Enabled and Disable selected\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:53000 (registry_object)\nObject Comment          : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone Allow status bar updates via script must be Enabled and Disable selected\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\nObject Requirement      :  check =  'name' must be equal to '2103'\n\nState ID                : oval:mil.disa.fso.ie:ste:53000 (registry_state)\nState Comment           : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone Allow status bar updates via script must be Enabled and Disable selected\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '3'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\n                        : name equals '2103'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '3'\n                        : windows_view equals '64_bit'\n","severity":"medium","rule_id":"SV-223143r960963","false_positives":"","responsibility":"","comments":null,"ccis":["CCI-000381"],"security_override_guidance":"","discussion":"This policy setting allows you to manage whether script is allowed to update the status bar within the zone. A script running in the zone could cause false information to be displayed on the status bar, which could confuse the user and cause them to perform an undesirable action. If you enable this policy setting, script is allowed to update the status bar. If you disable this policy setting, script is not allowed to update the status bar. If you do not configure this policy setting, status bar updates via scripts will be disabled.","check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Internet Zone 'Allow updates to status bar via script' must be 'Enabled', and 'Disable' selected from the drop-down box. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3 Criteria: If the value \"2103\" is REG_DWORD = 3, this is not a finding.","group_tree":{"title":"SRG-APP-000141","id":"V-223143"},"legacy_ids":["SV-59769","V-46903"],"group_id":"V-223143","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_title":"SRG-APP-000141","documentable":"false"},{"severity":"medium","false_positives":"","rule_id":"SV-223144r961863","responsibility":"","comments":null,"ccis":["CCI-000366"],"discussion":"Unsigned components are more likely to contain malicious code and it is more difficult to determine the author of the application - therefore they should be avoided if possible. This policy setting allows you to manage whether .NET Framework components that are not signed with Authenticode can be executed from Internet Explorer. These components include managed controls referenced from an object tag and managed executables referenced from a link. If you enable this policy setting, Internet Explorer will execute unsigned managed components. If you select \"Prompt\" in the drop-down box, Internet Explorer will prompt the user to determine whether to execute unsigned managed components. If you disable this policy setting, Internet Explorer will not execute unsigned managed components. If you do not configure this policy setting, Internet Explorer will not execute unsigned managed components.","security_override_guidance":"","check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Internet Zone 'Run .NET Framework-reliant components not signed with Authenticode' must be 'Enabled', and 'Disable' selected from the drop-down box. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3 Criteria: If the value \"2004\" is REG_DWORD = 3, this is not a finding.","group_tree":{"title":"SRG-APP-000516","id":"V-223144"},"legacy_ids":["SV-59773","V-46907"],"group_id":"V-223144","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","documentable":"false","group_title":"SRG-APP-000516","ia_controls":"","rule_version":"DTBI920-IE11","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:531"},"mitigations":"","weight":"10.0","group_id_src":"V-223144","status":"not_a_finding","potential_impacts":"","uuid":"D4591DE8-6BF7-1014-AF0B-961E73213CB7","classification":"Unclassified","rule_title":".NET Framework-reliant components not signed with Authenticode must be disallowed to run (Internet zone).","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Internet Zone 'Run .NET Framework-reliant components not signed with Authenticode' to 'Enabled', and select 'Disable' from the drop-down box.   ","rule_id_src":"SV-223144r961863_rule","mitigation_control":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Run .NET Framework-reliant components not signed with Authenticode)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:53100 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Run .NET Framework-reliant components not signed with Authenticode\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:53100 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Run .NET Framework-reliant components not signed with Authenticode\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\nObject Requirement      :  check =  'name' must be equal to '2004'\n\nState ID                : oval:mil.disa.fso.ie:ste:53100 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Run .NET Framework-reliant components not signed with Authenticode\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '3'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\n                        : name equals '2004'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '3'\n                        : windows_view equals '64_bit'\n","third_party_tools":""},{"classification":"Unclassified","rule_title":".NET Framework-reliant components signed with Authenticode must be disallowed to run (Internet zone).","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Internet Zone 'Run .NET Framework-reliant components signed with Authenticode' to 'Enabled', and select 'Disable' from the drop-down box.  ","mitigation_control":"","rule_id_src":"SV-223145r961863_rule","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Run .NET Framework-reliant components signed with Authenticode)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:53200 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Run .NET Framework-reliant components signed with Authenticode\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:53200 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Run .NET Framework-reliant components signed with Authenticode\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\nObject Requirement      :  check =  'name' must be equal to '2001'\n\nState ID                : oval:mil.disa.fso.ie:ste:53200 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Run .NET Framework-reliant components signed with Authenticode\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '3'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\n                        : name equals '2001'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '3'\n                        : windows_view equals '64_bit'\n","third_party_tools":"","ia_controls":"","rule_version":"DTBI930-IE11","check_content_ref":{"name":"oval:mil.disa.fso.ie:def:532","href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml"},"group_id_src":"V-223145","weight":"10.0","mitigations":"","status":"not_a_finding","potential_impacts":"","uuid":"D4592654-6BF7-1014-824A-F762B5CEC2F9","discussion":"It may be possible for someone to host malicious content on a website that takes advantage of these components. This policy setting allows you to manage whether .NET Framework components that are signed with Authenticode can be executed from Internet Explorer. These components include managed controls referenced from an object tag and managed executables referenced from a link. If you enable this policy setting, Internet Explorer will execute signed managed components. If you select \"Prompt\" in the drop-down box, Internet Explorer will prompt the user to determine whether to execute signed managed components. If you disable this policy setting, Internet Explorer will not execute signed managed components. If you do not configure this policy setting, Internet Explorer will not execute signed managed components.","security_override_guidance":"","group_tree":{"title":"SRG-APP-000516","id":"V-223145"},"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Internet Zone 'Run .NET Framework-reliant components signed with Authenticode' must be 'Enabled', and 'Disable' selected from the drop-down box. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3 Criteria: If the value \"2001\" is REG_DWORD = 3, this is not a finding.","legacy_ids":["SV-59787","V-46921"],"group_id":"V-223145","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_title":"SRG-APP-000516","documentable":"false","severity":"medium","false_positives":"","rule_id":"SV-223145r961863","responsibility":"","comments":null,"ccis":["CCI-000366"]},{"mitigation_control":"","rule_id_src":"SV-223146r960963_rule","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Allow Scriptlets)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:53300 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Allow Scriptlets\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:53300 (registry_object)\nObject Comment          : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Allow Scriptlets\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\nObject Requirement      :  check =  'name' must be equal to '1209'\n\nState ID                : oval:mil.disa.fso.ie:ste:53300 (registry_state)\nState Comment           : Computer Configuration\\Network\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone\\Allow Scriptlets\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : for allvalue, the following must be true:\nState Requirement       :     value must be equal to '3'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\n                        : name equals '1209'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '3'\n                        : windows_view equals '64_bit'\n","third_party_tools":"","classification":"Unclassified","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone 'Allow Scriptlets' to 'Enabled', and select 'Disable' from the drop-down box.   ","reference_identifier":"4095","rule_title":"Scriptlets must be disallowed (Restricted Sites zone).","status":"not_a_finding","weight":"10.0","group_id_src":"V-223146","mitigations":"","uuid":"D4592F78-6BF7-1014-8C4D-CC0F69720151","potential_impacts":"","rule_version":"DTBI940-IE11","ia_controls":"","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:533"},"stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223146","group_title":"SRG-APP-000141","documentable":"false","security_override_guidance":"","discussion":"This policy setting allows you to manage whether scriptlets can be allowed. Scriptlets hosted on sites located in this zone are more likely to contain malicious code. If you enable this policy setting, users will be able to run scriptlets. If you disable this policy setting, users will not be able to run scriptlets. If you do not configure this policy setting, a scriptlet can be enabled or disabled by the user.","legacy_ids":["SV-59793","V-46927"],"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone 'Allow Scriptlets' must be 'Enabled', and 'Disable' selected from the drop-down box.  Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4 Criteria: If the value \"1209\" is REG_DWORD = 3, this is not a finding.","group_tree":{"id":"V-223146","title":"SRG-APP-000141"},"responsibility":"","ccis":["CCI-000381"],"comments":null,"severity":"medium","false_positives":"","rule_id":"SV-223146r960963"},{"check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:534"},"rule_version":"DTBI950-IE11","ia_controls":"","uuid":"D45937B1-6BF7-1014-83B3-D4B706C5C1C0","potential_impacts":"","status":"not_a_finding","weight":"10.0","mitigations":"","group_id_src":"V-223147","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone 'Allow updates to status bar via script' to 'Enabled', and select 'Disable' from the drop-down box. ","rule_title":"Status bar updates via script must be disallowed (Restricted Sites zone).","classification":"Unclassified","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone Allow status bar updates via script must be Enabled and Disabled selected)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:53400 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone Allow status bar updates via script must be Enabled and Disabled selected\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:53400 (registry_object)\nObject Comment          : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone Allow status bar updates via script must be Enabled and Disabled selected\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\nObject Requirement      :  check =  'name' must be equal to '2103'\n\nState ID                : oval:mil.disa.fso.ie:ste:53400 (registry_state)\nState Comment           : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Internet Control Panel\\Security Page\\Restricted Sites Zone Allow status bar updates via script must be Enabled and Disabled selected\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '3'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4'\n                        : name equals '2103'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '3'\n                        : windows_view equals '64_bit'\n","rule_id_src":"SV-223147r960963_rule","mitigation_control":"","false_positives":"","rule_id":"SV-223147r960963","severity":"medium","ccis":["CCI-000381"],"comments":null,"responsibility":"","legacy_ids":["SV-59805","V-46939"],"group_tree":{"title":"SRG-APP-000141","id":"V-223147"},"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Internet Control Panel -&gt; Security Page -&gt; Restricted Sites Zone 'Allow updates to status bar via script' must be 'Enabled', and 'Disable' selected from the drop-down box. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\4 Criteria: If the value \"2103\" is REG_DWORD = 3, this is not a finding.","security_override_guidance":"","discussion":"A script running in the zone could cause false information to be displayed on the status bar, which could confuse the user and cause an undesirable action. This policy setting allows you to manage whether script is allowed to update the status bar within the zone. If you enable this policy setting, script is allowed to update the status bar. If you disable this policy setting, script is not allowed to update the status bar. If you do not configure this policy setting, status bar updates via scripts will be disabled.","documentable":"false","group_title":"SRG-APP-000141","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223147"},{"security_override_guidance":"","discussion":"This setting prevents ActiveX controls from running in Protected Mode when Enhanced Protected Mode is enabled. When a user has an ActiveX control installed that is not compatible with Enhanced Protected Mode and a website attempts to load the control, Internet Explorer notifies the user and gives the option to run the website in regular Protected Mode. This policy setting disables this notification and forces all websites to run in Enhanced Protected Mode. Enhanced Protected Mode provides additional protection against malicious websites by using 64-bit processes on 64-bit versions of Windows. For computers running at least Windows 8, Enhanced Protected Mode also limits the locations Internet Explorer can read from in the registry and the file system. If you enable this policy setting, Internet Explorer will not give the user the option to disable Enhanced Protected Mode. All Protected Mode websites will run in Enhanced Protected Mode. If you disable or do not configure this policy setting, Internet Explorer notifies users and provides an option to run websites with incompatible ActiveX controls in regular Protected Mode.","legacy_ids":["SV-59841","V-46975"],"group_tree":{"title":"SRG-APP-000516","id":"V-223148"},"check_content":"Note: If McAfee ENS Web Control is being used, this is Not Applicable.\n\nThe policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer-&gt; Internet Control Panel-&gt; Advanced Page 'Do not allow ActiveX controls to run in Protected Mode when Enhanced Protected Mode is enabled' must be 'Enabled'. Procedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Internet Explorer\\Main Criteria: If the value \"DisableEPMCompat\" is REG_DWORD = 1, this is not a finding.\n","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-223148","group_title":"SRG-APP-000516","documentable":"false","severity":"medium","false_positives":"","rule_id":"SV-223148r961863","responsibility":"","ccis":["CCI-000366"],"comments":null,"classification":"Unclassified","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer-&gt; Internet Control Panel-&gt; Advanced Page 'Do not allow ActiveX controls to run in Protected Mode when Enhanced Protected Mode is enabled' to 'Enabled'.   ","reference_identifier":"4095","rule_title":"When Enhanced Protected Mode is enabled, ActiveX controls must be disallowed to run in Protected Mode.","mitigation_control":"","rule_id_src":"SV-223148r961863_rule","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration/Administrative Templates/Windows Components/Internet Explorer/Internet Control Panel/Advanced Page/Do not allow ActiveX controls to run in Protected Mode when Enhanced Protected Mode )\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:55600 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration/Administrative Templates/Windows Components/Internet Explorer/Internet Control Panel/Advanced Page/Do not allow ActiveX controls to run in Protected Mode when Enhanced Protected Mode \nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:55600 (registry_object)\nObject Comment          : Computer Configuration/Administrative Templates/Windows Components/Internet Explorer/Internet Control Panel/Advanced Page/Do not allow ActiveX controls to run in Protected Mode when Enhanced Protected Mode \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Internet Explorer\\Main'\nObject Requirement      :  check =  'name' must be equal to 'DisableEPMCompat'\n\nState ID                : oval:mil.disa.fso.ie:ste:55600 (registry_state)\nState Comment           : Computer Configuration/Administrative Templates/Windows Components/Internet Explorer/Internet Control Panel/Advanced Page/Do not allow ActiveX controls to run in Protected Mode when Enhanced Protected Mode \nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Internet Explorer\\Main'\n                        : name equals 'DisableEPMCompat'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","third_party_tools":"","rule_version":"DTBI985-IE11","ia_controls":"","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:556"},"status":"not_a_finding","weight":"10.0","group_id_src":"V-223148","mitigations":"","uuid":"D4593FE2-6BF7-1014-BB23-CA26A0CCBEDC","potential_impacts":""},{"responsibility":"","comments":null,"ccis":["CCI-001414"],"severity":"medium","rule_id":"SV-223149r1117169","false_positives":"","group_id":"V-223149","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_title":"SRG-APP-000039","documentable":"false","discussion":"This policy setting allows you to set options for dragging content from one domain to a different domain when the source and destination are in different windows. If you enable this policy setting, users can drag content from one domain to a different domain when the source and destination are in different windows. Users cannot change this setting. If you disable this policy setting, users cannot drag content from one domain to a different domain when both the source and destination are in different windows. Users cannot change this setting. If you do not configure this policy setting, users cannot drag content from one domain to a different domain when the source and destination are in different windows. Users can change this setting in the Internet Options dialog box.","security_override_guidance":"","group_tree":{"title":"SRG-APP-000039","id":"V-223149"},"check_content":"The policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer-&gt; Internet Control Panel-&gt; Security Page-&gt; Internet Zone 'Enable dragging of content from different domains across windows' must be 'Enabled', and 'Disabled' selected from the drop-down box. Procedure: Use the windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3 Criteria: If the value \"2709\" is REG_DWORD = 3, this is not a finding.","legacy_ids":["SV-59847","V-46981"],"weight":"10.0","group_id_src":"V-223149","mitigations":"","status":"not_a_finding","potential_impacts":"","uuid":"D4594802-6BF7-1014-A218-AC44C1BDD726","ia_controls":"","rule_version":"DTBI990-IE11","check_content_ref":{"name":"oval:mil.disa.fso.ie:def:547","href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml"},"mitigation_control":"","rule_id_src":"SV-223149r1117169_rule","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Enable dragging of content from different domains across windows)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:54700 (registry_test)\nResult                  : true\nTest Title              : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Enable dragging of content from different domains across windows\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:54700 (registry_object)\nObject Comment          : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Enable dragging of content from different domains across windows\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\nObject Requirement      :  check =  'name' must be equal to '2709'\n\nState ID                : oval:mil.disa.fso.ie:ste:54700 (registry_state)\nState Comment           : Computer Configuration\\Administrative Templates\\Windows Components\\Internet Explorer\\Internet Control Panel\\Security Page\\Internet Zone\\Enable dragging of content from different domains across windows\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '3'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Zones\\3'\n                        : name equals '2709'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '3'\n                        : windows_view equals '64_bit'\n","classification":"Unclassified","rule_title":"Dragging of content from different domains across windows must be disallowed (Internet zone).","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer-&gt; Internet Control Panel-&gt; Security Page-&gt; Internet Zone 'Enable dragging of content from different domains across windows' to 'Enabled', and select 'Disabled' from the drop-down box.   "},{"severity":"medium","rule_id":"SV-250540r1117186","false_positives":"","responsibility":"","comments":null,"ccis":["CCI-002450"],"discussion":"This parameter ensures only DOD-approved ciphers and algorithms are enabled for use by the web browser by allowing the user to turn on/off support for TLS and SSL. TLS is a protocol for protecting communications between the browser and the target server. When the browser attempts to set up a protected communication with the target server, the browser and server negotiate which protocol and version to use. The browser and server attempt to match each other's list of supported protocols and versions and pick the most preferred match.\n\nSatisfies: SRG-APP-000514, SRG-APP-000555, SRG-APP-000625, SRG-APP-000630, SRG-APP-000635","security_override_guidance":"","group_tree":{"title":"SRG-APP-000416","id":"V-250540"},"check_content":"The policy value for Computer Configuration &gt;&gt; Administrative Templates &gt;&gt; Windows Components &gt;&gt; Internet Explorer &gt;&gt; Internet Control Panel &gt;&gt; Advanced Page &gt;&gt; \"Turn off Encryption Support\" must be \"Enabled\".\n\nVerify the only option selected is \"Only use TLS 1.2\" from the drop-down box.\n\nProcedure: Use the Windows Registry Editor to navigate to the following key: HKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings!SecureProtocols.\n\nCriteria: If the value for \"SecureProtocols\" is not REG_DWORD = \"2048\", this is a finding.","legacy_ids":["SV-59337","V-46473"],"group_id":"V-250540","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_title":"SRG-APP-000416","documentable":"false","ia_controls":"","rule_version":"DTBI014-IE11","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:580"},"weight":"10.0","mitigations":"","group_id_src":"V-250540","status":"not_a_finding","potential_impacts":"","uuid":"D45952F3-6BF7-1014-92DC-F54E181D2E5F","classification":"Unclassified","rule_title":"Turn off Encryption Support must be enabled.","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration &gt;&gt; Administrative Templates &gt;&gt; Windows Components &gt;&gt; Internet Explorer &gt;&gt; Internet Control Panel &gt;&gt; Advanced Page &gt;&gt; \"Turn off Encryption Support\" to \"Enabled\".\n\nSelect only \"Only use TLS 1.2\" from the drop-down box.","mitigation_control":"","rule_id_src":"SV-250540r1117186_rule","third_party_tools":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true ('turn off encryption support' setting is handled by Group Policy.)\nTest                    :   true (TLS 1.2 must be selected for the IE option 'turn off encryption support' via Group Policy.)\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:58000 (registry_test)\nResult                  : true\nTest Title              : 'turn off encryption support' setting is handled by Group Policy.\nCheck Existence         : One or more collected items must exist.\nCheck                   : Result is based on check existence only.\n\nObject ID               : oval:mil.disa.fso.ie:obj:58000 (registry_object)\nObject Comment          : Registry value associated with IE 'turn off encryption support' option, Group Policy value.\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings'\nObject Requirement      :  check =  'name' must be equal to 'SecureProtocols'\n\nCollected Item/State Result : exists\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings'\n                        : name equals 'SecureProtocols'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '2048'\n                        : windows_view equals '64_bit'\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:58001 (registry_test)\nResult                  : true\nTest Title              : TLS 1.2 must be selected for the IE option 'turn off encryption support' via Group Policy.\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:58000 (registry_object)\nObject Comment          : Registry value associated with IE 'turn off encryption support' option, Group Policy value.\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings'\nObject Requirement      :  check =  'name' must be equal to 'SecureProtocols'\n\nState ID                : oval:mil.disa.fso.ie:ste:58000 (registry_state)\nState Comment           : Registry value corresponding with selection of TLS 1.2.\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '2048'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings'\n                        : name equals 'SecureProtocols'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '2048'\n                        : windows_view equals '64_bit'\n"},{"severity":"medium","false_positives":"","rule_id":"SV-250541r1117186","responsibility":"","ccis":["CCI-002450"],"comments":null,"discussion":"This parameter ensures only DoD-approved ciphers and algorithms are enabled for use by the web browser by blocking an insecure fallback to SSL when TLS 1.0 or greater fails.\n\nSatisfies: SRG-APP-000514, SRG-APP-000555, SRG-APP-000625, SRG-APP-000630, SRG-APP-000635","security_override_guidance":"","legacy_ids":["SV-79219","V-64729"],"check_content":"The policy value for Computer Configuration &gt;&gt; Administrative Templates &gt;&gt; Windows Components &gt;&gt; Internet Explorer &gt;&gt; Security Features &gt;&gt; \"Allow fallback to SSL 3.0 (Internet Explorer)\" must be \"Enabled\", and \"No Sites\" selected from the drop-down box. If \"Allow fallback to SSL 3.0 (Internet Explorer)\" is not \"Enabled\" or any other drop-down option is selected, this is a finding. \n\nProcedure: Use the Windows Registry Editor to navigate to the following key: \n\nHKLM\\Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings. \n\nCriteria: If the value \"EnableSSL3Fallback\" is REG_DWORD=0, this is not a finding.","group_tree":{"id":"V-250541","title":"SRG-APP-000416"},"stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-250541","group_title":"SRG-APP-000416","documentable":"false","rule_version":"DTBI1100-IE11","ia_controls":"","check_content_ref":{"name":"oval:mil.disa.fso.ie:def:581","href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml"},"group_id_src":"V-250541","mitigations":"","weight":"10.0","status":"not_a_finding","uuid":"D4595C42-6BF7-1014-A75A-951ABD2E7C97","potential_impacts":"","classification":"Unclassified","reference_identifier":"4095","fix_text":"Set the policy value for Computer Configuration &gt;&gt; Administrative Templates &gt;&gt; Windows Components &gt;&gt; Internet Explorer &gt;&gt; Security Features &gt;&gt; \"Allow fallback to SSL 3.0 (Internet Explorer)\" to \"Enabled\", and select \"No Sites\" from the drop-down box.\n","rule_title":"Allow Fallback to SSL 3.0 (Internet Explorer) must be disabled.","rule_id_src":"SV-250541r1117186_rule","mitigation_control":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true ('Allow Fallback to SSL 3.0 (Internet Explorer)' is set to 'Enabled' with 'Allow insecure fallback for:' set to 'No Sites')\n\n---\n\nTest ID                 : oval:mil.disa.fso.ie:tst:58100 (registry_test)\nResult                  : true\nTest Title              : 'Allow Fallback to SSL 3.0 (Internet Explorer)' is set to 'Enabled' with 'Allow insecure fallback for:' set to 'No Sites'\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.fso.ie:obj:58100 (registry_object)\nObject Comment          : Registry value associated with IE 'Allow Fallback to SSL 3.0' option, Group Policy value.\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings'\nObject Requirement      :  check =  'name' must be equal to 'EnableSSL3Fallback'\n\nState ID                : oval:mil.disa.fso.ie:ste:58100 (registry_state)\nState Comment           : Registry value corresponding with EnableSSL3Fallback value.\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings'\n                        : name equals 'EnableSSL3Fallback'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","third_party_tools":""},{"weight":"10.0","mitigations":"","group_id_src":"V-252910","status":"open","uuid":"D459652D-6BF7-1014-AE73-E6AD6F3518B7","potential_impacts":"","rule_version":"DTBI999-IE11","ia_controls":"","check_content_ref":{"name":"oval:navy.navwar.niwcatlantic.scc.windows:def:252910","href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval2.xml"},"rule_id_src":"SV-252910r1192839_rule","mitigation_control":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:02:55\nResult: failRule Result             : Fail\nCriteria                : false (All child tests must be true. (AND))\nTest                    :   false (The version of Internet Explorer running on the system must be a supported version.)\nResult Analysis         :        'Installed' failed test of 'pattern match' compared to '[Nn]ot [Pp]resent' \n\n---\n\nTest ID                 : oval:navy.navwar.niwcatlantic.scc.windows:tst:25291001 (shellcommand_test)\nResult                  : false\nTest Title              : The version of Internet Explorer running on the system must be a supported version.\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\nState Operator          : One or more item-state comparisons may be true.\n\nObject ID               : oval:navy.navwar.niwcatlantic.scc.windows:obj:25291001 (shellcommand_object)\nObject Comment          : Inter-site replication must configured to occur at least daily.\nObject Requirement      :  check =  'shell' must be equal to 'powershell'\nObject Requirement      :  check =  'command' must be equal to 'dism /online /get-capabilityinfo /capabilityname:Browser.InternetExplorer~~~~0.0.11.0'\nObject Requirement      :  check =  'pattern' must be equal to '^State\\s+:\\s+(\\w.*$)'\n\nState ID                : oval:navy.navwar.niwcatlantic.scc.windows:ste:25291001 (shellcommand_state)\nState Comment           : Not Present\nState Requirement       : check_existence = 'at_least_one_exists',  check = only one 'subexpression' must match the pattern '[Nn]ot [Pp]resent'\n\nState ID                : oval:navy.navwar.niwcatlantic.scc.windows:ste:25291002 (shellcommand_state)\nState Comment           : State: No Item Exists\n\nCollected Item/State Result : false\n                        : shell equals 'powershell'\n                        : command equals 'dism /online /get-capabilityinfo /capabilityname:Browser.InternetExplorer~~~~0.0.11.0'\n                        : pattern equals '^State\\s+:\\s+(\\w.*$)'\n                        : exit_status equals '0'\n                        : stdout_line equals 'State : Installed'\n                        : subexpression equals 'Installed'\n\nResult Analysis         : 'Installed' failed test of 'pattern match' compared to '[Nn]ot [Pp]resent' \n","third_party_tools":"","classification":"Unclassified","reference_identifier":"4095","fix_text":"Disable the Internet Explorer 11 application. Open PowerShell as an Administrator and run the command (this is irreversible):\n\ndism /online /Remove-Capability /CapabilityName:Browser.InternetExplorer~~~~0.0.11.0\n\nRestart the system for the changes to take effect.","rule_title":"The version of Internet Explorer running on the system must be a supported version.","responsibility":"","ccis":["CCI-002605"],"comments":null,"severity":"high","rule_id":"SV-252910r1192839","false_positives":"","stig_uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D","group_id":"V-252910","group_title":"SRG-APP-000456","documentable":"false","discussion":"Security flaws with software applications are discovered daily. Vendors are constantly updating and patching their products to address newly discovered security vulnerabilities. Organizations (including any contractor to the organization) are required to promptly install security-relevant software updates (e.g., patches, service packs, and hot fixes). Flaws discovered during security assessments, continuous monitoring, incident response activities, or information system error handling must also be addressed expeditiously.\n\nOrganization-defined time periods for updating security-relevant software may vary based on a variety of factors including, for example, the security category of the information system or the criticality of the update (i.e., severity of the vulnerability related to the discovered flaw).\n\nThis requirement will apply to software patch management solutions that are used to install patches across the enclave and also to applications that are not part of that patch management solution. For example, many browsers today provide the capability to install their own patch software. Patch criticality, as well as system criticality, will vary. Therefore, the tactical situations regarding the patch management process will also vary. This means the time period used must be a configurable parameter. Time frames for application of security-relevant software updates may depend on the Information Assurance Vulnerability Management (IAVM) process.","security_override_guidance":"","legacy_ids":[],"group_tree":{"title":"SRG-APP-000456","id":"V-252910"},"check_content":"Internet Explorer 11 is no longer supported by the vendor with the exception of some operating system versions under extended support (Ex: Windows Server 2019).\n\nTo determine the status of Internet Explorer 11 on the system, open PowerShell as an Administrator and run the command:\n\ndism /online /get-capabilityinfo /capabilityname:Browser.InternetExplorer~~~~0.0.11.0\n\nWithin the returned results, if \"State : Installed\", this is a finding.\n\nWithin the returned results, if \"State : Not Present\", this is not a finding.\n\nIf the host operating system is supported under an extended support agreement, and \"State : Installed\", this is not a finding.\n\nIf nothing related to Internet Explorer is returned, this is not a finding."}],"reference_identifier":"4095","size":137,"release_info":"Release: 7 Benchmark Date: 01 Apr 2026","version":"2","uuid":"D437A425-6BF7-1014-8C79-A5C858995E8D"}],"id":"D463842F-6BF7-1014-A09D-8FEC17F89055","target_data":{"mac_address":"00:50:56:2F:AE:28","host_name":"SOT-WIN2K22-01","ip_address":"192.168.40.169","target_type":"Computing","role":"Workstation","fqdn":"SOT-WIN2K22-01."}}