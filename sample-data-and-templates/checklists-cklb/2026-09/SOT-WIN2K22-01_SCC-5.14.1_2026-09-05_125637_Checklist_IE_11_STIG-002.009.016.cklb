       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_sz'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_RESTRICT_FILEDOWNLOAD'\n                        : name equals 'explorer.exe'\n                        : last_write_time equals '134330994260000000'\n                        : type equals 'reg_sz'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","third_party_tools":"","rule_id_src":"SV-223114r960963_rule","mitigation_control":"","check_content_ref":{"href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml","name":"oval:mil.disa.fso.ie:def:494"},"rule_version":"DTBI635-IE11","ia_controls":"","uuid":"D4580DDF-6BF7-1014-81D9-FC1D2602795F","potential_impacts":"","status":"not_a_finding","weight":"10.0","mitigations":"","group_id_src":"V-223114"},{"rule_version":"DTBI640-IE11","ia_controls":"","check_content_ref":{"name":"oval:mil.disa.fso.ie:def:495","href":"U_MS_IE11_V2R9_STIG_SCAP_1-4_Benchmark-enhancedV16-oval.xml"},"mitigations":"","group_id_src":"V-223115","weight":"10.0","status":"not_a_finding","uuid":"D4581874-6BF7-1014-94A2-BCDB79FEC32C","potential_impacts":"","classification":"Unclassified","fix_text":"Set the policy value for Computer Configuration -&gt; Administrative Templates -&gt; Windows Components -&gt; Internet Explorer -&gt; Security Features -&gt; Restrict File Download -&gt; 'Internet Explorer Processes' to 'Enabled'.   ","reference_identifier":"4095","rule_title":"Internet Explorer Processes for Restrict File Download must be enforced (iexplore).","rule_id_src":"SV-223115r960963_rule","mitigation_control":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         :