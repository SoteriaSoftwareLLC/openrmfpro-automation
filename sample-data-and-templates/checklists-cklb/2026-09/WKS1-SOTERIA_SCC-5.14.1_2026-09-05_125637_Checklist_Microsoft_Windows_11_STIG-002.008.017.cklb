rver equals 'AUDIT_NONE'\n                        : other_logon_logoff_events equals 'AUDIT_SUCCESS_FAILURE'\n                        : special_logon equals 'AUDIT_SUCCESS'\n                        : logon_claims equals 'AUDIT_NONE'\n                        : application_generated equals 'AUDIT_NONE'\n                        : certification_services equals 'AUDIT_NONE'\n                        : detailed_file_share equals 'AUDIT_FAILURE'\n                        : file_share equals 'AUDIT_SUCCESS_FAILURE'\n                        : file_system equals 'AUDIT_NONE'\n                        : filtering_platform_connection equals 'AUDIT_NONE'\n                        : filtering_platform_packet_drop equals 'AUDIT_NONE'\n                        : handle_manipulation equals 'AUDIT_NONE'\n                        : kernel_object equals 'AUDIT_NONE'\n                        : other_object_access_events equals 'AUDIT_SUCCESS_FAILURE'\n                        : registry equals 'AUDIT_NONE'\n                        : sam equals 'AUDIT_NONE'\n                        : removable_storage equals 'AUDIT_SUCCESS_FAILURE'\n                        : central_access_policy_staging equals 'AUDIT_NONE'\n                        : audit_policy_change equals 'AUDIT_SUCCESS'\n                        : authentication_policy_change equals 'AUDIT_SUCCESS'\n                        : authorization_policy_change equals 'AUDIT_SUCCESS'\n                        : filtering_platform_policy_change equals 'AUDIT_NONE'\n                        : mpssvc_rule_level_policy_change equals 'AUDIT_SUCCESS_FAILURE'\n                        : other_policy_change_events equals 'AUDIT_SUCCESS_FAILURE'\n                        : non_sensitive_privilege_use equals 'AUDIT_NONE'\n                        : other_privilege_use_events equals 'AUDIT_NONE'\n                        : sensitive_privilege_use equals 'AUDIT_SUCCESS_FAILURE'\n                        : ipsec_driver equals 'AUDIT_FAILURE'\n                        : other_system_events equals 'AUDIT_SUCCESS_FAILURE'\n                        : security_state_change equals 'AUDIT_SUCCESS'\n                        : security_system_extension equals 'AUDIT_SUCCESS'\n                        : system_integrity equals 'AUDIT_SUCCESS_FAILURE'\n                        : group_membership equals 'AUDIT_SUCCESS'\n                        : pnp_activity equals 'AUDIT_SUCCESS'\n                        : user_device_claims equals 'AUDIT_NONE'\n                        : audit_detailedtracking_tokenrightadjusted equals 'AUDIT_NONE'\n","stig_uuid":"3637ABFC-6BF8-1014-A5BB-C980152CC4B4","mitigations":"","discussion":"Maintaining an audit trail of system activity logs can help identify configuration errors, troubleshoot service disruptions, and analyze compromises that have occurred, as well as detect attacks. Audit logs are necessary to provide a trail of evidence in case the system or network is compromised. Collecting this data is essential for analyzing the security of information assets and detecting signs of suspicious and unexpected behavior.\n\nAudit Detailed File Share allows the user to audit attempts to access files and folders on a shared folder.\nThe Detailed File Share setting logs an event every time a file or folder is accessed, whereas the File Share setting only records one event for any connection established between a client and file share. Detailed File Share audit events include detailed information about the permissions or other criteria used to grant or deny access.","security_override_guidance":"","rule_title":"Windows 11 must be configured to audit Detailed File Share Failures.","fix_text":"Configure the policy value for Computer Configuration &gt;&gt; Windows Settings &gt;&gt; Security Settings &gt;&gt; Advanced Audit Policy Configuration &gt;&gt; System Audit Policies &gt;&gt; Object Access &gt;&gt; Audit Detailed File Share\" with \"Failure\" selected.","legacy_ids":[],"false_positives":"","group_id_src":"V-253347","potential_impacts":"","group_id":"V-253347","check_content_ref":{"name":"oval:mil.disa.stig.windows11:def:253347","href":"U_MS_Windows_11_V2R8_STIG_SCAP_1-4_Benchmark-enhancedV17-oval.xml"},"uuid":"36719025-6BF8-1014-9514-F262A8E55A0B","status":"not_a_finding","classification":"Unclassified","comments":null,"rule_id":"SV-253347r958412","mitigation_control":"","rule_id_src":"SV-253347r958412_rule","check_content":"Use the AuditPol tool to review the current Audit Policy configuration:\nOpen a Command Prompt with elevated privileges (\"Run as Administrator\").\nEnter \"AuditPol /get /category:*\".\n\nCompare the AuditPol settings with the following. If the system does not audit the following, this is a finding:\n\nObject Access &gt;&gt; Detailed File Share - Failure","ia_controls":"","group_tree":{"title":"SRG-OS-000037-GPOS-00015","id":"V-253347"},"responsibility":"","reference_identifier":"5471","third_party_tools":"","documentable":"false","weight":"10.0","rule_version":"WN11-AU-000570","ccis":["CCI-000130"],"severity":"medium","group_title":"SRG-OS-000037-GPOS-00015"},{"group_title":"SRG-OS-000037-GPOS-00015","severity":"medium","ccis":["CCI-000130"],"rule_version":"WN11-AU-000575","weight":"10.0","documentable":"false","responsibility":"","reference_identifier":"5471","third_party_tools":"","group_tree":{"id":"V-253348","title":"SRG-OS-000037-GPOS-00015"},"ia_controls":"","check_content":"Use the AuditPol tool to review the current Audit Policy configuration:\nOpen a Command Prompt with elevated privileges (\"Run as Administrator\").\nEnter \"AuditPol /get /category:*\".\n\nCompare the AuditPol settings with the following. If the system does not audit the following, this is a finding:\n\nPolicy Change &gt;&gt; MPSSVC Rule-Level Policy Change - Success","rule_id_src":"SV-253348r958412_rule","mitigation_control":"","rule_id":"SV-253348r958412","classification":"Unclassified","comments":null,"status":"not_a_finding","uuid":"36719748-6BF8-1014-A143-E5AAC9C87611","check