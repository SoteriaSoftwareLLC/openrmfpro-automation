                     : logon_claims equals 'AUDIT_NONE'\n                        : application_generated equals 'AUDIT_NONE'\n                        : certification_services equals 'AUDIT_NONE'\n                        : detailed_file_share equals 'AUDIT_FAILURE'\n                        : file_share equals 'AUDIT_SUCCESS_FAILURE'\n                        : file_system equals 'AUDIT_NONE'\n                        : filtering_platform_connection equals 'AUDIT_NONE'\n                        : filtering_platform_packet_drop equals 'AUDIT_NONE'\n                        : handle_manipulation equals 'AUDIT_NONE'\n                        : kernel_object equals 'AUDIT_NONE'\n                        : other_object_access_events equals 'AUDIT_SUCCESS_FAILURE'\n                        : registry equals 'AUDIT_NONE'\n                        : sam equals 'AUDIT_NONE'\n                        : removable_storage equals 'AUDIT_SUCCESS_FAILURE'\n                        : central_access_policy_staging equals 'AUDIT_NONE'\n                        : audit_policy_change equals 'AUDIT_SUCCESS'\n                        : authentication_policy_change equals 'AUDIT_SUCCESS'\n                        : authorization_policy_change equals 'AUDIT_SUCCESS'\n                        : filtering_platform_policy_change equals 'AUDIT_NONE'\n                        : mpssvc_rule_level_policy_change equals 'AUDIT_SUCCESS_FAILURE'\n                        : other_policy_change_events equals 'AUDIT_SUCCESS_FAILURE'\n                        : non_sensitive_privilege_use equals 'AUDIT_NONE'\n                        : other_privilege_use_events equals 'AUDIT_NONE'\n                        : sensitive_privilege_use equals 'AUDIT_SUCCESS_FAILURE'\n                        : ipsec_driver equals 'AUDIT_FAILURE'\n                        : other_system_events equals 'AUDIT_SUCCESS_FAILURE'\n                        : security_state_change equals 'AUDIT_SUCCESS'\n                        : security_system_extension equals 'AUDIT_SUCCESS'\n                        : system_integrity equals 'AUDIT_SUCCESS_FAILURE'\n                        : group_membership equals 'AUDIT_SUCCESS'\n                        : pnp_activity equals 'AUDIT_SUCCESS'\n                        : user_device_claims equals 'AUDIT_NONE'\n                        : audit_detailedtracking_tokenrightadjusted equals 'AUDIT_NONE'\n","uuid":"367179FF-6BF8-1014-85D2-B205FB697F78","check_content_ref":{"href":"U_MS_Windows_11_V2R8_STIG_SCAP_1-4_Benchmark-enhancedV17-oval.xml","name":"oval:mil.disa.stig.windows11:def:253344"},"status":"not_a_finding","fix_text":"Configure the policy value for Computer Configuration &gt;&gt; Windows Settings &gt;&gt; Security Settings &gt;&gt; Advanced Audit Policy Configuration &gt;&gt; System Audit Policies &gt;&gt; Policy Change&gt;&gt; \"Audit Other Policy Change Events\" with \"Failure\" selected.","potential_impacts":"","group_id":"V-253344","false_positives":"","legacy_ids":[],"group_id_src":"V-253344","third_party_tools":"","reference_identifier":"5471","responsibility":"","group_tree":{"id":"V-253344","title":"SRG-OS-000037-GPOS-00015"},"weight":"10.0","documentable":"false","mitigation_control":"","rule_id":"SV-253344r958412","comments":null,"classification":"Unclassified","ia_controls":"","check_content":"Use the AuditPol tool to review the current Audit Policy configuration:\nOpen a Command Prompt with elevated privileges (\"Run as Administrator\").\nEnter \"AuditPol /get /category:*\".\n\nCompare the AuditPol settings with the following. If the system does not audit the following, this is a finding:\n\nPolicy Change &gt;&gt; Other Policy Change Events - Failure","rule_id_src":"SV-253344r958412_rule","ccis":["CCI-000130"],"group_title":"SRG-OS-000037-GPOS-00015","severity":"medium","rule_version":"WN11-AU-000555"},{"status":"not_a_finding","uuid":"36718191-6BF8-1014-B0FB-A766182FA2EF","check_content_ref":{"href":"U_MS_Windows_11_V2R8_STIG_SCAP_1-4_Benchmark-enhancedV17-oval.xml","name":"oval:mil.disa.stig.windows11:def:253345"},"group_id":"V-253345","potential_impacts":"","legacy_ids":[],"false_positives":"","group_id_src":"V-253345","fix_text":"Configure the policy value for Computer Configuration &gt;&gt; Windows Settings &gt;&gt; Security Settings &gt;&gt; Advanced Audit Policy Configuration &gt;&gt; System Audit Policies &gt;&gt; Logon/Logoff &gt;&gt; \"Audit Other Logon/Logoff Events\" with \"Success\" selected.","security_override_guidance":"","rule_title":"Windows 11 must be configured to audit other Logon/Logoff Events Successes.","discussion":"Maintaining an audit trail of system activity logs can help identify configuration errors, troubleshoot service disruptions, and analyze compromises that have occurred, as well as detect attacks. Audit logs are necessary to provide a trail of evidence in case the system or network is compromised. Collecting this data is essential for analyzing the security of information assets and detecting signs of suspicious and unexpected behavior.\n\nAudit Other Logon/Logoff Events determines whether Windows generates audit events for other logon or logoff events. Logon events are essential to understanding user activity and detecting potential attacks.","mitigations":"","stig_uuid":"3637ABFC-6BF8-1014-A5BB-C980152CC4B4","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:03:20\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nCriteria                :   true (All child tests must be true. (AND))\nTest                    :     true ('Audit Logon' is set to 'Failure' and 'Succss and Failure)\n\n---\n\nTest ID                 : oval:mil.disa.stig.win:tst:25334500 (auditeventpolicysubcategories_test)\nResult                  : true\nTest Title              : 'Audit Logon' is set to 'Failure' and 'Succss and Failure\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\nState Operator          : One or more item-state comparisons may be true.\n\nObject ID               : oval:mil.disa.stig.win:obj:20000000 (auditeventpolicysubcategories_object)\nObject Comment          : \nObject Requirement      : Collect any available items.\n\nState ID                : oval:mil.disa.stig.win:ste:25334500 (auditeventpolicysubcategories_state)\nState Comment           : 'Log On' is set to 'Success'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'other_logon_logoff_events' must be equal to 'AUDIT_SUCCESS'\n\nState ID                : oval:mil.disa.stig.win:ste:25334501 (auditeventpolicysubcategories_state)\nState Comment           : 'Log On' is set to 'Success' and 'Failure'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'other_logon_logoff_events' must be equal to 'AUDIT_SUCCESS_FAILURE'\n\nCollected Item/State Result : true\n                        : credential_validation equals 'AUDIT_SUCCESS_FAILURE'\n                        : kerberos_authentication_service equals 'AUDIT_NONE'\n                        : kerberos_service_ticket_operations equals 'AUDIT_NONE'\n                        : kerberos_ticket_events equals 'AUDIT_NONE'\n                        : other_account_logon_events equals 'AUDIT_NONE'\n                        : application_group_management equals 'AUDIT_NONE'\n                        : computer_account_management equals 'AUDIT_NONE'\n                        : distribution_group_management equals 'AUDIT_NONE'\n                        : other_account_management_events equals 'AUDIT_NONE'\n                        : security_group_management equals 'AUDIT_SUCCESS'\n                        : user_account_management equals 'AUDIT_SUCCESS_FAILURE'\n                        : dpapi_activity equals 'AUDIT_NONE'\n                        : process_creation equals 'AUDIT_SUCCESS'\n                        : process_termination equal