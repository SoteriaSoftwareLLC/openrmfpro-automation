ue for Computer Configuration &gt;&gt; Windows Settings &gt;&gt; Security Settings &gt;&gt; Advanced Audit Policy Configuration &gt;&gt; System Audit Policies &gt;&gt; Privilege Use &gt;&gt; \"Audit Sensitive Privilege Use\" with \"Failure\" selected.","weight":"10.0","documentable":"false","reference_identifier":"5471","responsibility":"","third_party_tools":"","group_tree":{"id":"V-253328","title":"SRG-OS-000327-GPOS-00127"},"ia_controls":"","check_content":"Security Option \"Audit: Force audit policy subcategory settings to override audit policy category settings\" must be set to \"Enabled\" (WN11-SO-000030) for the detailed auditing subcategories to be effective.\n\nUse the AuditPol tool to review the current Audit Policy configuration:\nOpen a Command Prompt with elevated privileges (\"Run as Administrator\").\nEnter \"AuditPol /get /category:*\".\n\nCompare the AuditPol settings with the following. If the system does not audit the following, this is a finding:\n\nPrivilege Use &gt;&gt; Sensitive Privilege Use - Failure","rule_id_src":"SV-253328r958732_rule","mitigation_control":"","rule_id":"SV-253328r958732","comments":null,"classification":"Unclassified","group_title":"SRG-OS-000327-GPOS-00127","severity":"medium","ccis":["CCI-002234"],"rule_version":"WN11-AU-000110"},{"status":"not_a_finding","uuid":"3671036A-6BF8-1014-997C-97871B4BA4EF","check_content_ref":{"href":"U_MS_Windows_11_V2R8_STIG_SCAP_1-4_Benchmark-enhancedV17-oval.xml","name":"oval:mil.disa.stig.windows11:def:253329"},"group_id":"V-253329","potential_impacts":"","legacy_ids":[],"false_positives":"","group_id_src":"V-253329","fix_text":"Configure the policy value for Computer Configuration &gt;&gt; Windows Settings &gt;&gt; Security Settings &gt;&gt; Advanced Audit Policy Configuration &gt;&gt; System Audit Policies &gt;&gt; Privilege Use &gt;&gt; \"Audit Sensitive Privilege Use\" with \"Success\" selected.","security_override_guidance":"","rule_title":"The system must be configured to audit Pri