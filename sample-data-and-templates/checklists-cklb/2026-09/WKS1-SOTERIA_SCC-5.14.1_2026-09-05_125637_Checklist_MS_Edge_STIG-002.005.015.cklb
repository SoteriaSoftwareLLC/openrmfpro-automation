Edge'\n                        : name equals 'ImportSearchEngine'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","rule_title":"Importing of search engine settings must be disabled.","security_override_guidance":"","mitigations":"","discussion":"Allows users to import search engine settings from another browser into Microsoft Edge.\n\nIf this policy is enabled, the option to import search engine settings is automatically selected.\n\nIf this policy is disabled, search engine settings are not imported at first run, and users cannot import them manually.","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow importing of search engine settings\" to \"disabled\".","group_id":"V-235739","potential_impacts":"","legacy_ids":[],"false_positives":"","group_id_src":"V-235739","uuid":"88E141CE-6BF8-1014-907C-FB5E07355E94","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:117","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"status":"not_a_finding","rule_id":"SV-235739r960963","mitigation_control":"","classification":"Unclassified","comments":null,"rule_id_src":"SV-235739r960963_rule","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow importing of search engine settings\" must be set to \"disabled\".\n\nProcedure: Use the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"ImportSearchEngine\" is not set to \"REG_DWORD = 0\", this is a finding.","ia_controls":"","group_tree":{"id":"V-235739","title":"SRG-APP-000141"},"reference_identifier":"5280","third_party_tools":"","responsibility":"","documentable":"false","weight":"10.0","rule_version":"EDGE-00-000022","ccis":["CCI-000381"],"severity":"medium","group_title":"SRG-APP-000141"},{"classification":"Unclassified","comments":null,"mitigation_control":"","rule_id":"SV-235740r960963","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow importing of shortcuts\" must be set to \"disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"ImportShortcuts\" is not set to \"REG_DWORD = 0\", this is a finding.","ia_controls":"","rule_id_src":"SV-235740r960963_rule","reference_identifier":"5280","third_party_tools":"","responsibility":"","group_tree":{"id":"V-235740","title":"SRG-APP-000141"},"weight":"10.0","documentable":"false","rule_version":"EDGE-00-000023","ccis":["CCI-000381"],"group_title":"SRG-APP-000141","severity":"medium","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Disable importing of shortcuts)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:11800 (registry_test)\nResult                  : true\nTest Title              : Disable importing of shortcuts\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:11800 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'ImportShortcuts'\n\nState ID                : oval:mil.disa.stig.edge:ste:10 (registry_state)\nState Comment           : Reg_Dword type and value equals 0\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'ImportShortcuts'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","discussion":"Allows users to import Shortcuts from another browser into Microsoft Edge.\n\nIf this policy is disabled, Shortcuts are not imported on first run.\n\nIf this policy is not configured, Shortcuts are imported on first run.","mitigations":"","rule_title":"Importing of shortcuts must be disabled.","security_override_guidance":"","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow importing of shortcuts\" to \"disabled\".","false_positives":"","legacy_ids":[],"group_id_src":"V-235740","potential_impacts":"","group_id":"V-235740","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:118","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"uuid":"88E147FC-6BF8-1014-B1D9-820C362E208F","status":"not_a_finding"},{"status":"not_a_finding","uuid":"88E14E11-6BF8-1014-BE39-B6D369F57677","check_content_ref":{"href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml","name":"oval:mil.disa.stig.edge:def:119"},"group_id":"V-235741","potential_impacts":"","false_positives":"","legacy_ids":[],"group_id_src":"V-235741","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow media autoplay for websites\" to \"disabled\".","security_override_guidance":"","rule_title":"AutoplayAllowed must be set to disabled.","mitigations":"","discussion":"This policy sets the media autoplay policy for websites.\n\nThe default setting \"Not configured\" respects the current media autoplay settings and lets users configure their autoplay settings.\n\nSetting to \"Enabled\" sets media autoplay to \"Allow\". All websites are allowed to autoplay media. Users cannot override this policy.\n\nSetting to \"Disabled\" sets media autoplay to \"Limit\". This limits websites that are allowed to autoplay media to webpages with high media engagement and active WebRTC streams. Prior to Microsoft Edge version 92, this would set media autoplay to \"Block\". Users cannot override this policy.","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Disable autoplay)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:11900 (registry_test)\nResult                  : true\nTest Title              : Disable autoplay\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:11900 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'AutoplayAllowed'\n\nState ID                : oval:mil.disa.stig.edge:ste:10 (registry_state)\nState Comment           : Reg_Dword type and value equals 0\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'AutoplayAllowed'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","severity":"medium","group_title":"SRG-APP-000141","ccis":["CCI-000381"],"rule_version":"EDGE-00-000024","documentable":"false","weight":"10.0","group_tree":{"id":"V-235741","title":"SRG-APP-000141"},"reference_identifier":"5280","responsibility":"","third_party_tools":"","rule_id_src":"SV-235741r1007485_rule","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow media autoplay for websites\" must be set to \"disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"AutoplayAllowed\" is not set to \"REG_DWORD = 0\", this is a finding.","ia_controls":"","rule_id":"SV-235741r1007485","mitigation_control":"","classification":"Unclassified","comments":null},{"fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Content settings/Control use of the WebUSB API\" to enabled\" and select \"Do not allow any site to request access to USB devices via the WebUSB API\".","potential_impacts":"","group_id":"V-235742","false_positives":"","legacy_ids":[],"group_id_src":"V-235742","uuid":"88E15443-6BF8-1014-B761-DAB5BFF7FE99","check_content_ref":{"href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml","name":"oval:mil.disa.stig.edge:def:120"},"status":"not_a_finding","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (WebUSB must be disabled)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:12000 (registry_test)\nResult                  : true\nTest Title              : WebUSB must be disabled\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:12000 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'DefaultWebUsbGuardSetting'\n\nState ID                : oval:mil.disa.stig.edge:ste:12 (registry_state)\nState Comment           : Reg_Dword type and value equals 2\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '2'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'DefaultWebUsbGuardSetting'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '2'\n                        : windows_view equals '64_bit'\n","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","security_override_guidance":"","rule_title":"WebUSB must be disabled.","mitigations":"","discussion":"Set whether websites can access connected USB devices. Access can be blocked completely or the user asked each time a website wants to get access to connected USB devices.\n\nOverride this policy for specific URL patterns by using the WebUsbAskForUrls and WebUsbBlockedForUrls policies.\n\nIf this policy is not configured, sites can ask users whether they can access the connected USB devices ('AskWebUsb') by default, and users can change this setting.","rule_version":"EDGE-00-000025","ccis":["CCI-000381"],"severity":"medium","group_title":"SRG-APP-000141","rule_id":"SV-235742r960963","mitigation_control":"","classification":"Unclassified","comments":null,"rule_id_src":"SV-235742r960963_rule","ia_controls":"","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Content settings/Control use of the WebUSB API\" must be set to \"enabled\" with the option value set to \"Do not allow any site to request access to USB devices via the WebUSB API\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"DefaultWebUsbGuardSetting\" is not set to \"REG_DWORD = 2\", this is a finding.","group_tree":{"title":"SRG-APP-000141","id":"V-235742"},"reference_identifier":"5280","third_party_tools":"","responsibility":"","documentable":"false","weight":"10.0"},{"rule_version":"EDGE-00-000026","group_title":"SRG-APP-000141","severity":"medium","ccis":["CCI-000381"],"ia_controls":"","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Cast/Enable Google Cast\" must be set to \"disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"EnableMediaRouter\" is not set to \"REG_DWORD = 0\", this is a finding.","rule_id_src":"SV-235743r960963_rule","mitigation_control":"","rule_id":"SV-235743r960963","comments":null,"classification":"Unclassified","weight":"10.0","documentable":"false","reference_identifier":"5280","third_party_tools":"","responsibility":"","group_tree":{"title":"SRG-APP-000141","id":"V-235743"},"potential_impacts":"","group_id":"V-235743","false_positives":"","legacy_ids":[],"group_id_src":"V-235743","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Cast/Enable Google Cast\" to \"disabled\".","status":"not_a_finding","uuid":"88E15A76-6BF8-1014-A201-EBBB7FF3D52E","check_content_ref":{"href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml","name":"oval:mil.disa.stig.edge:def:121"},"finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Google Cast is disabled)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:12100 (registry_test)\nResult                  : true\nTest Title              : Google Cast is disabled\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:12100 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'EnableMediaRouter'\n\nState ID                : oval:mil.disa.stig.edge:ste:10 (registry_state)\nState Comment           : Reg_Dword type and value equals 0\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'EnableMediaRouter'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","rule_title":"Google Cast must be disabled.","security_override_guidance":"","discussion":"Enable this policy to enable Google Cast. Users will be able to launch it from the app menu, page context menus, media controls on Cast-enabled websites, and (if shown) the Cast toolbar icon.\n\nDisable this policy to disable Google Cast.\n\nBy default, Google Cast is enabled.","mitigations":"","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13"},{"classification":"Unclassified","comments":null,"rule_id":"SV-235744r960963","mitigation_control":"","rule_id_src":"SV-235744r960963_rule","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Content settings/Control use of the Web Bluetooth API\" must be set to \"enabled\" with the option value set to \"Do not allow any site to request access to Bluetooth devices via the Web Bluetooth API\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"DefaultWebBluetoothGuardSetting\" is not set to \"REG_DWORD = 2\", this is a finding.","ia_controls":"","group_tree":{"title":"SRG-APP-000141","id":"V-235744"},"reference_identifier":"5280","third_party_tools":"","responsibility":"","documentable":"false","weight":"10.0","rule_version":"EDGE-00-000027","ccis":["CCI-000381"],"severity":"medium","group_title":"SRG-APP-000141","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Web Bluetooth API is disabled)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:12200 (registry_test)\nResult                  : true\nTest Title              : Web Bluetooth API is disabled\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:12200 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'DefaultWebBluetoothGuardSetting'\n\nState ID                : oval:mil.disa.stig.edge:ste:12 (registry_state)\nState Comment           : Reg_Dword type and value equals 2\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '2'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'DefaultWebBluetoothGuardSetting'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '2'\n                        : windows_view equals '64_bit'\n","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","mitigations":"","discussion":"Control whether websites can access nearby Bluetooth devices. Access can be blocked completely or the site required to ask the user each time it wants to access a Bluetooth device.\n\nIf this policy is not configured, the default value ('AskWebBluetooth', meaning users are asked each time) is used and users can change it.\n\nPolicy options mapping:\n- BlockWebBluetooth (2) = Do not allow any site to request access to Bluetooth devices via the Web Bluetooth API.\n- AskWebBluetooth (3) = Allow sites to ask the user to grant access to a nearby Bluetooth device.","rule_title":"Web Bluetooth API must be disabled.","security_override_guidance":"","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Content settings/Control use of the Web Bluetooth API\" to \"enabled\" with the option value set to \"Do not allow any site to request access to Bluetooth devices via the Web Bluetooth API.","legacy_ids":[],"false_positives":"","group_id_src":"V-235744","group_id":"V-235744","potential_impacts":"","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:122","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"uuid":"88E160BD-6BF8-1014-8D06-8971BDD58D9F","status":"not_a_finding"},{"group_tree":{"id":"V-235745","title":"SRG-APP-000141"},"reference_identifier":"5280","third_party_tools":"","responsibility":"","documentable":"false","weight":"10.0","rule_id":"SV-235745r960963","mitigation_control":"","classification":"Unclassified","comments":null,"rule_id_src":"SV-235745r960963_rule","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Enable AutoFill for credit cards\" must be set to \"disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"AutofillCreditCardEnabled\" is not set to \"REG_DWORD = 0\", this is a finding.","ia_controls":"","ccis":["CCI-000381"],"severity":"medium","group_title":"SRG-APP-000141","rule_version":"EDGE-00-000028","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","security_override_guidance":"","rule_title":"Autofill for Credit Cards must be disabled.","mitigations":"","discussion":"Enables the Microsoft Edge AutoFill feature and lets users auto complete credit card information in web forms using previously stored information.\n\nIf this policy is disabled, AutoFill never suggests or fills credit card information, nor will it save additional credit card information that users might submit while browsing the web.\n\nIf this policy is enabled or not configured, users can control AutoFill for credit cards.","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Disable autofill for credit cards)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:12300 (registry_test)\nResult                  : true\nTest Title              : Disable autofill for credit cards\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:12300 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'AutofillCreditCardEnabled'\n\nState ID                : oval:mil.disa.stig.edge:ste:10 (registry_state)\nState Comment           : Reg_Dword type and value equals 0\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'AutofillCreditCardEnabled'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","uuid":"88E166F0-6BF8-1014-83BC-90740DF02A80","check_content_ref":{"href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml","name":"oval:mil.disa.stig.edge:def:123"},"status":"not_a_finding","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Enable AutoFill for credit cards\" to \"disabled\".","potential_impacts":"","group_id":"V-235745","legacy_ids":[],"false_positives":"","group_id_src":"V-235745"},{"fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Enable AutoFill for addresses\" to \"disabled\".","potential_impacts":"","group_id":"V-235746","legacy_ids":[],"group_id_src":"V-235746","false_positives":"","uuid":"88E170B5-6BF8-1014-8EFA-F94153998BE7","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:124","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"status":"not_a_finding","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Disable autofill for addresses)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:12400 (registry_test)\nResult                  : true\nTest Title              : Disable autofill for addresses\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:12400 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'AutofillAddressEnabled'\n\nState ID                : oval:mil.disa.stig.edge:ste:10 (registry_state)\nState Comment           : Reg_Dword type and value equals 0\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'AutofillAddressEnabled'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","rule_title":"Autofill for addresses must be disabled.","security_override_guidance":"","mitigations":"","discussion":"Enables the AutoFill feature and allows users to auto-complete address information in web forms using previously stored information.\n\nIf this policy is disabled, AutoFill never suggests or fills credit card information, nor will it save additional credit card information that users might submit while browsing the web.\n\nIf this policy is enabled or not configured, users can control AutoFill for addresses in the user interface.","rule_version":"EDGE-00-000029","ccis":["CCI-000381"],"severity":"medium","group_title":"SRG-APP-000141","rule_id":"SV-235746r960963","mitigation_control":"","comments":null,"classification":"Unclassified","rule_id_src":"SV-235746r960963_rule","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Enable AutoFill for addresses\" must be set to \"disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"AutofillAddressEnabled\" is not set to \"REG_DWORD = 0\", this is a finding.","ia_controls":"","group_tree":{"title":"SRG-APP-000141","id":"V-235746"},"reference_identifier":"5280","responsibility":"","third_party_tools":"","documentable":"false","weight":"10.0"},{"finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Enable Enable online OCSP/CRL checks)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:12500 (registry_test)\nResult                  : true\nTest Title              : Enable Enable online OCSP/CRL checks\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:12500 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'EnableOnlineRevocationChecks'\n\nState ID                : oval:mil.disa.stig.edge:ste:11 (registry_state)\nState Comment           : Reg_Dword type and value equals 1\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'EnableOnlineRevocationChecks'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","security_override_guidance":"","rule_title":"Online revocation checks must be performed.","mitigations":"","discussion":"If you enable this policy, Microsoft Edge will perform soft-fail, online OCSP/CRL checks. \"Soft fail\" means that if the revocation server can't be reached, the certificate will be considered valid.\n\nIf you disable the policy or don't configure it, Microsoft Edge won't perform online revocation checks.","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Enable online OCSP/CRL checks\" to \"Enabled\".","potential_impacts":"","group_id":"V-235747","false_positives":"","legacy_ids":[],"group_id_src":"V-235747","uuid":"88E176EA-6BF8-1014-9B15-D87FF9203442","check_content_ref":{"href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml","name":"oval:mil.disa.stig.edge:def:125"},"status":"not_a_finding","rule_id":"SV-235747r961038","mitigation_control":"","comments":null,"classification":"Unclassified","rule_id_src":"SV-235747r961038_rule","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Enable online OCSP/CRL checks\" must be set to \"Enabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"EnableOnlineRevocationChecks\" is not set to \"REG_DWORD = 1\", this is a finding.","ia_controls":"","group_tree":{"id":"V-235747","title":"SRG-APP-000175"},"reference_identifier":"5280","third_party_tools":"","responsibility":"","documentable":"false","weight":"10.0","rule_version":"EDGE-00-000030","ccis":["CCI-000185"],"severity":"medium","group_title":"SRG-APP-000175"},{"stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","security_override_guidance":"","rule_title":"Personalization of ads, search, and news by sending browsing history to Microsoft must be disabled.","discussion":"This policy prevents Microsoft from collecting a user's Microsoft Edge browsing history to be used for personalizing advertising, search, news and other Microsoft services.\n\nThis setting is only available for users with a Microsoft account. This setting is not available for child accounts or enterprise accounts.\n\nIf this policy is disabled, users cannot change or override the setting. If this policy is enabled or not configured, Microsoft Edge will default to the user's preference.","mitigations":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Disable personalization reporting)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:12600 (registry_test)\nResult                  : true\nTest Title              : Disable personalization reporting\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:12600 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'PersonalizationReportingEnabled'\n\nState ID                : oval:mil.disa.stig.edge:ste:10 (registry_state)\nState Comment           : Reg_Dword type and value equals 0\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'PersonalizationReportingEnabled'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","uuid":"88E17E85-6BF8-1014-B973-A7DFC980CF5F","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:126","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"status":"not_a_finding","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow personalization of ads, search and news by sending browsing history to Microsoft\" to \"disabled\".","potential_impacts":"","group_id":"V-235748","legacy_ids":[],"false_positives":"","group_id_src":"V-235748","responsibility":"","reference_identifier":"5280","third_party_tools":"","group_tree":{"title":"SRG-APP-000141","id":"V-235748"},"weight":"10.0","documentable":"false","mitigation_control":"","rule_id":"SV-235748r960963","comments":null,"classification":"Unclassified","ia_controls":"","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow personalization of ads, search and news by sending browsing history to Microsoft\" must be set to \"disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"PersonalizationReportingEnabled\" is not set to \"REG_DWORD = 0\", this is a finding.","rule_id_src":"SV-235748r960963_rule","ccis":["CCI-000381"],"group_title":"SRG-APP-000141","severity":"medium","rule_version":"EDGE-00-000031"},{"group_id_src":"V-235749","legacy_ids":[],"false_positives":"","group_id":"V-235749","potential_impacts":"","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Content settings/Default geolocation setting\" to \"enabled\" and select \"Don't allow any site to track users' physical location\".","status":"not_a_finding","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:127","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"uuid":"88E18525-6BF8-1014-B1B8-EE32836C254A","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Disable tracking user's location)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:12700 (registry_test)\nResult                  : true\nTest Title              : Disable tracking user's location\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:12700 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'DefaultGeolocationSetting'\n\nState ID                : oval:mil.disa.stig.edge:ste:12 (registry_state)\nState Comment           : Reg_Dword type and value equals 2\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '2'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'DefaultGeolocationSetting'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '2'\n                        : windows_view equals '64_bit'\n","discussion":"Set whether websites can track users' physical locations. Tracking can be allowed by default (\"AllowGeolocation\") or denied by default (\"BlockGeolocation\"), or the user can be asked each time a website requests their location (\"AskGeolocation\").\n\nIf this policy is not configured, \"AskGeolocation\" is used and the user can change it.\n\nPolicy options mapping:\n- AllowGeolocation (1) = Allow sites to track users' physical location.\n- BlockGeolocation (2) = Do not allow any site to track users' physical location.\n- AskGeolocation (3) = Ask whenever a site wants to track users' physical location.","mitigations":"","security_override_guidance":"","rule_title":"Site tracking of a userâs location must be disabled.","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","rule_version":"EDGE-00-000032","group_title":"SRG-APP-000141","severity":"medium","ccis":["CCI-000381"],"check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Content settings/Default geolocation setting\" must be set to \"enabled\" with the option value set to \"Don't allow any site to track users' physical location\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"DefaultGeolocationSetting\" is not set to \"REG_DWORD = 2\", this is a finding.","ia_controls":"","rule_id_src":"SV-235749r960963_rule","classification":"Unclassified","comments":null,"mitigation_control":"","rule_id":"SV-235749r960963","weight":"10.0","documentable":"false","responsibility":"","reference_identifier":"5280","third_party_tools":"","group_tree":{"id":"V-235749","title":"SRG-APP-000141"}},{"mitigation_control":"","rule_id":"SV-235750r960864","classification":"Unclassified","comments":null,"check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Enable deleting browser and download history\" must be set to \"disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"AllowDeletingBrowserHistory\" is not set to \"REG_DWORD = 0\", this is a finding.","ia_controls":"","rule_id_src":"SV-235750r960864_rule","reference_identifier":"5280","third_party_tools":"","responsibility":"","group_tree":{"title":"SRG-APP-000080","id":"V-235750"},"weight":"10.0","documentable":"false","rule_version":"EDGE-00-000033","ccis":["CCI-000166"],"group_title":"SRG-APP-000080","severity":"medium","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Check to make sure that Microsoft Edge is set to not allow deletion of browser history.)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:12800 (registry_test)\nResult                  : true\nTest Title              : Check to make sure that Microsoft Edge is set to not allow deletion of browser history.\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:12800 (registry_object)\nObject Comment          : Edge Allow Deletion of browser history gpo setting reg entry.\nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'AllowDeletingBrowserHistory'\n\nState ID                : oval:mil.disa.stig.edge:ste:10 (registry_state)\nState Comment           : Reg_Dword type and value equals 0\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Edge'\n                        : name equals 'AllowDeletingBrowserHistory'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","security_override_guidance":"","rule_title":"Browser history must be saved.","discussion":"This setting disables deleting browser history and download history and prevents users from changing this setting.","mitigations":"","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Enable deleting browser and download history\" to \"disabled\".","group_id":"V-235750","potential_impacts":"","legacy_ids":[],"false_positives":"","group_id_src":"V-235750","uuid":"88E18B87-6BF8-1014-BC79-BE6E84E0FDD3","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:128","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"status":"not_a_finding"},{"uuid":"88E191A4-6BF8-1014-B874-DC3BC24313F8","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:129","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"status":"not_a_finding","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Control where developer tools can be used\" to \"enabled\" and select \"Don't allow using the developer tools\".","potential_impacts":"","group_id":"V-235751","false_positives":"","legacy_ids":[],"group_id_src":"V-235751","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","security_override_guidance":"","rule_title":"Edge development tools must be disabled.","discussion":"While the risk associated with browser development tools is more related to the proper design of a web application, a risk vector remains within the browser. The developer tools allow end users and application developers to view and edit all types of web application-related data via the browser. Page elements, source code, javascript, API calls, application data, etc., may all be viewed and potentially manipulated. Manipulation could be useful for troubleshooting legitimate issues, and this may be performed in a development environment. Manipulation could also be malicious and must be addressed.","mitigations":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Edge Developer Tools Availability must be disallowed.)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:12900 (registry_test)\nResult                  : true\nTest Title              : Edge Developer Tools Availability must be disallowed.\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:12900 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'DeveloperToolsAvailability'\n\nState ID                : oval:mil.disa.stig.edge:ste:12 (registry_state)\nState Comment           : Reg_Dword type and value equals 2\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '2'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Edge'\n                        : name equals 'DeveloperToolsAvailability'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '2'\n                        : windows_view equals '64_bit'\n","ccis":["CCI-000381"],"group_title":"SRG-APP-000141","severity":"low","rule_version":"EDGE-00-000034","responsibility":"","reference_identifier":"5280","third_party_tools":"","group_tree":{"id":"V-235751","title":"SRG-APP-000141"},"weight":"10.0","documentable":"false","mitigation_control":"","rule_id":"SV-235751r960963","comments":null,"classification":"Unclassified","ia_controls":"","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Control where developer tools can be used\" with the option value set to \"Don't allow using the developer tools\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"DeveloperToolsAvailability\" is not set to \"REG_DWORD = 2\", this is a finding.","rule_id_src":"SV-235751r960963_rule"},{"status":"not_a_finding","uuid":"88E1980F-6BF8-1014-8AFE-E05C609863B6","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:130","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"group_id":"V-235752","potential_impacts":"","legacy_ids":[],"false_positives":"","group_id_src":"V-235752","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow download restrictions\" to \"Enabled\" and select one of the following: \"BlockDangerousDownloads\", \"Block potentially dangerous or unwanted downloads\", \"BlockAllDownloads\", or \"BlockMaliciousDownloads\".","security_override_guidance":"","rule_title":"Download restrictions must be configured.","mitigations":"","discussion":"This configures the type of downloads that Microsoft Edge completely blocks without allowing users to override the security decision.\n\nSet \"BlockDangerousDownloads\" to allow all downloads except those that carry Microsoft Defender SmartScreen warnings of known dangerous downloads or that have dangerous file type extensions.\n\nSet \"BlockPotentiallyDangerousDownloads\" to allow all downloads except those that carry Microsoft Defender SmartScreen warnings of potentially dangerous or unwanted downloads or that have dangerous file type extensions.\n\nSet \"BlockAllDownloads\" to block all downloads.\n\nSet \"BlockMaliciousDownloads\" to allow all downloads except those that carry Microsoft Defender SmartScreen warnings of known malicious downloads.\n\nIf this policy is not configured or the \"DefaultDownloadSecurity\" option is not set, the downloads go through the usual security restrictions based on Microsoft Defender SmartScreen analysis results.\n\nPolicy options mapping:\n\nDefaultDownloadSecurity (0) = No special restrictions\n\nBlockDangerousDownloads (1) = Block malicious downloads and dangerous file types\n\nBlockPotentiallyDangerousDownloads (2) = Block potentially dangerous or unwanted downloads and dangerous file types\n\nBlockAllDownloads (3) = Block all downloads\n\nBlockMaliciousDownloads (4) = Block malicious downloads","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Download restrictions are configured)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:13000 (registry_test)\nResult                  : true\nTest Title              : Download restrictions are configured\nCheck Existence         : One or more collected items must exist.\nCheck                   : At least one collected item must match the given state(s).\nState Operator          : One or more item-state comparisons may be true.\n\nObject ID               : oval:mil.disa.stig.edge:obj:13000 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'DownloadRestrictions'\n\nState ID                : oval:mil.disa.stig.win:ste:20000001 (registry_state)\nState Comment           : \nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nState ID                : oval:mil.disa.stig.win:ste:20000002 (registry_state)\nState Comment           : \nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '2'\n\nState ID                : oval:mil.disa.stig.win:ste:20000003 (registry_state)\nState Comment           : \nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '3'\n\nState ID                : oval:mil.disa.stig.win:ste:20000004 (registry_state)\nState Comment           : Reg_Dword type and value equals 4\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '4'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Edge'\n                        : name equals 'DownloadRestrictions'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","severity":"low","group_title":"SRG-APP-000141","ccis":["CCI-000381"],"rule_version":"EDGE-00-000036","documentable":"false","weight":"10.0","group_tree":{"id":"V-235752","title":"SRG-APP-000141"},"reference_identifier":"5280","third_party_tools":"","responsibility":"","rule_id_src":"SV-235752r1156563_rule","ia_controls":"","check_content":"If this machine is on SIPRNet, this is Not Applicable.\n\nThe policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow download restrictions\" must be set to \"Enabled\" with the option value set to \"BlockDangerousDownloads\", \"Block potentially dangerous or unwanted downloads\", or \"BlockMaliciousDownloads\". The more restrictive option, \"Block all downloads\", is also acceptable.\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"DownloadRestrictions\" is set to \"REG_DWORD = 0\", this is a finding.","rule_id":"SV-235752r1156563","mitigation_control":"","comments":null,"classification":"Unclassified"},{"rule_version":"EDGE-00-000039","ccis":["CCI-003980","CCI-001812"],"severity":"low","group_title":"SRG-APP-000378","rule_id":"SV-235753r1015297","mitigation_control":"","comments":null,"classification":"Unclassified","rule_id_src":"SV-235753r1015297_rule","check_content":"This requirement for \"Allow pop-up windows on specific sites\" is not required; this is optional.\n\nThe policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Content settings/Allow pop-up windows on specific sites\" must be set to \"Enabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\n\"PopupsAllowedForUrls\" must be set as follows:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\\PopupsAllowedForUrls\\1 = mydomain.com\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\\PopupsAllowedForUrls\\2 = myagency.mil\n\nIf configured, the list of domains for which Microsoft Edge allows pop-ups may be allowlisted.","ia_controls":"","group_tree":{"id":"V-235753","title":"SRG-APP-000378"},"reference_identifier":"5280","responsibility":"","third_party_tools":"","documentable":"false","weight":"10.0","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Content settings/Allow pop-up windows on specific sites\" to \"Enabled\". A list of allowlisted URLs may be specified here.","potential_impacts":"","group_id":"V-235753","false_positives":"","legacy_ids":[],"group_id_src":"V-235753","uuid":"88E19E47-6BF8-1014-AE64-E2E729B3CB24","check_content_ref":{"name":"ocil:navy.navwar.niwcatlantic.scc.edge:questionnaire:6901","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-ocil.xml"},"status":"not_reviewed","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: notcheckedCriteria                : NOT_TESTED (All child tests must be true.)\nTest                    :   NOT_TESTED (CAT III, V-235753, SV-235753r1015297, SRG-APP-000378)\n","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","security_override_guidance":"","rule_title":"URLs must be allowlisted for plugin use if used.","mitigations":"","discussion":"Define a list of sites, based on URL patterns that can open pop-up windows."},{"status":"not_a_finding","uuid":"88E1A45D-6BF8-1014-A7D0-A3FFE9B9F58B","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:131","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"group_id":"V-235754","potential_impacts":"","false_positives":"","legacy_ids":[],"group_id_src":"V-235754","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Extensions/Control which extensions cannot be installed\" to \"Enabled\". A list of blocklisted extensions may then be specified.","security_override_guidance":"","rule_title":"Extensions installation must be blocklisted by default.","mitigations":"","discussion":"List specific extensions that users cannot install in Microsoft Edge. When this policy is deployed, any extensions on this list that were previously installed will be disabled, and the user will not be able to enable them. If an item is removed from the list of blocked extensions, the extension is automatically reenabled anywhere it was previously installed.\n\nUse \"*\" to block all extensions that are not explicitly listed in the allow list.\n\nIf this policy is not configured, users can install any extension in Microsoft Edge.","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Enable the setting 'Control which extensions cannot be installed')\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:13100 (registry_test)\nResult                  : true\nTest Title              : Enable the setting 'Control which extensions cannot be installed'\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:13100 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge\\ExtensionInstallBlocklist'\nObject Requirement      :  check =  'name' must be equal to '1'\n\nState ID                : oval:mil.disa.stig.edge:ste:13100 (registry_state)\nState Comment           : \nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_sz'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '*'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge\\ExtensionInstallBlocklist'\n                        : name equals '1'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_sz'\n                        : value equals '*'\n                        : windows_view equals '64_bit'\n","severity":"medium","group_title":"SRG-APP-000141","ccis":["CCI-000381"],"rule_version":"EDGE-00-000041","documentable":"false","weight":"10.0","group_tree":{"title":"SRG-APP-000141","id":"V-235754"},"reference_identifier":"5280","third_party_tools":"","responsibility":"","rule_id_src":"SV-235754r960963_rule","ia_controls":"","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Extensions/Control which extensions cannot be installed\" must be set to \"Enabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\\ExtensionInstallBlocklist\\1\n\nIf the value for \"1\" is not set to \"REG_SZ = *\", this is a finding.","rule_id":"SV-235754r960963","mitigation_control":"","classification":"Unclassified","comments":null},{"status":"not_reviewed","check_content_ref":{"name":"ocil:navy.navwar.niwcatlantic.scc.edge:questionnaire:7301","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-ocil.xml"},"uuid":"88E1AA69-6BF8-1014-B29D-CA0108D2FBBE","legacy_ids":[],"false_positives":"","group_id_src":"V-235755","group_id":"V-235755","potential_impacts":"","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Extensions/Allow specific extensions to be installed\" to \"Enabled\".  A list of allowlisted extensions may then be specified.","discussion":"By default, all extensions are allowed. However, if all extensions are blocked by setting the \"ExtensionInstallBlockList\" policy to \"*,\" users can only install extensions defined in this policy.","mitigations":"","security_override_guidance":"","rule_title":"Extensions that are approved for use must be allowlisted if used.","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: notcheckedCriteria                : NOT_TESTED (All child tests must be true.)\nTest                    :   NOT_TESTED (CAT III, V-235755, SV-235755r961479, SRG-APP-000386)\n","group_title":"SRG-APP-000386","severity":"low","ccis":["CCI-001774"],"rule_version":"EDGE-00-000042","weight":"10.0","documentable":"false","third_party_tools":"","reference_identifier":"5280","responsibility":"","group_tree":{"title":"SRG-APP-000386","id":"V-235755"},"check_content":"This requirement for \"Allow specific extensions to be installed\" is not required; this is optional.\n\nThe policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Extensions/Allow specific extensions to be installed\" must be set to \"Enabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\n\"ExtensionInstallAllowlist\" must be set as follows:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\\ExtensionInstallAllowlist\\1 = \"extension_id1\"\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\\ExtensionInstallAllowlist\\2 = \"extension_id2\"\n\nIf configured, the list of extensions for which Microsoft Edge allows to be installed may be allowlisted.","ia_controls":"","rule_id_src":"SV-235755r961479_rule","classification":"Unclassified","comments":null,"mitigation_control":"","rule_id":"SV-235755r961479"},{"finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Disable Microsoft Edge Password Manager)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:13200 (registry_test)\nResult                  : true\nTest Title              : Disable Microsoft Edge Password Manager\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:13200 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'PasswordManagerEnabled'\n\nState ID                : oval:mil.disa.stig.edge:ste:10 (registry_state)\nState Comment           : Reg_Dword type and value equals 0\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'PasswordManagerEnabled'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","rule_title":"The Password Manager must be disabled.","security_override_guidance":"","discussion":"Enable Microsoft Edge to save user passwords.\n\nIf this policy is enabled, users can save their passwords in Microsoft Edge. The next time the user visits the site, Microsoft Edge will enter the password automatically.","mitigations":"","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","potential_impacts":"","group_id":"V-235756","legacy_ids":[],"false_positives":"","group_id_src":"V-235756","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Password manager and protection/Enable saving passwords to the password manager\" to \"disabled\".","status":"not_a_finding","uuid":"88E1B066-6BF8-1014-8735-E3570068F198","check_content_ref":{"href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml","name":"oval:mil.disa.stig.edge:def:132"},"check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Password manager and protection/Enable saving passwords to the password manager\" must be set to \"disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"PasswordManagerEnabled\" is not set to \"REG_DWORD = 0\", this is a finding.","ia_controls":"","rule_id_src":"SV-235756r961521_rule","mitigation_control":"","rule_id":"SV-235756r961521","comments":null,"classification":"Unclassified","weight":"10.0","documentable":"false","reference_identifier":"5280","responsibility":"","third_party_tools":"","group_tree":{"title":"SRG-APP-000400","id":"V-235756"},"rule_version":"EDGE-00-000043","group_title":"SRG-APP-000400","severity":"medium","ccis":["CCI-002007"]},{"comments":null,"classification":"Unclassified","mitigation_control":"","rule_id":"SV-235758r1117151","check_content":"Cross-reference the build information displayed with the Microsoft Edge site to identify, at minimum, the oldest supported build available. \n\nIf the installed version of Edge is not supported by Microsoft, this is a finding.","ia_controls":"","rule_id_src":"SV-235758r1117151_rule","reference_identifier":"5280","responsibility":"","third_party_tools":"","group_tree":{"title":"SRG-APP-000456","id":"V-235758"},"weight":"10.0","documentable":"false","rule_version":"EDGE-00-000045","ccis":["CCI-002605"],"group_title":"SRG-APP-000456","severity":"high","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: notcheckedCriteria                : NOT_TESTED (All child tests must be true.)\nTest                    :   NOT_TESTED (CAT I, V-235758, SV-235758r1117151, SRG-APP-000456)\n","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","discussion":"Security flaws with software applications are discovered daily. Vendors are constantly updating and patching their products to address newly discovered security vulnerabilities. Organizations (including any contractor to the organization) are required to promptly install security-relevant software updates (e.g., patches, service packs, and hot fixes). Flaws discovered during security assessments, continuous monitoring, incident response activities, or information system error handling must also be addressed expeditiously. \n\nOrganization-defined time periods for updating security-relevant software may vary based on a variety of factors including, for example, the security category of the information system or the criticality of the update (i.e., severity of the vulnerability related to the discovered flaw). \n\nThis requirement will apply to software patch management solutions that are used to install patches across the enclave and also to applications themselves that are not part of that patch management solution. For example, many browsers today provide the capability to install their own patch software. Patch criticality, as well as system criticality will vary. Therefore, the tactical situations regarding the patch management process will also vary. This means that the time period used must be a configurable parameter. Time frames for application of security-relevant software updates may be dependent upon the Information Assurance Vulnerability Management (IAVM) process.\n\nThe application will be configured to check for and install security-relevant software updates within an identified time period from the availability of the update. The specific time period will be defined by an authoritative source (e.g., IAVM, CTOs, DTMs, and STIGs).","mitigations":"","security_override_guidance":"","rule_title":"The version of Microsoft Edge running on the system must be a supported version.","fix_text":"Install a supported version of Edge.","legacy_ids":[],"false_positives":"","group_id_src":"V-235758","group_id":"V-235758","potential_impacts":"","check_content_ref":{"name":"ocil:navy.navwar.niwcatlantic.scc.edge:questionnaire:7701","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-ocil.xml"},"uuid":"88E1B9C5-6BF8-1014-9BE4-CC95617A73D9","status":"not_reviewed"},{"rule_version":"EDGE-00-000047","ccis":["CCI-000381"],"group_title":"SRG-APP-000141","severity":"medium","mitigation_control":"","rule_id":"SV-235760r960963","comments":null,"classification":"Unclassified","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Enable site isolation for every site\" must be set to \"enabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"SitePerProcess\" is not set to \"REG_DWORD = 1\", this is a finding.","ia_controls":"","rule_id_src":"SV-235760r960963_rule","reference_identifier":"5280","responsibility":"","third_party_tools":"","group_tree":{"id":"V-235760","title":"SRG-APP-000141"},"weight":"10.0","documentable":"false","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Enable site isolation for every site\" to \"enabled\".","group_id":"V-235760","potential_impacts":"","legacy_ids":[],"group_id_src":"V-235760","false_positives":"","uuid":"88E1C1B2-6BF8-1014-9221-A158BEB7AF48","check_content_ref":{"href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml","name":"oval:mil.disa.stig.edge:def:135"},"status":"not_a_finding","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Enable the setting 'Enable site isolation for every site')\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:13500 (registry_test)\nResult                  : true\nTest Title              : Enable the setting 'Enable site isolation for every site'\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:13500 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'SitePerProcess'\n\nState ID                : oval:mil.disa.stig.edge:ste:11 (registry_state)\nState Comment           : Reg_Dword type and value equals 1\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'SitePerProcess'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","rule_title":"Site isolation for every site must be enabled.","security_override_guidance":"","discussion":"The \"SitePerProcess\" policy can be used to prevent users from opting out of the default behavior of isolating all sites. The \"IsolateOrigins\" policy can be used to isolate additional, finer-grained origins.\n\nEnabling this policy prevents users from opting out of the default behavior where each site runs in its own process.\n\nIf this policy is not disabled or configured, a user can opt out of site isolation (e.g., by using \"Disable site isolation\" entry in edge://flags.) Disabling the policy or not configuring the policy does not turn off Site Isolation.","mitigations":""},{"fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/HTTP authentication/Supported authentication schemes\" to \"ntlm,negotiate\".","false_positives":"","legacy_ids":[],"group_id_src":"V-235761","potential_impacts":"","group_id":"V-235761","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:136","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"uuid":"88E1C7C8-6BF8-1014-8F7B-CA43F2267411","status":"not_a_finding","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Enable the setting 'Supported authentication schemes')\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:13600 (registry_test)\nResult                  : true\nTest Title              : Enable the setting 'Supported authentication schemes'\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\nState Operator          : One or more item-state comparisons may be true.\n\nObject ID               : oval:mil.disa.stig.edge:obj:13600 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'AuthSchemes'\n\nState ID                : oval:mil.disa.stig.edge:ste:13600 (registry_state)\nState Comment           : \nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_sz'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to 'ntlm,negotiate'\n\nState ID                : oval:mil.disa.stig.edge:ste:13601 (registry_state)\nState Comment           : \nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_sz'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to 'negotiate,ntlm'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'AuthSchemes'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_sz'\n                        : value equals 'ntlm,negotiate'\n                        : windows_view equals '64_bit'\n","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","discussion":"This setting specifies which HTTP authentication schemes are supported.\n\nThe policy can be configured by using these values: \"basic\", \"digest\", \"ntlm\", and \"negotiate\". Separate multiple values with commas.\n\nIf this policy is not configured, all four schemes are used.","mitigations":"","security_override_guidance":"","rule_title":"Supported authentication schemes must be configured.","rule_version":"EDGE-00-000048","ccis":["CCI-000382"],"group_title":"SRG-APP-000142","severity":"medium","classification":"Unclassified","comments":null,"mitigation_control":"","rule_id":"SV-235761r1043177","ia_controls":"","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/HTTP authentication/Supported authentication schemes\" must be set to  \"ntlm,negotiate\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"AuthSchemes\" is not set to \"REG_SZ = ntlm,negotiate\", this is a finding.","rule_id_src":"SV-235761r1043177_rule","reference_identifier":"5280","third_party_tools":"","responsibility":"","group_tree":{"id":"V-235761","title":"SRG-APP-000142"},"weight":"10.0","documentable":"false"},{"rule_version":"EDGE-00-000050","group_title":"SRG-APP-000141","severity":"medium","ccis":["CCI-000381"],"ia_controls":"","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/SmartScreen settings/Configure Microsoft Defender SmartScreen\" must be set to \"Enabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"SmartScreenEnabled\" is not set to \"REG_DWORD = 1\", this is a finding.\n\nIf this machine is on SIPRNet, this is Not Applicable.","rule_id_src":"SV-235763r960963_rule","mitigation_control":"","rule_id":"SV-235763r960963","classification":"Unclassified","comments":null,"weight":"10.0","documentable":"false","reference_identifier":"5280","third_party_tools":"","responsibility":"","group_tree":{"title":"SRG-APP-000141","id":"V-235763"},"group_id":"V-235763","potential_impacts":"","false_positives":"","legacy_ids":[],"group_id_src":"V-235763","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/SmartScreen settings/Configure Microsoft Defender SmartScreen\" to \"Enabled\".","status":"not_a_finding","uuid":"88E1CE01-6BF8-1014-806B-C066689C11A2","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:138","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Microsoft Defender SmartScreen must be enabled.)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:13800 (registry_test)\nResult                  : true\nTest Title              : Microsoft Defender SmartScreen must be enabled.\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:13800 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'SmartScreenEnabled'\n\nState ID                : oval:mil.disa.stig.edge:ste:11 (registry_state)\nState Comment           : Reg_Dword type and value equals 1\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'SmartScreenEnabled'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","security_override_guidance":"","rule_title":"Microsoft Defender SmartScreen must be enabled.","discussion":"This policy setting configures Microsoft Defender SmartScreen, which provides warning messages to help protect  users from potential phishing scams and malicious software. By default, Microsoft Defender SmartScreen is turned on.\n\nIf this setting is enabled, Microsoft Defender SmartScreen is turned on.\n\nIf this setting is disabled, Microsoft Defender SmartScreen is turned off.\n\nIf this setting is not configured, users can choose whether to use Microsoft Defender SmartScreen.\n\nThis policy is available only on Windows instances that are joined to a Microsoft Active Directory domain, Windows 10 Pro or Enterprise instances that enrolled for device management, or macOS instances that are that are managed via MDM or joined to a domain via MCX.","mitigations":"","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13"},{"ccis":["CCI-000381"],"group_title":"SRG-APP-000141","severity":"medium","rule_version":"EDGE-00-000051","reference_identifier":"5280","third_party_tools":"","responsibility":"","group_tree":{"id":"V-235764","title":"SRG-APP-000141"},"weight":"10.0","documentable":"false","classification":"Unclassified","comments":null,"mitigation_control":"","rule_id":"SV-235764r960963","ia_controls":"","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/SmartScreen settings/Configure Microsoft Defender SmartScreen to block potentially unwanted apps\" must be set to \"Enabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for SmartScreenPuaEnabled is not set to \"REG_DWORD = 1\", this is a finding.\n\nIf this machine is on SIPRNet, this is Not Applicable.","rule_id_src":"SV-235764r960963_rule","check_content_ref":{"href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml","name":"oval:mil.disa.stig.edge:def:139"},"uuid":"88E1D3FC-6BF8-1014-9710-AA2008B3B555","status":"not_a_finding","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/SmartScreen settings/Configure Microsoft Defender SmartScreen to block potentially unwanted apps\" to \"Enabled\".","legacy_ids":[],"group_id_src":"V-235764","false_positives":"","group_id":"V-235764","potential_impacts":"","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","discussion":"This policy setting configures blocking for potentially unwanted apps with Microsoft Defender SmartScreen. Potentially unwanted app blocking with Microsoft Defender SmartScreen provides warning messages to help protect users from adware, coin miners, bundleware, and other low-reputation apps that are hosted by websites. Potentially unwanted app blocking with Microsoft Defender SmartScreen is turned off by default.\n\nIf this setting is enabled, potentially unwanted app blocking with Microsoft Defender SmartScreen is turned on.\n\nIf this setting is disabled, potentially unwanted app blocking with Microsoft Defender SmartScreen is turned off.\n\nIf this setting is not configured, users can choose whether to use potentially unwanted app blocking with Microsoft Defender SmartScreen.\n\nThis policy is available only on Windows instances that are joined to a Microsoft Active Directory domain, Windows 10 Pro or Enterprise instances that enrolled for device management, or macOS instances that are managed via MDM or joined to a domain via MCX.","mitigations":"","security_override_guidance":"","rule_title":"Microsoft Defender SmartScreen must be configured to block potentially unwanted apps.","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Microsoft Defender SmartScreen must be configured to block potentially unwanted apps.)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:13900 (registry_test)\nResult                  : true\nTest Title              : Microsoft Defender SmartScreen must be configured to block potentially unwanted apps.\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:13900 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'SmartScreenPuaEnabled'\n\nState ID                : oval:mil.disa.stig.edge:ste:11 (registry_state)\nState Comment           : Reg_Dword type and value equals 1\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'SmartScreenPuaEnabled'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n"},{"rule_version":"EDGE-00-000052","ccis":["CCI-000381"],"severity":"low","group_title":"SRG-APP-000141","classification":"Unclassified","comments":null,"rule_id":"SV-235765r960963","mitigation_control":"","rule_id_src":"SV-235765r960963_rule","ia_controls":"","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Ask where to save downloaded files\" must be set to \"enabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"PromptForDownloadLocation\" is not set to \"REG_DWORD = 1\", this is a finding.","group_tree":{"title":"SRG-APP-000141","id":"V-235765"},"reference_identifier":"5280","third_party_tools":"","responsibility":"","documentable":"false","weight":"10.0","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Ask where to save downloaded files\" to \"enabled\".","legacy_ids":[],"false_positives":"","group_id_src":"V-235765","group_id":"V-235765","potential_impacts":"","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:140","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"uuid":"88E1DA06-6BF8-1014-A973-832A74F0BD89","status":"not_a_finding","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Prompt for download location)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:14000 (registry_test)\nResult                  : true\nTest Title              : Prompt for download location\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:14000 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'PromptForDownloadLocation'\n\nState ID                : oval:mil.disa.stig.edge:ste:11 (registry_state)\nState Comment           : Reg_Dword type and value equals 1\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'PromptForDownloadLocation'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","mitigations":"","discussion":"This setting provides positive feedback before a download starts, limiting the possibility of inadvertent downloads without notifying the user.","rule_title":"The download location prompt must be configured.","security_override_guidance":""},{"mitigation_control":"","rule_id":"SV-235766r1051115","classification":"Unclassified","comments":null,"check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Block tracking of users' web-browsing activity\" must be set to \"Enabled\" with the option value set to \"Balanced\" or \"Strict\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"TrackingPrevention\" is not set to \"REG_DWORD = 2\" or \"REG_DWORD = 3\", this is a finding.","ia_controls":"","rule_id_src":"SV-235766r1051115_rule","reference_identifier":"5280","responsibility":"","third_party_tools":"","group_tree":{"title":"SRG-APP-000148","id":"V-235766"},"weight":"10.0","documentable":"false","rule_version":"EDGE-00-000054","ccis":["CCI-000388"],"group_title":"SRG-APP-000148","severity":"medium","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Tracking of browsing activity must be disabled.)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:14100 (registry_test)\nResult                  : true\nTest Title              : Tracking of browsing activity must be disabled.\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\nState Operator          : One or more item-state comparisons may be true.\n\nObject ID               : oval:mil.disa.stig.edge:obj:14100 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'TrackingPrevention'\n\nState ID                : oval:mil.disa.stig.edge:ste:12 (registry_state)\nState Comment           : Reg_Dword type and value equals 2\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '2'\n\nState ID                : oval:mil.disa.stig.edge:ste:14100 (registry_state)\nState Comment           : \nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '3'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'TrackingPrevention'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '2'\n                        : windows_view equals '64_bit'\n","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","rule_title":"Tracking of browsing activity must be disabled.","security_override_guidance":"","discussion":"The setting allows websites to be blocked from tracking users' web-browsing activity.\n\nIf this policy is disabled or is not configured, users can set their own level of tracking prevention.\n\nPolicy options mapping:\n- TrackingPreventionOff (0) = Off (no tracking prevention)\n- TrackingPreventionBasic (1) = Basic (blocks harmful trackers; content and ads will be personalized)\n- TrackingPreventionBalanced (2) = Balanced (blocks harmful trackers and trackers from sites user has not visited; content and ads will be less personalized)\n- TrackingPreventionStrict (3) = Strict (blocks harmful trackers and majority of trackers from all sites; content and ads will have minimal personalization; some parts of sites might not work)","mitigations":"","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Block tracking of users' web-browsing activity\" to \"Balanced\" or \"Strict\".","potential_impacts":"","group_id":"V-235766","legacy_ids":[],"group_id_src":"V-235766","false_positives":"","uuid":"88E1E28D-6BF8-1014-B745-AF1AF705D72E","check_content_ref":{"href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml","name":"oval:mil.disa.stig.edge:def:141"},"status":"not_a_finding"},{"finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Disable the setting 'Allow websites to query for available payment methods')\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:14200 (registry_test)\nResult                  : true\nTest Title              : Disable the setting 'Allow websites to query for available payment methods'\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:14200 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'PaymentMethodQueryEnabled'\n\nState ID                : oval:mil.disa.stig.edge:ste:10 (registry_state)\nState Comment           : Reg_Dword type and value equals 0\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'PaymentMethodQueryEnabled'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","rule_title":"A website's ability to query for payment methods must be disabled.","security_override_guidance":"","discussion":"This setting determines whether websites can check if the user has payment methods saved.\n\nIf this policy is disabled, websites that use \"PaymentRequest.canMakePayment\" or \"PaymentRequest.hasEnrolledInstrument\" API will be informed that no payment methods are available.\n\nIf this policy is enabled or is not set, websites can check to determine if the user has payment methods saved.","mitigations":"","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","group_id":"V-235767","potential_impacts":"","legacy_ids":[],"group_id_src":"V-235767","false_positives":"","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow websites to query for available payment methods\" to \"disabled\".","status":"not_a_finding","uuid":"88E1E8AB-6BF8-1014-A70C-DAE6F98947A1","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:142","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow websites to query for available payment methods\" must be set to \"disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for PaymentMethodQueryEnabled is not set to \"REG_DWORD = 0\", this is a finding.","ia_controls":"","rule_id_src":"SV-235767r960972_rule","mitigation_control":"","rule_id":"SV-235767r960972","classification":"Unclassified","comments":null,"weight":"10.0","documentable":"false","responsibility":"","reference_identifier":"5280","third_party_tools":"","group_tree":{"title":"SRG-APP-000149","id":"V-235767"},"rule_version":"EDGE-00-000055","group_title":"SRG-APP-000149","severity":"medium","ccis":["CCI-000381"]},{"reference_identifier":"5280","third_party_tools":"","responsibility":"","group_tree":{"title":"SRG-APP-000151","id":"V-235768"},"weight":"10.0","documentable":"false","mitigation_control":"","rule_id":"SV-235768r1015298","classification":"Unclassified","comments":null,"check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Suggest similar pages when a webpage can't be found\" must be set to \"Disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for AlternateErrorPagesEnabled is not set to \"REG_DWORD = 0\", this is a finding.","ia_controls":"","rule_id_src":"SV-235768r1015298_rule","ccis":["CCI-000381","CCI-000767"],"group_title":"SRG-APP-000151","severity":"medium","rule_version":"EDGE-00-000056","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","security_override_guidance":"","rule_title":"Suggestions of similar web pages in the event of a navigation error must be disabled.","discussion":"This setting allows Microsoft Edge to issue a connection to a web service to generate URL and search suggestions for connectivity issues such as DNS errors.\n\nIf this policy is enabled, a web service is used to generate URL and search suggestions for network errors.\n\nIf this policy is disabled, no calls to the web service are made and a standard error page is shown.\n\nIf this policy is not configured, Microsoft Edge respects the user preference that is set under Services at edge://settings/privacy. Specifically, there is a \"Suggest similar pages when a webpage can't be found\" toggle, which the user can switch on or off. \n\nNote that if this policy has been enabled (AlternateErrorPagesEnabled), the \"Suggest similar pages when a webpage can't be found setting\" is turned on, but the user cannot change the setting by using the toggle. \n\nIf this policy is disabled, the \"Suggest similar pages when a webpage can't be found\" setting is turned off, and the user cannot change the setting by using the toggle.","mitigations":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Suggestions of similar web pages in the event of a navigation error must be disabled.)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:14300 (registry_test)\nResult                  : true\nTest Title              : Suggestions of similar web pages in the event of a navigation error must be disabled.\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:14300 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'AlternateErrorPagesEnabled'\n\nState ID                : oval:mil.disa.stig.edge:ste:10 (registry_state)\nState Comment           : Reg_Dword type and value equals 0\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'AlternateErrorPagesEnabled'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","uuid":"88E1EEE8-6BF8-1014-9376-A68D12E31153","check_content_ref":{"href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml","name":"oval:mil.disa.stig.edge:def:143"},"status":"not_a_finding","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Suggest similar pages when a webpage can't be found\" to \"Disabled\".","potential_impacts":"","group_id":"V-235768","legacy_ids":[],"false_positives":"","group_id_src":"V-235768"},{"rule_version":"EDGE-00-000057","ccis":["CCI-000381"],"severity":"medium","group_title":"SRG-APP-000152","rule_id":"SV-235769r960981","mitigation_control":"","classification":"Unclassified","comments":null,"rule_id_src":"SV-235769r960981_rule","ia_controls":"","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow user feedback\" must be set to \"disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for UserFeedbackAllowed is not set to \"REG_DWORD = 0\", this is a finding.","group_tree":{"id":"V-235769","title":"SRG-APP-000152"},"reference_identifier":"5280","third_party_tools":"","responsibility":"","documentable":"false","weight":"10.0","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow user feedback\" to \"disabled\".","group_id":"V-235769","potential_impacts":"","false_positives":"","legacy_ids":[],"group_id_src":"V-235769","uuid":"88E1F4EC-6BF8-1014-84AA-F58B513A8D1A","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:144","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"status":"not_a_finding","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Disable the setting 'Allow user feedback')\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:14400 (registry_test)\nResult                  : true\nTest Title              : Disable the setting 'Allow user feedback'\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:14400 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'UserFeedbackAllowed'\n\nState ID                : oval:mil.disa.stig.edge:ste:10 (registry_state)\nState Comment           : Reg_Dword type and value equals 0\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'UserFeedbackAllowed'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","security_override_guidance":"","rule_title":"User feedback must be disabled.","mitigations":"","discussion":"Microsoft Edge uses the Edge Feedback feature (enabled by default) to allow users to send feedback, suggestions, or customer surveys and to report any issues with the browser. By default, users cannot disable (turn off) the Edge Feedback feature.\n\nIf this policy is enabled or not configured, users can invoke Edge Feedback.\n\nIf this policy is disabled, users cannot invoke Edge Feedback."},{"finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (The collections feature must be disabled.)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:14500 (registry_test)\nResult                  : true\nTest Title              : The collections feature must be disabled.\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:14500 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'EdgeCollectionsEnabled'\n\nState ID                : oval:mil.disa.stig.edge:ste:10 (registry_state)\nState Comment           : Reg_Dword type and value equals 0\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'EdgeCollectionsEnabled'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","discussion":"This setting allows users to access the Collections feature, where they can collect, organize, share, and export content more efficiently and with Office integration.\n\nIf this policy is enabled or not configured, users can access and use the Collections feature in Microsoft Edge.\n\nIf this policy is disabled, users cannot access and use Collections in Microsoft Edge.","mitigations":"","rule_title":"The collections feature must be disabled.","security_override_guidance":"","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","false_positives":"","legacy_ids":[],"group_id_src":"V-235770","group_id":"V-235770","potential_impacts":"","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Enable the Collections feature\" to \"Disabled\".","status":"not_a_finding","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:145","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"uuid":"88E1FB06-6BF8-1014-90A3-F7F20D2446AC","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Enable the Collections feature\" must be set to \"Disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"EdgeCollectionsEnabled\" is not set to \"REG_DWORD = 0\", this is a finding.","ia_controls":"","rule_id_src":"SV-235770r960984_rule","comments":null,"classification":"Unclassified","mitigation_control":"","rule_id":"SV-235770r960984","weight":"10.0","documentable":"false","responsibility":"","reference_identifier":"5280","third_party_tools":"","group_tree":{"title":"SRG-APP-000153","id":"V-235770"},"rule_version":"EDGE-00-000058","group_title":"SRG-APP-000153","severity":"medium","ccis":["CCI-000381"]},{"rule_version":"EDGE-00-000059","group_title":"SRG-APP-000141","severity":"medium","ccis":["CCI-000381"],"check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Configure the Share experience\" must be set to \"enabled\" with the option value set to \"Don't allow using the Share experience\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"ConfigureShare\" is not set to \"REG_DWORD = 1\", this is a finding.","ia_controls":"","rule_id_src":"SV-235771r960963_rule","comments":null,"classification":"Unclassified","mitigation_control":"","rule_id":"SV-235771r960963","weight":"10.0","documentable":"false","responsibility":"","reference_identifier":"5280","third_party_tools":"","group_tree":{"title":"SRG-APP-000141","id":"V-235771"},"false_positives":"","legacy_ids":[],"group_id_src":"V-235771","potential_impacts":"","group_id":"V-235771","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Configure the Share experience\" to \"Don't allow using the Share experience\".","status":"not_a_finding","check_content_ref":{"href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml","name":"oval:mil.disa.stig.edge:def:146"},"uuid":"88E20116-6BF8-1014-852D-E2D66DA75B8C","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Enable the setting 'Enable site isolation for every site')\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:14600 (registry_test)\nResult                  : true\nTest Title              : Enable the setting 'Enable site isolation for every site'\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:14600 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'ConfigureShare'\n\nState ID                : oval:mil.disa.stig.edge:ste:11 (registry_state)\nState Comment           : Reg_Dword type and value equals 1\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'ConfigureShare'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '1'\n                        : windows_view equals '64_bit'\n","discussion":"If this policy is set to \"ShareAllowed\" (the default), users will be able to access the Windows 10 Share experience from the Settings and More menu in Microsoft Edge to share with other apps on the system.\n\nIf this policy is set to \"ShareDisallowed\", users will not be able to access the Windows 10 Share experience. If the Share button is on the toolbar, it will also be hidden.\n\nPolicy options mapping:\n- ShareAllowed (0) = Allow using the Share experience.\n- ShareDisallowed (1) = Do not allow using the Share experience.","mitigations":"","security_override_guidance":"","rule_title":"The Share Experience feature must be disabled.","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13"},{"rule_version":"EDGE-00-000060","severity":"medium","group_title":"SRG-APP-000141","ccis":["CCI-000381"],"rule_id_src":"SV-235772r960963_rule","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Enable guest mode\" must be set to \"disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"BrowserGuestModeEnabled\" is not set to \"REG_DWORD = 0\", this is a finding.","ia_controls":"","rule_id":"SV-235772r960963","mitigation_control":"","classification":"Unclassified","comments":null,"documentable":"false","weight":"10.0","group_tree":{"title":"SRG-APP-000141","id":"V-235772"},"reference_identifier":"5280","third_party_tools":"","responsibility":"","group_id":"V-235772","potential_impacts":"","legacy_ids":[],"false_positives":"","group_id_src":"V-235772","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Enable guest mode\" to \"disabled\".","status":"not_a_finding","uuid":"88E209A9-6BF8-1014-B8A2-DC008B066FEC","check_content_ref":{"href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml","name":"oval:mil.disa.stig.edge:def:147"},"finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Disable Browser Guest Mode)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:14700 (registry_test)\nResult                  : true\nTest Title              : Disable Browser Guest Mode\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:14700 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'Software\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'BrowserGuestModeEnabled'\n\nState ID                : oval:mil.disa.stig.edge:ste:10 (registry_state)\nState Comment           : Reg_Dword type and value equals 0\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'Software\\Policies\\Microsoft\\Edge'\n                        : name equals 'BrowserGuestModeEnabled'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","rule_title":"Guest mode must be disabled.","security_override_guidance":"","mitigations":"","discussion":"Enabling Guest mode allows the use of guest profiles in Microsoft Edge. In a guest profile, the browser does not import browsing data from existing profiles, and it deletes browsing data when all guest profiles are closed.\n\nIf this policy is enabled or not configured, Microsoft Edge lets users browse in guest profiles.\n\nIf this policy is disabled, Microsoft Edge does not let users browse in guest profiles.","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13"},{"finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Relaunch notification must be required.)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:14800 (registry_test)\nResult                  : true\nTest Title              : Relaunch notification must be required.\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:14800 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'RelaunchNotification'\n\nState ID                : oval:mil.disa.stig.edge:ste:12 (registry_state)\nState Comment           : Reg_Dword type and value equals 2\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '2'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'RelaunchNotification'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '2'\n                        : windows_view equals '64_bit'\n","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","discussion":"Users must be required to restart the browser to finish installation of pending updates and prevent users from continually using an old/vulnerable browser version.","mitigations":"","security_override_guidance":"","rule_title":"Relaunch notification must be required.","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Notify a user that a browser restart is recommended or required for pending updates\" web-browsing activity to \"Required\".","false_positives":"","legacy_ids":[],"group_id_src":"V-235773","group_id":"V-235773","potential_impacts":"","check_content_ref":{"href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml","name":"oval:mil.disa.stig.edge:def:148"},"uuid":"88E21074-6BF8-1014-9BB6-8CE7973B2A5F","status":"not_a_finding","comments":null,"classification":"Unclassified","mitigation_control":"","rule_id":"SV-235773r960993","ia_controls":"","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Notify a user that a browser restart is recommended or required for pending updates\" must be set to \"Enabled\" with the option value set to \"Required\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"RelaunchNotification\" is not set to \"REG_DWORD = 2\", this is a finding.","rule_id_src":"SV-235773r960993_rule","third_party_tools":"","reference_identifier":"5280","responsibility":"","group_tree":{"title":"SRG-APP-000156","id":"V-235773"},"weight":"10.0","documentable":"false","rule_version":"EDGE-00-000061","ccis":["CCI-000381"],"group_title":"SRG-APP-000156","severity":"medium"},{"check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Use built-in DNS client\" must be set to \"disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"BuiltInDnsClientEnabled\" is not set to \"REG_DWORD = 0\", this is a finding.","ia_controls":"","rule_id_src":"SV-235774r1015299_rule","classification":"Unclassified","comments":null,"mitigation_control":"","rule_id":"SV-235774r1015299","weight":"10.0","documentable":"false","third_party_tools":"","reference_identifier":"5280","responsibility":"","group_tree":{"title":"SRG-APP-000157","id":"V-235774"},"rule_version":"EDGE-00-000062","group_title":"SRG-APP-000157","severity":"medium","ccis":["CCI-001941","CCI-001942"],"finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (Built in DNS client is disabled)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:14900 (registry_test)\nResult                  : true\nTest Title              : Built in DNS client is disabled\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:14900 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'BuiltInDnsClientEnabled'\n\nState ID                : oval:mil.disa.stig.edge:ste:10 (registry_state)\nState Comment           : Reg_Dword type and value equals 0\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'BuiltInDnsClientEnabled'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","discussion":"This setting controls whether to use the built-in DNS client.\n\nThis does not affect which DNS servers are used; it only controls the software stack that is used to communicate with them. For example, if the operating system is configured to use an enterprise DNS server, that same server would be used by the built-in DNS client. However, it is however possible that the built-in DNS client will address servers in different ways by using more modern DNS-related protocols such as DNS-over-TLS.\n\nIf this policy is enabled, the built-in DNS client is used if it is available.\n\nIf this policy is disabled, the client is never used.","mitigations":"","security_override_guidance":"","rule_title":"The built-in DNS client must be disabled.","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","legacy_ids":[],"false_positives":"","group_id_src":"V-235774","potential_impacts":"","group_id":"V-235774","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Use built-in DNS client\" to \"disabled\".","status":"not_a_finding","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:149","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"uuid":"88E2167D-6BF8-1014-A812-FF3C6376A579"},{"security_override_guidance":"","rule_title":"Use of the QUIC protocol must be disabled.","discussion":"QUIC is used by more than half of all connections from the Edge web browser to Google's servers, and this activity is undesirable in the DoD.\n\nIf you enable this policy or don't configure it, the QUIC protocol is allowed.\n\nIf you disable this policy, the QUIC protocol is blocked.","mitigations":"","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: passRule Result             : Pass\nCriteria                : true (All child tests must be true. (AND))\nTest                    :   true (QUIC protocol is disabled)\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:15000 (registry_test)\nResult                  : true\nTest Title              : QUIC protocol is disabled\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:15000 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'QuicAllowed'\n\nState ID                : oval:mil.disa.stig.edge:ste:10 (registry_state)\nState Comment           : Reg_Dword type and value equals 0\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nCollected Item/State Result : true\n                        : hive equals 'HKEY_LOCAL_MACHINE'\n                        : key equals 'SOFTWARE\\Policies\\Microsoft\\Edge'\n                        : name equals 'QuicAllowed'\n                        : last_write_time equals '134330995380000000'\n                        : type equals 'reg_dword'\n                        : value equals '0'\n                        : windows_view equals '64_bit'\n","status":"not_a_finding","uuid":"88E21C96-6BF8-1014-9867-D8364F9FF747","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:150","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"potential_impacts":"","group_id":"V-246736","legacy_ids":[],"false_positives":"","group_id_src":"V-246736","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow QUIC protocol\" to \"Disabled\".","weight":"10.0","documentable":"false","responsibility":"","reference_identifier":"5280","third_party_tools":"","group_tree":{"title":"SRG-APP-000141","id":"V-246736"},"ia_controls":"","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow QUIC protocol\" must be set to \"Disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"QuicAllowed\" is not set to \"REG_DWORD = 0\", this is a finding.","rule_id_src":"SV-246736r960963_rule","mitigation_control":"","rule_id":"SV-246736r960963","classification":"Unclassified","comments":null,"group_title":"SRG-APP-000141","severity":"medium","ccis":["CCI-000381"],"rule_version":"EDGE-00-000063"},{"reference_identifier":"5280","responsibility":"","third_party_tools":"","group_tree":{"id":"V-251694","title":"SRG-APP-000141"},"weight":"10.0","documentable":"false","mitigation_control":"","rule_id":"SV-251694r960963","comments":null,"classification":"Unclassified","ia_controls":"","check_content":"If this machine is on SIPRNet, this is Not Applicable.\n\nThis requirement for \"AutoplayAllowlist\" is not required; this is optional.\n\nThe policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow media autoplay on specific sites\" may be set to \"allow\" for allowlisted domains.\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nAutoplayAllowlist may be set as follows:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\\AutoplayAllowlist\\1 = mydomain.com\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\\AutoplayAllowlist\\2 = myagency.mil\n\nIf configured, the list of domains for which autoplay is allowed may be allowlisted.","rule_id_src":"SV-251694r960963_rule","ccis":["CCI-000381"],"group_title":"SRG-APP-000141","severity":"low","rule_version":"EDGE-00-000064","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","security_override_guidance":"","rule_title":"The list of domains media autoplay allows must be allowlisted if used.","discussion":"Define a list of sites, based on URL patterns, that are allowed to autoplay media.\n\nIf this policy is not configured, the global default value from the AutoplayAllowed policy (if set) or the user's personal configuration is used for all sites.\n\nEDGE-00-000024 disables the AutoplayAllowed policy. ","mitigations":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: notcheckedCriteria                : NOT_TESTED (All child tests must be true.)\nTest                    :   NOT_TESTED (CAT III, V-251694, SV-251694r960963, SRG-APP-000141)\n","uuid":"88E2261C-6BF8-1014-A49D-81EC5D8856D5","check_content_ref":{"name":"ocil:navy.navwar.niwcatlantic.scc.edge:questionnaire:10901","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-ocil.xml"},"status":"not_reviewed","fix_text":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Allow media autoplay on specific sites\" may be set to \"allow\" for allowlisted domains.","potential_impacts":"","group_id":"V-251694","false_positives":"","legacy_ids":[],"group_id_src":"V-251694"},{"weight":"10.0","documentable":"false","reference_identifier":"5280","responsibility":"","third_party_tools":"","group_tree":{"id":"V-260465","title":"SRG-APP-000141"},"check_content":"Verify the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Visual search enabled\" is set to \"Disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"VisualSearchEnabled\" is not set to \"REG_DWORD = 0\", this is a finding.","ia_controls":"","rule_id_src":"SV-260465r960963_rule","comments":null,"classification":"Unclassified","mitigation_control":"","rule_id":"SV-260465r960963","group_title":"SRG-APP-000141","severity":"medium","ccis":["CCI-000381"],"rule_version":"EDGE-00-000065","discussion":"Visual Search allows for quick exploration of more related content about entities in an image.\n\nIf this policy is enabled or not configured, Visual Search will be enabled via image hover, context menu, and search in Sidebar.\n\nIf this policy is disabled, Visual Search will be disabled and more information about images will not be available via hover, context menu, and search in Sidebar.","mitigations":"","security_override_guidance":"","rule_title":"Visual Search must be disabled.","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: failRule Result             : Fail\nCriteria                : false (All child tests must be true. (AND))\nTest                    :   false (Visual Search is disabled)\nResult Analysis         :        Registry Name Not found: 'HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Edge\\VisualSearchEnabled'.  Existence requirement is 'at_least_one_exists' and no items were collected, so result is false.\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:26046500 (registry_test)\nResult                  : false\nTest Title              : Visual Search is disabled\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:26046500 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'VisualSearchEnabled'\n\nState ID                : oval:mil.disa.stig.win:ste:20000000 (registry_state)\nState Comment           : \nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nResult Analysis         : Registry Name Not found: 'HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Edge\\VisualSearchEnabled'.  Existence requirement is 'at_least_one_exists' and no items were collected, so result is false.\n","status":"open","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:260465","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"uuid":"88E22CCC-6BF8-1014-900A-BE0DBFF4417E","legacy_ids":[],"group_id_src":"V-260465","false_positives":"","group_id":"V-260465","potential_impacts":"","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Visual search enabled\" to \"Disabled\"."},{"finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: failRule Result             : Fail\nCriteria                : false (All child tests must be true. (AND))\nTest                    :   false (Copilot is disabled)\nResult Analysis         :        Registry Name Not found: 'HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Edge\\HubsSidebarEnabled'.  Existence requirement is 'at_least_one_exists' and no items were collected, so result is false.\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:26046600 (registry_test)\nResult                  : false\nTest Title              : Copilot is disabled\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:26046600 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'HubsSidebarEnabled'\n\nState ID                : oval:mil.disa.stig.win:ste:20000000 (registry_state)\nState Comment           : \nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nResult Analysis         : Registry Name Not found: 'HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Edge\\HubsSidebarEnabled'.  Existence requirement is 'at_least_one_exists' and no items were collected, so result is false.\n","security_override_guidance":"","rule_title":"Copilot must be disabled.","mitigations":"","discussion":"The Sidebar is a launcher bar on the right side of Microsoft Edge's screen.\n\nIf this policy is enabled or not configured, the Sidebar will be shown. If this policy is disabled, the Sidebar will never be shown.\n\nDisabling Sidebar will disable Copilot.","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","group_id":"V-260466","potential_impacts":"","false_positives":"","legacy_ids":[],"group_id_src":"V-260466","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Show Hubs Sidebar\" to \"Disabled\".","status":"open","uuid":"88E232FA-6BF8-1014-A689-90A24A5FA7E0","check_content_ref":{"href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml","name":"oval:mil.disa.stig.edge:def:260466"},"rule_id_src":"SV-260466r960963_rule","check_content":"Verify the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Show Hubs Sidebar\" is set to \"Disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"HubsSidebarEnabled\" is not set to \"REG_DWORD = 0\", this is a finding.","ia_controls":"","rule_id":"SV-260466r960963","mitigation_control":"","classification":"Unclassified","comments":null,"documentable":"false","weight":"10.0","group_tree":{"title":"SRG-APP-000141","id":"V-260466"},"responsibility":"","reference_identifier":"5280","third_party_tools":"","rule_version":"EDGE-00-000066","severity":"medium","group_title":"SRG-APP-000141","ccis":["CCI-000381"]},{"severity":"medium","group_title":"SRG-APP-000080","ccis":["CCI-000166"],"rule_version":"EDGE-00-000067","documentable":"false","weight":"10.0","group_tree":{"id":"V-260467","title":"SRG-APP-000080"},"reference_identifier":"5280","responsibility":"","third_party_tools":"","rule_id_src":"SV-260467r960864_rule","check_content":"Verify the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Content settings/Configure cookies\" is set to \"Enabled\" with the option value set to \"Keep cookies for the duration of the session, except ones listed in 'SaveCookiesOnExit'\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for âDefaultCookiesSettingâ is not set to \"REG_DWORD = 4\", this is a finding.","ia_controls":"","rule_id":"SV-260467r960864","mitigation_control":"","classification":"Unclassified","comments":null,"status":"open","uuid":"88E238CC-6BF8-1014-BDE6-DC04E2C20AA4","check_content_ref":{"href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml","name":"oval:mil.disa.stig.edge:def:260467"},"group_id":"V-260467","potential_impacts":"","false_positives":"","legacy_ids":[],"group_id_src":"V-260467","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Content settings/Configure cookies\" to \"Enabled\" with the option value set to \"Keep cookies for the duration of the session, except ones listed in 'SaveCookiesOnExit'\".","security_override_guidance":"","rule_title":"Session only-based cookies must be enabled.","mitigations":"","discussion":"Cookies must only be allowed per session and only for approved URLs as permanently stored cookies can be used for malicious intent. \n\nApproved URLs may be allowlisted via the \"CookiesAllowedForUrls\" or \"SaveCookiesOnExit\" policy settings, but these are not requirements.","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: failRule Result             : Fail\nCriteria                : false (All child tests must be true. (AND))\nTest                    :   false (Session only-based cookies is enabled)\nResult Analysis         :        Registry Name Not found: 'HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Edge\\DefaultCookiesSetting'.  Existence requirement is 'at_least_one_exists' and no items were collected, so result is false.\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:26046700 (registry_test)\nResult                  : false\nTest Title              : Session only-based cookies is enabled\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:26046700 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'DefaultCookiesSetting'\n\nState ID                : oval:mil.disa.stig.win:ste:20000004 (registry_state)\nState Comment           : Reg_Dword type and value equals 4\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '4'\n\nResult Analysis         : Registry Name Not found: 'HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Edge\\DefaultCookiesSetting'.  Existence requirement is 'at_least_one_exists' and no items were collected, so result is false.\n"},{"discussion":"If FriendlyURLs are enabled, Microsoft Edge will compute additional representations of the URL and place them on the clipboard.\n\nThis policy configures what format will be pasted when the user pastes in external applications, or inside Microsoft Edge without the \"Paste As\" context menu item.\n\nIf configured, this policy makes a choice on behalf of the user. The options in edge://settings/shareCopyPaste will be grayed out, and the options in the \"Paste As\" context menu will not be available.\n\nNot configured = The user will be able to choose their preferred paste format. By default, this is set to the friendly URL format. The \"Paste As\" menu will be available in Microsoft Edge.\n\n1 = No additional formats will be stored on the clipboard. There will be no \"Paste as\" context menu item in Microsoft Edge and the only format available to paste will be the plain text URL format. Effectively, the friendly URL feature will be disabled.\n\n3 = The user will get a friendly URL whenever they paste into surfaces that accept rich text. The plain URL will still be available for non-rich surfaces. There will be no \"Paste As\" menu in Microsoft Edge.\n\n4 = (Not currently used)\n\nThe richer formats may not be well-supported in some paste destinations and/or websites. In these scenarios, the plain URL option is recommended when configuring this policy.\n\nThe recommended policy is available in Microsoft Edge 105 or later.\n\nPolicy options mapping:\n\nPlainText (1) = The plain URL without any extra information, such as the page's title. This is the recommended option when this policy is configured. For more information, see the description.\n\nTitledHyperlink (3) = Titled Hyperlink: A hyperlink that points to the copied URL, but whose visible text is the title of the destination page. This is the Friendly URL format.","mitigations":"","security_override_guidance":"","rule_title":"FriendlyURLs must be disabled.","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: failRule Result             : Fail\nCriteria                : false (All child tests must be true. (AND))\nTest                    :   false (FriendlyURLs is enabled)\nResult Analysis         :        Registry Name Not found: 'HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Edge\\ConfigureFriendlyURLFormat'.  Existence requirement is 'at_least_one_exists' and no items were collected, so result is false.\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:26698100 (registry_test)\nResult                  : false\nTest Title              : FriendlyURLs is enabled\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:26698100 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'ConfigureFriendlyURLFormat'\n\nState ID                : oval:mil.disa.stig.win:ste:20000001 (registry_state)\nState Comment           : \nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nResult Analysis         : Registry Name Not found: 'HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Edge\\ConfigureFriendlyURLFormat'.  Existence requirement is 'at_least_one_exists' and no items were collected, so result is false.\n","status":"open","check_content_ref":{"href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml","name":"oval:mil.disa.stig.edge:def:266981"},"uuid":"88E23EDA-6BF8-1014-B7B3-E005ABAE08D3","legacy_ids":[],"false_positives":"","group_id_src":"V-266981","potential_impacts":"","group_id":"V-266981","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft EdgeConfigure the default paste format of URLs copied from Microsoft Edge, and determine if additional formats will be available to users\" to \"enabled\" and select \"The plain URL without any extra information, such as the pageÂ´s title. This is the recommended option when this policy is configured. For more information, see the description.\"","weight":"10.0","documentable":"false","third_party_tools":"","reference_identifier":"5280","responsibility":"","group_tree":{"title":"SRG-APP-000141","id":"V-266981"},"check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Configure the default paste format of URLs copied from Microsoft Edge and determine if additional formats will be available to users\" must be set to \"enabled\" with the option value set to \"The plain URL without any extra information, such as the pageÂ´s title. This is the recommended option when this policy is configured. For more information, see the description.\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"ConfigureFriendlyURLFormat\" is not set to \"REG_DWORD = 1\", this is a finding.","ia_controls":"","rule_id_src":"SV-266981r1169858_rule","comments":null,"classification":"Unclassified","mitigation_control":"","rule_id":"SV-266981r1169858","group_title":"SRG-APP-000141","severity":"medium","ccis":["CCI-000381"],"rule_version":"EDGE-00-000068"},{"check_content_ref":{"href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml","name":"oval:mil.disa.stig.edge:def:279940"},"uuid":"88E244F7-6BF8-1014-9950-9A03015F8E9F","status":"open","fix_text":"Set the policy value for \"Control access to Microsoft 365 Copilot writing assistance in Microsoft Edge for Business\" to \"disabled\".","false_positives":"","legacy_ids":[],"group_id_src":"V-279940","potential_impacts":"","group_id":"V-279940","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","mitigations":"","discussion":"This policy controls whether users can use writing support features in Microsoft Edge for Business, such as Rewrite, which utilizes Microsoft 365 Copilot Chat.","rule_title":"Access to Microsoft 365 Copilot writing assistance must be disabled.","security_override_guidance":"","finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: failRule Result             : Fail\nCriteria                : false (All child tests must be true. (AND))\nTest                    :   false (Access to Microsoft 365 Copilot writing assistance is disabled)\nResult Analysis         :        Registry Name Not found: 'HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Edge\\ComposeInlineEnabled'.  Existence requirement is 'at_least_one_exists' and no items were collected, so result is false.\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:27994000 (registry_test)\nResult                  : false\nTest Title              : Access to Microsoft 365 Copilot writing assistance is disabled\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:27994000 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal to 'ComposeInlineEnabled'\n\nState ID                : oval:mil.disa.stig.win:ste:20000000 (registry_state)\nState Comment           : \nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nResult Analysis         : Registry Name Not found: 'HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Edge\\ComposeInlineEnabled'.  Existence requirement is 'at_least_one_exists' and no items were collected, so result is false.\n","ccis":["CCI-000381"],"severity":"medium","group_title":"SRG-APP-000141","rule_version":"EDGE-00-000069","group_tree":{"title":"SRG-APP-000141","id":"V-279940"},"reference_identifier":"5280","responsibility":"","third_party_tools":"","documentable":"false","weight":"10.0","classification":"Unclassified","comments":null,"rule_id":"SV-279940r1156561","mitigation_control":"","rule_id_src":"SV-279940r1156561_rule","ia_controls":"","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Control access to Microsoft 365 Copilot writing assistance in Microsoft Edge for Business\" must be set to \"disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for \"ComposeInlineEnabled\" is not set to \"REG_DWORD = 0\", this is a finding."},{"finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T13:09:53\nResult: failRule Result             : Fail\nCriteria                : false (All child tests must be true. (AND))\nTest                    :   false (Spell checking provided by Microsoft Editor is disabled)\nResult Analysis         :        Registry Name Not found: 'HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Edge\\MicrosoftEditorProofingEnabled'.  Existence requirement is 'at_least_one_exists' and no items were collected, so result is false.\n\n---\n\nTest ID                 : oval:mil.disa.stig.edge:tst:28343900 (registry_test)\nResult                  : false\nTest Title              : Spell checking provided by Microsoft Editor is disabled\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.edge:obj:28343900 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal (case insensitive) to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal (case insensitive) to 'SOFTWARE\\Policies\\Microsoft\\Edge'\nObject Requirement      :  check =  'name' must be equal (case insensitive) to 'MicrosoftEditorProofingEnabled'\n\nState ID                : oval:mil.disa.stig.win:ste:20000000 (registry_state)\nState Comment           : \nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '0'\n\nResult Analysis         : Registry Name Not found: 'HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Edge\\MicrosoftEditorProofingEnabled'.  Existence requirement is 'at_least_one_exists' and no items were collected, so result is false.\n","stig_uuid":"88DD52C8-6BF8-1014-BE64-C3AC2D3D7E13","mitigations":"","discussion":"The Microsoft Editor service provides enhanced spell and grammar checking for editable text fields on web pages.\n\nIf this policy is enabled or incorrectly configured, Microsoft Editor spell check can be used for eligible text fields.\n\nIf you disable this policy, spell check can only be provided by local engines that use platform or Hunspell services. The results from these engines might be less informative than the results Microsoft Editor can provide.","security_override_guidance":"","rule_title":"Spell checking provided by Microsoft Editor must be disabled.","fix_text":"Set the policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Spell checking provided by Microsoft Editor\" to \"Disabled\".","group_id_src":"V-283439","legacy_ids":[],"false_positives":"","potential_impacts":"","group_id":"V-283439","check_content_ref":{"name":"oval:mil.disa.stig.edge:def:283439","href":"U_MS_Edge_V2R5_STIG_SCAP_1-4_Benchmark-enhancedV15-oval.xml"},"uuid":"88E24AC7-6BF8-1014-9B5D-D9B51ADE2A78","status":"open","comments":null,"classification":"Unclassified","rule_id":"SV-283439r1192850","mitigation_control":"","rule_id_src":"SV-283439r1192850_rule","ia_controls":"","check_content":"The policy value for \"Computer Configuration/Administrative Templates/Microsoft Edge/Spell checking provided by Microsoft Editor\" must be set to \"Disabled\".\n\nUse the Windows Registry Editor to navigate to the following key:\n\nHKLM\\SOFTWARE\\Policies\\Microsoft\\Edge\n\nIf the value for MicrosoftEditorProofingEnabled is not set to \"REG_DWORD = 0\", this is a finding.","group_tree":{"id":"V-283439","title":"SRG-APP-000141"},"responsibility":"","reference_identifier":"5280","third_party_tools":"","documentable":"false","weight":"10.0","rule_version":"EDGE-00-000070","ccis":["CCI-000381"],"severity":"medium","group_title":"SRG-APP-000141"}],"version":"2","release_info":"Release: 5 Benchmark Date: 01 Apr 2026","display_name":"Microsoft Edge"}],"target_data":{"mac_address":"00:0C:29:03:21:20","host_name":"WKS1-SOTERIA","fqdn":"WKS1-SOTERIA.","target_type":"Computing","ip_address":"192.168.40.91","role":"Workstation"}}