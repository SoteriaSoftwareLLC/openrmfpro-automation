et to â1â and Type is not configured to REG_DWORD or does not exist, this is a finding.\n\nAdmin Template path: User Configuration &gt; Administrative Templates &gt; Adobe Acrobat Pro DC Continuous &gt; Preferences &gt; 'Enable FIPS' must be set to 'Enabled'.\n","rule_id_src":"SV-245874r766580_rule","classification":"Unclassified","comments":null,"mitigation_control":"","rule_id":"SV-245874r766580","weight":"10.0","documentable":"false","reference_identifier":"3973","third_party_tools":"","responsibility":"","group_tree":{"title":"SRG-APP-000416","id":"V-245874"}}],"stig_id":"Adobe_Acrobat_Pro_DC_Continuous_STIG","classification":"UNCLASSIFIED","size":23,"reference_identifier":"3973","uuid":"73F1BA0E-6BF7-1014-A52E-8A2F3B1AC19C","stig_name":"Adobe Acrobat Professional DC Continuous Track Security Technical Implementation Guide"}],"id":"73F5F939-6BF7-1014-828A-9960FDD15659","title":"SCC Generated CKLB at: 2026-09-05T13:02:14","target_data":{"mac_address":"00:0C:29:03:21:20","host_name":"WKS1-SOTERIA","fqdn":"WKS1-SOTERIA.","target_type":"Computing","ip_address":"192.168.40.91","role":"Workstation"}}