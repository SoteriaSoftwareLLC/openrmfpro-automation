8-1014-890D-C12B2755253C","rule_id_src":"SV-278668r1190756_rule","rule_version":"WNDF-AV-000064","ia_controls":""},{"group_id_src":"V-278669","severity":"medium","security_override_guidance":"","legacy_ids":[],"mitigations":"","classification":"Unclassified","reference_identifier":"3985","discussion":"Always-on protection consists of real-time protection, behavior monitoring, and heuristics to identify malware based on known suspicious and malicious activities. These activities include events, such as processes making unusual changes to existing files, modifying or creating automatic startup registry keys and startup locations (also known as autostart extensibility points, or ASEPs), and other changes to the file system or file structure.","rule_id_src":"SV-278669r1190758_rule","rule_version":"WNDF-AV-000065","ia_controls":"","stig_uuid":"94765B2D-6BF8-1014-890D-C12B2755253C","potential_impacts":"","group_title":"SRG-APP-000278","responsibility":"","uuid":"947C9CE8-6BF8-1014-94C6-F1641AE58AE0","weight":"10.0","rule_id":"SV-278669r1190758","fix_text":"Set the policy value for Computer Configuration &gt;&gt; Administrative Templates &gt;&gt; Windows Components &gt;&gt; Microsoft Defender Antivirus &gt;&gt; Real-time Protection &gt;&gt; Configure real-time protection and Security Intelligence Updates during OOBE to \"Enabled\".","documentable":"false","third_party_tools":"","false_positives":"","status":"open","comments":null,"rule_title":"Microsoft Defender AV must enable real-time protection and Security Intelligence Updates during OOBE.","mitigation_control":"","check_content":"Verify the policy value for Computer Configuration &gt;&gt; Administrative Templates &gt;&gt; Windows Components &gt;&gt; Microsoft Defender Antivirus &gt;&gt; Real-time Protection &gt;&gt; Configure real-time protection and Security Intelligence Updates during OOBE is set to \"Enabled\"; otherwise, this is a finding.\n\nProcedure: Use the Windows Registry Editor to navigate to the following key: \nHKLM\\Software\\Policies\\Microsoft\\Windows Defender\\Real-Time Protection\n\nCriteria: If the value \"OobeEnableRtpAndSigUpdate\" is REG_DWORD = 1, this is not a finding.\n\nIf the value is 0, this is a finding.","ccis":["CCI-002624"],"group_tree":{"id":"V-278669","title":"SRG-APP-000278"},"finding_details":"Tool: cpe:/a:niwc:scc:5.14.1\nTime         : 2026-09-05T10:13:22\nResult: failRule Result             : Fail\nCriteria                : false (All child tests must be true. (AND))\nTest                    :   false (Configure real-time protection and Security Intelligence Updates during OOBE' is 'Enabled')\nResult Analysis         :        Registry Name Not found: 'HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Real-Time Protection\\OobeEnableRtpAndSigUpdate'.  Existence requirement is 'at_least_one_exists' and no items were collected, so result is false.\n\n---\n\nTest ID                 : oval:mil.disa.stig.win:tst:27866900 (registry_test)\nResult                  : false\nTest Title              : Configure real-time protection and Security Intelligence Updates during OOBE' is 'Enabled'\nCheck Existence         : One or more collected items must exist.\nCheck                   : All collected items must match the given state(s).\n\nObject ID               : oval:mil.disa.stig.win:obj:27866900 (registry_object)\nObject Comment          : \nObject Requirement      :  check =  'hive' must be equal (case insensitive) to 'HKEY_LOCAL_MACHINE'\nObject Requirement      :  check =  'key' must be equal (case insensitive) to 'SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Real-Time Protection'\nObject Requirement      :  check =  'name' must be equal (case insensitive) to 'OobeEnableRtpAndSigUpdate'\n\nState ID                : oval:mil.disa.stig.win:ste:20000001 (registry_state)\nState Comment           : \nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'type' must be equal to 'reg_dword'\nState Requirement       : check_existence = 'at_least_one_exists',  check = all 'value' must be equal to '1'\n\nResult Analysis         : Registry Name Not found: 'HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Real-Time Protection\\OobeEnableRtpAndSigUpdate'.  Existence requirement is 'at_least_one_exists' and no items were collected, so result is false.\n","check_content_ref":{"name":"oval:mil.disa.stig.windowsdefav:def:278669","href":"U_MS_Defender_Antivirus_V2R8_STIG_SCAP_1-4_Benchmark-enhancedV14-oval.xml"},"group_id":"V-278669"},{"status":"open","false_positives":"","third_party_tools":"","documentable":"false","fix_text":"Set the policy value for Computer Configuration &gt;&gt; Administrative Templates &gt;&gt; Windows Components &gt;&gt; Microsoft Defender Antivirus &gt;&gt; Microsoft Defender Exploit Guard &gt;&gt; Network Protection &gt;&gt; This settings controls whether Network Protection is allowed to be configured into block or audit mode on Windows Server to \"Enabled\".","mitigation_control":"","rule_title":"Microsoft Defender AV must enable network protection to be configured into block or audit mode on Windows Server.","comments":null,"group_tree":{"id":"V-278672","title":"SRG-APP-000210"},"check_content":"Note: This requirement is not applicable to desktops.\n\nVerify the policy value for Computer Configuration &gt;&gt; Administrative Templates &gt;&gt; Windows Components &gt;&gt; Microsoft Defender Antivirus &gt;&gt; Microsoft Defender Exploit Guard &gt;&gt; Network Protection &gt;&gt; This settings controls whether Network Protection is allowed to be configured into block or audit mode on Windows Server is set to \"Enabled\".\n\nProcedure: Use the Windows Registry Editor to navigate to the following key: \nHKLM\\Software\\Policies\\Microsoft\\Windows Defender\\Windows Defender Exploit Guard\\Network Protection\n\nCriteria: If the value \"AllowNetworkProtectionOnWinServer\" is REG_DWORD = 1, this is not a finding.\n\nIf the value is 0, th