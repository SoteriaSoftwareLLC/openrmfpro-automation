D-A40CE0EC7705"},{"reference_identifier":"3985","discussion":"This policy setting configures how locally defined lists are combined or merged with globally defined lists. This setting applies to exclusion lists, specified remediation lists, and attack surface reduction.","classification":"Unclassified","mitigations":"","legacy_ids":[],"security_override_guidance":"","severity":"medium","group_id_src":"V-278656","stig_uuid":"94765B2D-6BF8-1014-890D-C12B2755253C","potential_impacts":"","rule_version":"WNDF-AV-000052","ia_controls":"","rule_id_src":"SV-278656r1190744_rule","uuid":"947C7DC0-6BF8-1014-ACCD-E1D8C070BF0D","responsibility":"","group_title":"SRG-APP-000210","weight":"10.0","rule_id":"SV-278656r1190744","status":"open","false_positives":"","third_party_tools":"","fix_text":"Set the policy value for Computer Configuration &gt;&gt; Administrative Templates &gt;&gt; Windows Components &gt;&gt; Microsoft Defender Antivirus &gt;&gt; Configure local administrator merge behavior for lists to \"Enabled\".","documentable":"false","rule_title":"Microsoft Defender AV must configure local administrator merge behavior for lists.","mitigation_control":"","comments":null,"group_tree":{"title":"SRG-APP-000210","id":"V-278656"},"check_content":"Verify the policy value for Computer Configuration &gt;&gt; Administrative Templates &gt;&gt; Windows Components &gt;&gt; Microsoft Defender Antivirus &gt;&gt; Configure local administrator merge behavior for lists is set to \"Enabled\". Otherwise, this is a finding.\n\nProcedure: Use the Windows Registry Editor to navigate to the following key: \nHKLM\\Software\\Policies\\Microsoft\\Windows Defender\n\nCriteria: If the value \"DisableLocalAdminMerge\" is REG_DWORD = 1, this is not a finding.\n\nIf the value is 0, this is a finding.","ccis":["CCI-001170"],"group_id":"V-278656","check_content_ref":{"name":"oval:mil.disa.stig.windowsdefav:def:278656","href":"U_MS_Defender_Antivirus_V2R8_STIG_SCAP_1-4_Benchmark-enhancedV14-oval.xml"},"fin